.idea/httpRequests/
.idea_modules/
*.iml
*.iws
out/
# Editor config is machine-local, never shared (matches the .zed treatment);
# /.vscode also catches the root sandbox sentinel file.
/.vscode
.vscode/
.zed/settings.json
.history/
captures/

# Astro and project data generated at runtime
.astro/
/data/
/package/webapp-forge/*/data/
/package-paused/webapp-forge/*/data/

# Package-specific generated files unsafe to generalize
/package/desktop-daemon/hall-monitor/**/hall-monitor
/package/kwin/key-helper/key-helper-service
/package/music-player/android-app/build/
**/app/build/
**/linter/kotlin/build/
/package/music-player/android-app/**/.idea/

# Fuzzing scratch corpora; committed seeds live in tracked seeds/<target>/ siblings
# passed to libFuzzer as a second corpus dir.
/package/forbidden-strings/cli.fuzz/corpus/
/package/forbidden-strings/core.fuzz/corpus/

# cargo-mutants report output (written into the crate dir by the containerized run)
mutants.out/
mutants.out.old/

# The KWin script's main.js and metadata.json are genuine tracked source, not
# stray build artifacts hidden by the blanket `*.js` and `metadata.json` ignores.
!/packages/kwin/key-helper/kwin-script/contents/code/main.js
!/packages/kwin/key-helper/kwin-script/metadata.json

# The music player design pages load these Design Component runtime files; they are tracked source, not build
# output, so a clean clone renders every .dc.html page.
!/package/music-player/design/support.js
!/package/music-player/design/candidates/support.js
!/package/music-player/design/candidates/artists.js
!/package/music-player/design/candidates/buckets.js
