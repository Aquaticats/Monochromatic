@@ -0,0 +1,181 @@
+/**
+ * Array-shaped views of elements that live in another structure.
+ *
+ * Two values the parser hands around grow or shrink by one slot per accepted
+ * token: the state array of `multiple()` and the context's input buffer.
+ * Both are typed `readonly T[]` and are read by indexing, spreading and
+ * `Array.prototype` methods, so a persistent structure cannot replace them
+ * without a type or reader change.  This module keeps the array type and the
+ * readers: the value is a proxy over a real array, every index read is served
+ * from the structure that holds the elements, and no version copies a slot it
+ * did not change.
+ *
+ * The proxy answers `Array.isArray()`, indexing, `length`, iteration, the
+ * `Array.prototype` methods, property enumeration and `node:assert` deep
+ * equality as an array of the same elements; *array-view.test.ts* checks each
+ * of those on Node, Deno and Bun.
+ *
+ * One handler serves every view and finds its elements by the proxy target, so
+ * building a view allocates one empty array and one proxy and no closures: a
+ * view is made once per accepted token, and a per-view handler would cost more
+ * than the copies it removes on ordinary command lines.
+ *
+ * @internal
+ * @since 1.4.0
+ * @module
+ */
+
+/**
+ * Supplies the elements of an array-shaped value.
+ *
+ * @template T The type of the elements.
+ * @internal
+ * @since 1.4.0
+ */
+export interface ArrayElements<T> {
+  /** The number of elements the value presents. */
+  readonly length: number;
+
+  /**
+   * Reads the element at an index.
+   *
+   * @param index The index to read, counted from the start.
+   * @returns The element at the index, or `undefined` when out of range.
+   */
+  get(index: number): T | undefined;
+}
+
+/** Elements behind each proxy target {@link virtualArrayOf} created. */
+const elementsByTarget = new WeakMap<object, ArrayElements<unknown>>();
+
+/**
+ * Reads the elements behind a proxy target.
+ *
+ * @param target The target array of a view.
+ * @returns The elements the view presents.
+ */
+function elementsOf(target: object): ArrayElements<unknown> {
+  const elements = elementsByTarget.get(target);
+  if (elements === undefined) {
+    throw new TypeError("An array view has no elements behind it.");
+  }
+  return elements;
+}
+
+/**
+ * Returns the index a property key names, when it names a present one.
+ *
+ * `Number()` also accepts `"1.0"`, `" 1"` and `"0x1"`, so the conversion is
+ * only accepted when it round-trips to the text an array index would have.
+ *
+ * @param property The property key being read.
+ * @param length The number of elements the value presents.
+ * @returns The index the key names, or `undefined` when it names another key.
+ */
+function indexOfProperty(
+  property: PropertyKey,
+  length: number,
+): number | undefined {
+  if (typeof property !== "string") return undefined;
+  const index = Number(property);
+  if (!Number.isInteger(index) || index < 0 || index >= length) {
+    return undefined;
+  }
+  return String(index) === property ? index : undefined;
+}
+
+/**
+ * Refuses a write to an element of a view.
+ *
+ * @throws {TypeError} Always, because the elements belong to a parser state or
+ *         an input buffer that later versions share.
+ */
+function refuseWrite(): never {
+  throw new TypeError(
+    "An array view of parser state or input cannot be modified.",
+  );
+}
+
+// One handler serves every view: each trap reads the view's elements from its
+// target array, so no element type is known here.  `never[]` is the empty
+// element type, and a proxy handler is bivariant in its target type, so the
+// result of `new Proxy()` keeps the caller's element type.
+const handler: ProxyHandler<never[]> = {
+  get(target, property, receiver) {
+    const elements = elementsOf(target);
+    if (property === "length") return elements.length;
+    const index = indexOfProperty(property, elements.length);
+    if (index !== undefined) return elements.get(index);
+    return Reflect.get(target, property, receiver);
+  },
+  has(target, property) {
+    const elements = elementsOf(target);
+    if (property === "length") return true;
+    if (indexOfProperty(property, elements.length) !== undefined) return true;
+    return Reflect.has(target, property);
+  },
+  ownKeys(target) {
+    const elements = elementsOf(target);
+    const keys: (string | symbol)[] = [];
+    for (let index = 0; index < elements.length; index += 1) {
+      keys.push(String(index));
+    }
+    return [...keys, ...Reflect.ownKeys(target)];
+  },
+  getOwnPropertyDescriptor(target, property) {
+    // `length` is a non-configurable own property of the target array and the
+    // proxy may not hide it, so it is reported from the target.  Index
+    // descriptors come from the elements, which is what makes deep equality
+    // and property enumeration see the presented elements.
+    if (property === "length") {
+      return Reflect.getOwnPropertyDescriptor(target, property);
+    }
+    const elements = elementsOf(target);
+    const index = indexOfProperty(property, elements.length);
+    if (index !== undefined) {
+      return {
+        value: elements.get(index),
+        writable: true,
+        enumerable: true,
+        configurable: true,
+      };
+    }
+    return Reflect.getOwnPropertyDescriptor(target, property);
+  },
+  set(target, property, value) {
+    if (
+      property === "length" ||
+      indexOfProperty(property, elementsOf(target).length) !== undefined
+    ) {
+      refuseWrite();
+    }
+    return Reflect.set(target, property, value);
+  },
+  deleteProperty(target, property) {
+    if (indexOfProperty(property, elementsOf(target).length) !== undefined) {
+      refuseWrite();
+    }
+    return Reflect.deleteProperty(target, property);
+  },
+};
+
+/**
+ * Builds an array that presents elements stored elsewhere.
+ *
+ * The returned value is a proxy over an empty array, so `Array.isArray()`
+ * stays true and `Array.prototype` methods work; writes to its indices and to
+ * `length` throw, because its elements belong to a parser state or an input
+ * buffer that later versions share.
+ *
+ * @template T The type of the elements.
+ * @param elements The reader that serves the elements.
+ * @returns An array-shaped view of the elements.
+ * @throws {TypeError} When an element or `length` is written.
+ * @internal
+ * @since 1.4.0
+ */
+export function virtualArrayOf<T>(elements: ArrayElements<T>): readonly T[] {
+  const target: T[] = [];
+  elementsByTarget.set(target, elements);
+  return new Proxy(target, handler);
+}
