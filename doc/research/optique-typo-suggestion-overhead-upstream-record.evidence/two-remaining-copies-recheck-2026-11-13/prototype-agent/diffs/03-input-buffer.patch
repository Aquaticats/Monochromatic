@@ -0,0 +1,121 @@
+/**
+ * Unit tests for views of the input buffer that share the tokens they were
+ * cut from.
+ */
+import { describe, test } from "node:test";
+import * as assert from "node:assert/strict";
+import {
+  dropPrefixFrom,
+  leadingOf,
+  VIEW_THRESHOLD,
+} from "./input-buffer-view.ts";
+
+const TOKENS = ["p0", "p1", "p2", "p3"] as const;
+
+function longBuffer(length: number): readonly string[] {
+  return Array.from({ length }, (_, index) => `p${index}`);
+}
+
+describe("dropPrefixFrom", () => {
+  test("presents the tokens after a prefix", () => {
+    const base = [...TOKENS];
+
+    assert.deepEqual(dropPrefixFrom(base, 1), ["p1", "p2", "p3"]);
+    assert.deepEqual(dropPrefixFrom(base, 3), ["p3"]);
+    assert.deepEqual(dropPrefixFrom(base, 4), []);
+    assert.deepEqual(base, [...TOKENS]);
+  });
+
+  test("an empty tail is an empty array", () => {
+    const base = ["p0"];
+    const tail = dropPrefixFrom(base, 1);
+
+    assert.ok(Array.isArray(tail));
+    assert.equal(tail.length, 0);
+    assert.deepEqual(tail, []);
+  });
+
+  test("dropping zero keeps the same array", () => {
+    const base = [...TOKENS];
+
+    assert.equal(dropPrefixFrom(base, 0), base);
+  });
+
+  test("two drops from one array do not see each other", () => {
+    const base = [...TOKENS];
+    const one = dropPrefixFrom(base, 1);
+    const two = dropPrefixFrom(base, 2);
+
+    assert.deepEqual(one, ["p1", "p2", "p3"]);
+    assert.deepEqual(two, ["p2", "p3"]);
+    assert.equal(one[0], "p1");
+    assert.equal(two[0], "p2");
+    assert.deepEqual(base, [...TOKENS]);
+  });
+
+  test("dropping the prefix of a view continues from the same array", () => {
+    const base = longBuffer(VIEW_THRESHOLD + 10);
+    const once = dropPrefixFrom(base, 1);
+    const twice = dropPrefixFrom(once, 2);
+
+    assert.deepEqual(once, base.slice(1));
+    assert.deepEqual(twice, base.slice(3));
+    assert.deepEqual(dropPrefixFrom(twice, VIEW_THRESHOLD + 7), []);
+    assert.deepEqual(base, longBuffer(VIEW_THRESHOLD + 10));
+  });
+
+  test("a long buffer is cut without copying it", () => {
+    const base = longBuffer(VIEW_THRESHOLD + 1);
+    const tail = dropPrefixFrom(base, 1);
+
+    assert.ok(Array.isArray(tail));
+    assert.equal(tail.length, VIEW_THRESHOLD);
+    assert.equal(tail[0], "p1");
+    assert.equal(tail[VIEW_THRESHOLD - 1], `p${VIEW_THRESHOLD}`);
+    assert.deepEqual(tail, base.slice(1));
+    // A second cut of a view keeps reading the same tokens as the array.
+    assert.deepEqual(dropPrefixFrom(tail, VIEW_THRESHOLD - 1), [base.at(-1)]);
+  });
+
+  test("a short buffer is copied and shares nothing", () => {
+    const base = [...TOKENS];
+    const tail = dropPrefixFrom(base, 1);
+
+    // Below the threshold the code keeps today's plain arrays, so the result is
+    // an ordinary array that owns its slots.
+    assert.notEqual(tail, base);
+    assert.deepEqual(tail, ["p1", "p2", "p3"]);
+  });
+});
+
+describe("leadingOf", () => {
+  test("copies the first tokens of a plain array", () => {
+    const base = [...TOKENS];
+
+    assert.deepEqual(leadingOf(base, 1), ["p0"]);
+    assert.deepEqual(leadingOf(base, 3), ["p0", "p1", "p2"]);
+    assert.deepEqual(leadingOf(base, 9), [...TOKENS]);
+    assert.deepEqual(leadingOf(base, 0), []);
+    assert.deepEqual(base, [...TOKENS]);
+  });
+
+  test("copies the first tokens of a view without reading the view", () => {
+    const base = longBuffer(VIEW_THRESHOLD + 5);
+    const view = dropPrefixFrom(base, 4);
+
+    assert.deepEqual(leadingOf(view, 2), ["p4", "p5"]);
+    assert.deepEqual(leadingOf(view, 1), ["p4"]);
+    assert.deepEqual(leadingOf(view, VIEW_THRESHOLD + 5), base.slice(4));
+    assert.deepEqual(leadingOf(view, 0), []);
+  });
+
+  test("a copied prefix is a plain array the caller owns", () => {
+    const base = longBuffer(VIEW_THRESHOLD + 5);
+    const view = dropPrefixFrom(base, 1);
+    const prefix = leadingOf(view, 2) as string[];
+
+    prefix[0] = "changed";
+    assert.equal(prefix[0], "changed");
+    assert.equal(view[0], "p1");
+  });
+});
