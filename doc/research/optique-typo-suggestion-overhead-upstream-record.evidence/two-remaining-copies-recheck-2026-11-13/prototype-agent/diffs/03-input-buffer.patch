index 00000000..8822527e
--- /dev/null
+++ b/packages/core/src/internal/input-buffer-view.ts
@@ -0,0 +1,111 @@
+/**
+ * Views of the parser's input buffer that share the tokens it was cut from.
+ *
+ * `argument()` drops the tokens it consumed from the context's buffer, and the
+ * buffer is typed `readonly string[]` and read by indexing and by
+ * `Array.prototype` methods, including by parsers library users write.  A
+ * plain array cannot drop its first token without copying the rest, so
+ * consuming N positional arguments copies 1 + 2 + ... + N tokens.  This module
+ * keeps the type and the readers: the buffer becomes a view that remembers the
+ * array it was cut from and how far, and cutting a view again moves the offset
+ * instead of walking offsets or copying tokens.
+ *
+ * @internal
+ * @since 1.4.0
+ * @module
+ */
+
+import { virtualArrayOf } from "./array-view.ts";
+
+/**
+ * Tokens a buffer must have left before cutting a view instead of copying.
+ *
+ * A cut costs about three microseconds whether the buffer is long or short: one
+ * proxy allocation, the index reads a probe of every option parser makes, and
+ * the caller's prefix copy.  Copying the rest of the buffer instead costs about
+ * a third of a nanosecond per token left, so the copy is the faster way until
+ * the buffer holds some sixteen thousand tokens.  Below this number the code
+ * keeps plain arrays and the time it spent before; above it, the cost of a cut
+ * stops growing with the buffer.  Measured with the threshold lower, at 4,096,
+ * a parse of 8,000 tokens was 22% slower with views; at 8,192 one of 16,000 was
+ * 28% slower; at 32,000, where views cover the whole parse, both settings were
+ * faster than the copy, 2.7 and 1.8 times (*crossover-sweep.ts*,
+ * *matrix-summary.jsonl*, *final-thresholds.ts*).  The threshold therefore sits
+ * where the win is proven and the loss is not reachable.
+ *
+ * Exported so tests can size their buffers around it; nothing outside this
+ * module reads it.
+ */
+export const VIEW_THRESHOLD = 16384;
+
+/** The array a buffer view was cut from, and how far it was cut. */
+interface PrefixBase<T> {
+  readonly base: readonly T[];
+  readonly offset: number;
+}
+
+/** Base array and offset behind each array {@link dropPrefixFrom} returned. */
+const prefixBases = new WeakMap<object, PrefixBase<unknown>>();
+
+/**
+ * Returns an array without its first `count` elements, sharing the array they
+ * were cut from.
+ *
+ * The receiver is never modified, so a view obtained earlier keeps the tokens
+ * it had, and a parser context discarded by backtracking cannot show a cursor
+ * another context moved.
+ *
+ * @template T The type of the elements.
+ * @param array The array to cut, plain or virtual.
+ * @param count The number of leading elements to drop.
+ * @returns An array holding the elements from `count` on.
+ * @internal
+ * @since 1.4.0
+ */
+export function dropPrefixFrom<T>(
+  array: readonly T[],
+  count: number,
+): readonly T[] {
+  if (count <= 0) return array;
+  const known = prefixBases.get(array) as PrefixBase<T> | undefined;
+  const base = known?.base ?? array;
+  const offset = (known?.offset ?? 0) + count;
+  if (base.length - offset < VIEW_THRESHOLD) return base.slice(offset);
+  const view = virtualArrayOf<T>({
+    length: base.length - offset,
+    get: (index) => base[offset + index],
+  });
+  prefixBases.set(view, { base, offset });
+  return view;
+}
+
+/**
+ * Copies the first `count` elements into a plain array.
+ *
+ * `Array.prototype.slice()` on a view reads every element it copies through
+ * the proxy traps, which costs about a microsecond for a copy of two tokens and
+ * about 70 ns for each token beyond; this reads the shared array directly, so
+ * taking the tokens a parse step consumed stays cheap however long the buffer
+ * is.
+ *
+ * @template T The type of the elements.
+ * @param array The array to read, plain or virtual.
+ * @param count The number of leading elements to copy.
+ * @returns A new array holding at most `count` elements.
+ * @internal
+ * @since 1.4.0
+ */
+export function leadingOf<T>(
+  array: readonly T[],
+  count: number,
+): readonly T[] {
+  const known = prefixBases.get(array) as PrefixBase<T> | undefined;
+  if (known === undefined) return array.slice(0, count);
+  const available = known.base.length - known.offset;
+  const end = count < available ? count : available;
+  const leading: T[] = [];
+  for (let index = 0; index < end; index += 1) {
+    leading.push(known.base[known.offset + index]);
+  }
+  return leading;
+}
