# Measurement image for the old git-policy commit parser against several
# @optique/core versions, plus the repository-owned parser that replaced
# Optique as a baseline. Everything the run needs is baked in, so the run
# itself needs no mounts and no network:
#   - the parser sources copied unchanged from both commits,
#   - the baked path lists,
#   - the benchmark and analysis scripts,
#   - one directory per @optique/core version, unpacked from the exact npm
#     tarballs whose digests are recorded in /bench/meta.json.
#
# Base image follows doc/decision/container-base-distro.md: newest CachyOS the
# building host's CPU runs, on the latest tag, named through a build argument.

ARG CACHYOS_IMAGE=docker.io/cachyos/cachyos-v4:latest
FROM ${CACHYOS_IMAGE}

# Node.js comes from the base image's own repositories. The published image
# predates the openssl soname this nodejs links against, so the system is
# upgraded first; --disable-sandbox keeps pacman's install hooks runnable in a
# build container, where its seccomp sandbox cannot isolate them.
RUN pacman --disable-sandbox --sync --refresh --sysupgrade --noconfirm --needed nodejs npm \
 && pacman --sync --clean --clean --noconfirm

WORKDIR /bench

COPY ctx/meta.json /bench/meta.json
COPY ctx/tarballs /bench/tarballs
COPY ctx/owned /bench/owned
COPY data /bench/data
COPY src /bench/src
COPY scripts /bench/scripts

# One arm per Optique version: the wrapper sources under src/ (import paths
# unchanged), that version's @optique/core next to them, and the reproduction
# modules in bench/ so their bare specifiers resolve to this arm's version.
ARG ARMS="1.1.1 1.3.1 1.3.2 1.3.6 1.4.0-dev.2664 1.4.0-dev.2665 1.4.0-dev.2667 1.4.0-dev.2971"

RUN set -eux; \
    for version in $ARMS; do \
      arm="/bench/arms/$version"; \
      mkdir --parents "$arm/node_modules/@optique" "$arm/src" "$arm/bench" "$arm/unpack"; \
      tar --extract --gzip --file "/bench/tarballs/optique-core-$version.tgz" --directory "$arm/unpack" --no-same-owner; \
      mv "$arm/unpack/package" "$arm/node_modules/@optique/core"; \
      rmdir "$arm/unpack"; \
      cp --recursive /bench/src/. "$arm/src/"; \
      cp /bench/scripts/issue988-parser.ts /bench/scripts/upstream-probes.ts "$arm/bench/"; \
      cp /bench/scripts/scaling-parser.ts /bench/scripts/separator-parser.ts "$arm/bench/"; \
      printf '{"private":true,"type":"module"}\n' > "$arm/package.json"; \
    done

# 0.7.0 is the first release with "did you mean" suggestions. It predates the
# API the commit parser uses, so it only carries the search-cost probe.
RUN set -eux; \
    arm="/bench/arms/0.7.0"; \
    mkdir --parents "$arm/node_modules/@optique" "$arm/bench" "$arm/unpack"; \
    tar --extract --gzip --file /bench/tarballs/optique-core-0.7.0.tgz --directory "$arm/unpack" --no-same-owner; \
    mv "$arm/unpack/package" "$arm/node_modules/@optique/core"; \
    rmdir "$arm/unpack"; \
    cp /bench/scripts/search-cost.ts "$arm/bench/"; \
    printf '{"private":true,"type":"module"}\n' > "$arm/package.json"

# The baseline arm: the repository-owned parser that replaced Optique at commit
# 4879a44e6a, with every file it imports from that same commit, plus the
# valibot version the migration commit's lockfile pins for it.
RUN set -eux; \
    arm="/bench/arms/owned-4879a44e"; \
    mkdir --parents "$arm/node_modules" "$arm/src" "$arm/unpack"; \
    cp --recursive /bench/owned/src/. "$arm/src/"; \
    tar --extract --gzip --file /bench/tarballs/valibot-1.4.2.tgz --directory "$arm/unpack" --no-same-owner; \
    mv "$arm/unpack/package" "$arm/node_modules/valibot"; \
    rmdir "$arm/unpack"; \
    printf '{"private":true,"type":"module"}\n' > "$arm/package.json"

# Fails the build if the arm directories and scripts/workloads.ts disagree, so
# a forgotten version cannot silently drop out of the report.
RUN node --input-type=module-typescript -e ' \
      import { readdirSync, readFileSync } from "node:fs"; \
      import { ARMS, IMAGE_ARMS, OWNED_PARSER_ARM, SEARCH_ARMS } from "/bench/scripts/workloads.ts"; \
      const built = readdirSync("/bench/arms").sort(); \
      const expected = [...IMAGE_ARMS].sort(); \
      if (JSON.stringify(built) !== JSON.stringify(expected)) { \
        throw new Error(`arms mismatch: built=${built} expected=${expected}`); \
      } \
      for (const version of [...ARMS, ...SEARCH_ARMS]) { \
        const installed = JSON.parse(readFileSync(`/bench/arms/${version}/node_modules/@optique/core/package.json`, "utf8")).version; \
        if (installed !== version) throw new Error(`arm ${version} holds ${installed}`); \
      } \
      if (!built.includes(OWNED_PARSER_ARM)) throw new Error("owned-parser arm missing"); \
      console.log(`arms verified: ${built.join(", ")}`); \
    '

# Profiles are written inside the container only; results leave on stdout.
RUN mkdir --parents /bench/profiles

ENTRYPOINT ["node"]
