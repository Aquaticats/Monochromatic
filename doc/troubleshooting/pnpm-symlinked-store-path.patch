+        // TS: assert.equal(realpath(link), target);
+        assert_eq!(fs::canonicalize(link).expect("resolve created link"), target);
+    }
+    fs::remove_file(&target_alias).expect("remove target alias");
+    std::os::unix::fs::symlink(&replacement, &target_alias).expect("retarget alias");
