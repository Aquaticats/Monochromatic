+// TS: function unix_links_under_symlinked_parent_remain_resolvable() { ... }
+fn unix_links_under_symlinked_parent_remain_resolvable() {
+    // What: expect extracts success or fails the test. Why: give each setup
+    // failure a useful location. TS: const root = makeTemporaryDirectory();
+    let root = tempdir().expect("create fixture");
+    // Borrow the temporary path for canonicalization; keep the fixture owner alive.
+    let root_path = fs::canonicalize(root.path()).expect("canonical fixture root");
+    let physical = root_path.join("physical/deeper");
+    let alias = root_path.join("alias");
+    let target = root_path.join("target");
+    let replacement = root_path.join("replacement");
+    let target_alias = root_path.join("target-alias");
+    // What: & lends a path to fs without transferring ownership. Why: reuse
+    // these paths in assertions. TS: mkdir(physical, { recursive: true });
+    fs::create_dir_all(&physical).expect("create physical parent");
+    fs::create_dir_all(&target).expect("create target");
+    fs::create_dir_all(&replacement).expect("create replacement");
+    // What: :: chooses the Unix filesystem function. Why: construct the input
+    // symlinks independently of the implementation under test. TS: symlink(...).
+    std::os::unix::fs::symlink(&physical, &alias).expect("link parent alias");
+    std::os::unix::fs::symlink(&target, &target_alias).expect("link target alias");
+    let direct = alias.join("direct");
+    let nested = alias.join("missing/child/link");
+    // Borrow both paths for the public writers under test.
+    symlink_dir(&target_alias, &direct).expect("write direct link");
+    force_symlink_dir(&target_alias, &nested).expect("write link with absent parents");
