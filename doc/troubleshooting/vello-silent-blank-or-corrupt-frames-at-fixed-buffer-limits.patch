+// Must match `PTCL_INITIAL_ALLOC` in `shader/shared/ptcl.wgsl`: the `u32`s each tile owns before dynamic allocation.
+const PTCL_INITIAL_ALLOC: u32 = 64;
+// Smallest dynamic part of the ptcl buffer: what the default size leaves a 4096 by 4096 target.
+const PTCL_MIN_DYNAMIC: u32 = 1 << 22;
 
 /// Counters for tracking dynamic allocation on the GPU.
 ///
@@ -173,7 +177,12 @@ impl RenderConfig {
         let n_path_tags = layout.path_tags_size();
