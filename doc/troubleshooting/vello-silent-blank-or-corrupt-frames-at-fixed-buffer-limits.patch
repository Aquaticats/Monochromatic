+        let mut buffer_sizes = BufferSizes::new(layout, &workgroup_counts);
+        // The coarse shader checks `ptcl_size` only once a tile outgrows its initial region, so the
+        // initial regions of all tiles must fit in the buffer by construction.
+        let ptcl_initial = width_in_tiles * height_in_tiles * PTCL_INITIAL_ALLOC;
+        buffer_sizes.ptcl =
+            BufferSize::new(buffer_sizes.ptcl.len().max(ptcl_initial + PTCL_MIN_DYNAMIC));
         Self {
             gpu: ConfigUniform {
                 width_in_tiles,
@@ -438,3 +447,26 @@ impl BufferSizes {
