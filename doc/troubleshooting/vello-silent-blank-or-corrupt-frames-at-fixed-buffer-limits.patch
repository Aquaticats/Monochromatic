+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn ptcl_size(width: u32, height: u32) -> u32 {
+        RenderConfig::new(&Layout::default(), width, height, &peniko::Color::BLACK)
+            .gpu
+            .ptcl_size
+    }
+
+    #[test]
+    fn ptcl_holds_the_initial_region_of_every_tile() {
+        // 4096 by 8208 pixels is 256 by 513 tiles, one tile row more than the default size covers.
+        assert!(ptcl_size(4096, 8208) >= 256 * 513 * 64 + (1 << 22));
+    }
+
+    #[test]
+    fn ptcl_keeps_the_default_size_up_to_4096_by_4096_pixels() {
+        assert_eq!(ptcl_size(64, 64), 1 << 23);
+        assert_eq!(ptcl_size(4096, 4096), 1 << 23);
+    }
+}
