diff --git a/repro-release-selector/generate.ts b/repro-release-selector/generate.ts
new file mode 100644
index 0000000..f2ef696
--- /dev/null
+++ b/repro-release-selector/generate.ts
@@ -0,0 +1,51 @@
+import { execFileSync } from 'node:child_process';
+import { readFileSync, writeFileSync } from 'node:fs';
+
+/** Extract the production selector, replacing only channel delivery and cancellation. */
+function generate({ source, output }: { source: string; output: string }): void {
+  const start = source.indexOf('\t// Prefer a release found by either lookup.');
+  const end = source.indexOf('\n// FetchLatestRelease', start);
+  if (start < 0 || end < 0) throw new Error('Production selector boundaries changed');
+  const selector = source.slice(start, end)
+    .replace('\tfirst := <-results\n', '')
+    .replace('\tsecond := <-results\n', '')
+    .replaceAll(/\t+cancel\(\).*\n/gu, '')
+    .replace('\t\t<-results // drain the channel\n', '');
+  writeFileSync(output, `// Code generated by generate.ts from fetch.go; DO NOT EDIT.
+package main
+import ("errors"; "fmt")
+type Release struct { name string }
+type fetchResult struct { release *Release; error error }
+var ErrReleaseNotFound = errors.New("release not found")
+var quota = errors.New("HTTP 403: API rate limit exceeded")
+var server = errors.New("HTTP 500: server error")
+var found = &Release{name: "v1.2.3"}
+var failures = 0
+func choose(first, second fetchResult) (*Release, error) {
+${selector}
+func check(name string, first, second fetchResult, wantRelease *Release, wantError error) {
+  release, err := choose(first, second)
+  if release != wantRelease || !errors.Is(err, wantError) {
+    fmt.Printf("FAIL %s: got %v, want %v\\n", name, err, wantError)
+    failures++
+    return
+  }
+  fmt.Printf("PASS %s\\n", name)
+}
+func main() {
+  check("quota then missing", fetchResult{error: quota}, fetchResult{error: ErrReleaseNotFound}, nil, quota)
+  check("missing then quota", fetchResult{error: ErrReleaseNotFound}, fetchResult{error: quota}, nil, quota)
+  check("server then missing", fetchResult{error: server}, fetchResult{error: ErrReleaseNotFound}, nil, server)
+  check("missing then server", fetchResult{error: ErrReleaseNotFound}, fetchResult{error: server}, nil, server)
+  check("both missing", fetchResult{error: ErrReleaseNotFound}, fetchResult{error: ErrReleaseNotFound}, nil, ErrReleaseNotFound)
+  check("found then quota", fetchResult{release: found}, fetchResult{error: quota}, found, nil)
+  check("quota then found", fetchResult{error: quota}, fetchResult{release: found}, found, nil)
+  check("different failures preserve first", fetchResult{error: quota}, fetchResult{error: server}, nil, quota)
+  if failures != 0 { panic(fmt.Sprintf("%d selector cases failed", failures)) }
+}
+`);
+}
+
+const path = 'pkg/cmd/release/shared/fetch.go';
+generate({ source: execFileSync('git', ['show', `HEAD:${path}`], { encoding: 'utf8' }), output: 'repro-release-selector/before.go' });
+generate({ source: readFileSync(path, 'utf8'), output: 'repro-release-selector/after.go' });
