+  command_line.GetProcessCommandLine()->RemoveSwitch(
+      metrics::switches::kForceEnableMetricsReporting);
+  command_line.GetProcessCommandLine()->AppendSwitch(
+      metrics::switches::kMetricsRecordingOnly);
+  const bool original_override =
+      metrics::MetricsServiceAccessor::IsForceMetricsReportingEnabledPrefLookup();
+  ChromeMetricsServiceAccessor::SetForceIsMetricsReportingEnabledPrefLookup(false);
+  EXPECT_EQ(BUILDFLAG(GOOGLE_CHROME_BRANDING),
+            ChromeMetricsServiceAccessor::IsMetricsReportingSupported());
+  ChromeMetricsServiceAccessor::SetForceIsMetricsReportingEnabledPrefLookup(
+      original_override);
+}
+
+// Tests that opt into ordinary pref lookup can enable reporting later.
+TEST_F(ChromeMetricsServiceAccessorTest, PrefLookupOverrideReportingSupport) {
+  base::test::ScopedCommandLine command_line;
+  command_line.GetProcessCommandLine()->RemoveSwitch(
+      metrics::switches::kForceEnableMetricsReporting);
+  const bool original_override =
+      metrics::MetricsServiceAccessor::IsForceMetricsReportingEnabledPrefLookup();
+  ChromeMetricsServiceAccessor::SetForceIsMetricsReportingEnabledPrefLookup(true);
+  EXPECT_TRUE(ChromeMetricsServiceAccessor::IsMetricsReportingSupported());
+  ChromeMetricsServiceAccessor::SetForceIsMetricsReportingEnabledPrefLookup(false);
+  EXPECT_EQ(BUILDFLAG(GOOGLE_CHROME_BRANDING),
+            ChromeMetricsServiceAccessor::IsMetricsReportingSupported());
+  ChromeMetricsServiceAccessor::SetForceIsMetricsReportingEnabledPrefLookup(
+      original_override);
+}
+
+// The override's presence, rather than current consent, determines support.
+TEST_F(ChromeMetricsServiceAccessorTest, ConsentOverrideReportingSupport) {
+  base::test::ScopedCommandLine command_line;
+  command_line.GetProcessCommandLine()->RemoveSwitch(
+      metrics::switches::kForceEnableMetricsReporting);
+  const bool original_override =
+      metrics::MetricsServiceAccessor::IsForceMetricsReportingEnabledPrefLookup();
+  ChromeMetricsServiceAccessor::SetForceIsMetricsReportingEnabledPrefLookup(false);
+  bool consent = false;
+  ChromeMetricsServiceAccessor::SetMetricsAndCrashReportingForTesting(&consent);
+  EXPECT_TRUE(ChromeMetricsServiceAccessor::IsMetricsReportingSupported());
+  EXPECT_FALSE(
+      ChromeMetricsServiceAccessor::IsMetricsAndCrashReportingEnabled(nullptr));
+  consent = true;
+  EXPECT_TRUE(ChromeMetricsServiceAccessor::IsMetricsReportingSupported());
+  EXPECT_TRUE(
+      ChromeMetricsServiceAccessor::IsMetricsAndCrashReportingEnabled(nullptr));
+  ChromeMetricsServiceAccessor::SetMetricsAndCrashReportingForTesting(nullptr);
+  EXPECT_EQ(BUILDFLAG(GOOGLE_CHROME_BRANDING),
+            ChromeMetricsServiceAccessor::IsMetricsReportingSupported());
+  ChromeMetricsServiceAccessor::SetForceIsMetricsReportingEnabledPrefLookup(
+      original_override);
+}
