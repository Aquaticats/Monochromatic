diff --git a/lib/chai/utils/objDisplay.js b/lib/chai/utils/objDisplay.js
index 9a2a596..fb33cd9 100644
--- a/lib/chai/utils/objDisplay.js
+++ b/lib/chai/utils/objDisplay.js
@@ -21,30 +21,41 @@ import {config} from '../config.js';
  * @public
  */
 export function objDisplay(obj) {
-  let str = inspect(obj),
-    type = Object.prototype.toString.call(obj);
+  let type = Object.prototype.toString.call(obj);
 
-  if (config.truncateThreshold && str.length >= config.truncateThreshold) {
-    if (type === '[object Function]') {
-      const objAsFunction = /** @type {Function} */ (obj);
-      return !objAsFunction.name || objAsFunction.name === ''
-        ? '[Function]'
-        : '[Function: ' + objAsFunction.name + ']';
-    } else if (type === '[object Array]') {
-      const objAsArray = /** @type {unknown[]} */ (obj);
-      return '[ Array(' + objAsArray.length + ') ]';
-    } else if (type === '[object Object]') {
-      const objAsObject = /** @type {Record<PropertyKey, unknown>} */ (obj);
-      let keys = Object.keys(objAsObject),
-        kstr =
-          keys.length > 2
-            ? keys.splice(0, 2).join(', ') + ', ...'
-            : keys.join(', ');
-      return '{ Object (' + kstr + ') }';
-    } else {
-      return str;
-    }
+  if (!config.truncateThreshold) {
+    return inspect(obj);
+  }
+
+  // The replacement decision must read the UNTRUNCATED length. `inspect`
+  // renders with `config.truncateThreshold` as its character budget, so
+  // comparing the truncated string's own length against that budget made the
+  // outcome depend on loupe's elision arithmetic: the same value rendered as
+  // `[ Array(31) ]` at threshold 34 and 40 but as a partial `…(n)` listing at
+  // 35..39 and 41+ (non-monotonic in the threshold).
+  let full = inspect(obj, undefined, undefined, undefined, Infinity);
+
+  if (full.length < config.truncateThreshold) {
+    return full;
+  }
+
+  if (type === '[object Function]') {
+    const objAsFunction = /** @type {Function} */ (obj);
+    return !objAsFunction.name || objAsFunction.name === ''
+      ? '[Function]'
+      : '[Function: ' + objAsFunction.name + ']';
+  } else if (type === '[object Array]') {
+    const objAsArray = /** @type {unknown[]} */ (obj);
+    return '[ Array(' + objAsArray.length + ') ]';
+  } else if (type === '[object Object]') {
+    const objAsObject = /** @type {Record<PropertyKey, unknown>} */ (obj);
+    let keys = Object.keys(objAsObject),
+      kstr =
+        keys.length > 2
+          ? keys.splice(0, 2).join(', ') + ', ...'
+          : keys.join(', ');
+    return '{ Object (' + kstr + ') }';
   } else {
-    return str;
+    return inspect(obj);
   }
 }
