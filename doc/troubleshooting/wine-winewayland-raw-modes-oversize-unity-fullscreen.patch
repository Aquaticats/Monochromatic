diff --git a/dlls/winewayland.drv/waylanddrv.h b/dlls/winewayland.drv/waylanddrv.h
index 9452d23..43808c9 100644
--- a/dlls/winewayland.drv/waylanddrv.h
+++ b/dlls/winewayland.drv/waylanddrv.h
@@ -205,8 +205,29 @@ struct wayland_output_state
     char *name;
     int logical_x, logical_y;
     int logical_w, logical_h;
+    int transform;
 };
 
+/* Apply the wl_output transform to a mode size, swapping the dimensions for
+ * the 90 and 270 degree variants. */
+static inline void wayland_output_transform_size(int transform, int32_t width, int32_t height,
+                                                 int32_t *transformed_width,
+                                                 int32_t *transformed_height)
+{
+    if (transform == WL_OUTPUT_TRANSFORM_90 || transform == WL_OUTPUT_TRANSFORM_270 ||
+        transform == WL_OUTPUT_TRANSFORM_FLIPPED_90 ||
+        transform == WL_OUTPUT_TRANSFORM_FLIPPED_270)
+    {
+        *transformed_width = height;
+        *transformed_height = width;
+    }
+    else
+    {
+        *transformed_width = width;
+        *transformed_height = height;
+    }
+}
