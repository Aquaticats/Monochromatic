+/// Replaces a CPU adapter, which wgpu lists first when no power preference sorts the list, by the first hardware
+/// adapter that can present to `surface`. A CPU adapter stays when `SLINT_WGPU_CPU` or `WGPU_ADAPTER_NAME` is set.
+async fn without_cpu_adapter(
+    instance: &wgpu::Instance,
+    surface: &wgpu::Surface<'_>,
+    adapter: wgpu::Adapter,
+) -> Result<wgpu::Adapter, Box<dyn std::error::Error + Send + Sync + 'static>> {
+    let allowed = std::env::var_os("SLINT_WGPU_CPU").is_some()
+        || std::env::var_os("WGPU_ADAPTER_NAME").is_some();
+    if allowed || adapter.get_info().device_type != wgpu::DeviceType::Cpu {
+        return Ok(adapter);
+    }
+    for candidate in instance.enumerate_adapters(wgpu::Backends::all()).await {
+        if candidate.get_info().device_type != wgpu::DeviceType::Cpu
+            && candidate.is_surface_supported(surface)
+        {
+            return Ok(candidate);
+        }
+    }
+    Err(alloc::format!(
+        "The WGPU adapter {} renders on the CPU. Set SLINT_WGPU_CPU=1 to use it anyway.",
+        adapter.get_info().name
+    )
+    .into())
+}
