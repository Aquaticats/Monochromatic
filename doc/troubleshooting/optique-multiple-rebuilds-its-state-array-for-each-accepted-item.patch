index 00000000..b1c7f3ea
--- /dev/null
+++ b/packages/core/src/internal/persistent-vector.test.ts
@@ -0,0 +1,351 @@
+/**
+ * Unit tests for the immutable vector `multiple()` stores its state in.
+ */
+import { describe, test } from "node:test";
+import * as assert from "node:assert/strict";
+import * as fc from "fast-check";
+import {
+  appendTo,
+  dropLastFrom,
+  emptyPersistentVector,
+  type PersistentVector,
+  persistentVectorOf,
+  VIEW_THRESHOLD,
+} from "./persistent-vector.ts";
+
+// =============================================================================
+// Helpers
+// =============================================================================
+
+function assertMatches(
+  vector: PersistentVector<number>,
+  expected: readonly number[],
+): void {
+  assert.equal(vector.size, expected.length, "size");
+  for (let index = 0; index < expected.length; index += 1) {
+    assert.equal(vector.get(index), expected[index], `index ${index}`);
+  }
+  assert.equal(vector.get(-1), undefined, "index -1");
+  assert.equal(vector.get(expected.length), undefined, "index past the end");
+  assert.equal(vector.get(0.5), undefined, "a fractional index");
+  assert.deepEqual([...vector], expected, "iteration");
+  assert.deepEqual(vector.toArray(), expected, "toArray()");
+}
+
+/**
+ * The number of slots a node holds, so the sizes below cross every fan-out
+ * boundary: the tree grows a level at each of them.
+ */
+const FAN_OUT = 32;
+
+const SIZES = [
+  0,
+  1,
+  FAN_OUT - 1,
+  FAN_OUT,
+  FAN_OUT + 1,
+  FAN_OUT * FAN_OUT - 1,
+  FAN_OUT * FAN_OUT,
+  FAN_OUT * FAN_OUT + 1,
+  FAN_OUT ** 3 + FAN_OUT + 1,
+];
+
+function itemsOf(length: number): readonly number[] {
+  return Array.from({ length }, (_, index) => index);
+}
+
+// =============================================================================
+// Building
+// =============================================================================
+
+describe("PersistentVector", () => {
+  test("an empty vector holds nothing", () => {
+    assertMatches(emptyPersistentVector<number>(), []);
+    assert.deepEqual(emptyPersistentVector<number>().toArray(), []);
+  });
+
+  test("a vector built from an array holds its items in order", () => {
+    for (const size of SIZES) {
+      const items = itemsOf(size);
+      assertMatches(persistentVectorOf(items), items);
+    }
+  });
+
+  test("appending one item at a time keeps every earlier version", () => {
+    const size = FAN_OUT * FAN_OUT + 1;
+    const versions: PersistentVector<number>[] = [];
+    let vector = emptyPersistentVector<number>();
+    for (let index = 0; index < size; index += 1) {
+      versions.push(vector);
+      vector = vector.append(index);
+    }
+    versions.push(vector);
+    // Every version is read at its start, its end and its middle: an append
+    // that shares a node with an earlier version shows up as a wrong length
+    // or a wrong item in that version.
+    for (let index = 0; index < versions.length; index += 1) {
+      const version = versions[index]!;
+      assert.equal(version.size, index, `version ${index} size`);
+      if (index === 0) continue;
+      assert.equal(version.get(0), 0, `version ${index} first item`);
+      assert.equal(version.get(index - 1), index - 1, `version ${index} end`);
+      const middle = (index - 1) >> 1;
+      assert.equal(version.get(middle), middle, `version ${index} middle`);
+      assert.equal(version.get(index), undefined, `version ${index} past end`);
+    }
+  });
+
+  // ===========================================================================
+  // Dropping
+  // ===========================================================================
+
+  test("dropping the last item keeps the earlier and the later version", () => {
+    for (const size of SIZES) {
+      const items = itemsOf(size);
+      const vector = persistentVectorOf(items);
+      const shorter = vector.dropLast();
+      assertMatches(vector, items);
+      assertMatches(shorter, items.slice(0, -1));
+      assertMatches(shorter.dropLast(), items.slice(0, -2));
+      assertMatches(shorter.append(-1), [...items.slice(0, -1), -1]);
+    }
+  });
+
+  test("two extensions of one version do not see each other", () => {
+    const items = itemsOf(FAN_OUT * 2);
+    const base = persistentVectorOf(items);
+    const extended = base.append(-1);
+    const other = base.append(-2);
+    assertMatches(base, items);
+    assertMatches(extended, [...items, -1]);
+    assertMatches(other, [...items, -2]);
+    // A second extension of an extended version leaves the first one alone.
+    const again = extended.append(-3);
+    assertMatches(extended, [...items, -1]);
+    assertMatches(again, [...items, -1, -3]);
+  });
+
+  test("a version extended after a drop still holds the dropped item", () => {
+    const items = [1, 2, 3];
+    const base = persistentVectorOf(items);
+    const dropped = base.dropLast();
+    const extended = dropped.append(99);
+    assertMatches(base, items);
+    assertMatches(dropped, [1, 2]);
+    assertMatches(extended, [1, 2, 99]);
+  });
+
+  // ===========================================================================
+  // Random operations
+  // ===========================================================================
+
+  test("matches a plain array over random append and drop sequences", () => {
+    // Every intermediate version is checked against the plain array it should
+    // equal, so a structure that shares a node it later edits is caught at the
+    // step that edits it.
+    fc.assert(
+      fc.property(
+        fc.array(
+          fc.oneof(
+            fc.integer({ min: -1000, max: 1000 }).map((value) => ({
+              kind: "append" as const,
+              value,
+            })),
+            fc.constant({ kind: "dropLast" as const, value: 0 }),
+            fc.integer({ min: 0, max: 4 }).map((count) => ({
+              kind: "extendEarlier" as const,
+              value: count,
+            })),
+          ),
+          { maxLength: 64 },
+        ),
+        (operations) => {
+          const versions: PersistentVector<number>[] = [
+            emptyPersistentVector<number>(),
+          ];
+          const expected: number[][] = [[]];
+          for (const operation of operations) {
+            const latest = versions[versions.length - 1]!;
+            const latestExpected = expected[expected.length - 1]!;
+            if (operation.kind === "append") {
+              versions.push(latest.append(operation.value));
+              expected.push([...latestExpected, operation.value]);
+            } else if (operation.kind === "dropLast") {
+              versions.push(latest.dropLast());
+              expected.push(latestExpected.slice(0, -1));
+            } else {
+              // Extend an older version, so the versions form a tree and not
+              // only a chain.
+              const index = operation.value % versions.length;
+              versions.push(versions[index]!.append(operation.value));
+              expected.push([...expected[index]!, operation.value]);
+            }
+            const newest = versions[versions.length - 1]!;
+            const newestExpected = expected[expected.length - 1]!;
+            assert.deepEqual([...newest], newestExpected, "iteration");
+            assert.equal(newest.size, newestExpected.length, "size");
+          }
+        },
+      ),
+      { numRuns: 200 },
+    );
+  });
+});
+
+// =============================================================================
+// Array operations that share a vector
+// =============================================================================
+
+describe("appendTo", () => {
+  test("appends to a plain array", () => {
+    const base = ["a", "b"];
+
+    assert.deepEqual(appendTo(base, "c"), ["a", "b", "c"]);
+    assert.deepEqual(base, ["a", "b"]);
+  });
+
+  test("keeps every earlier version", () => {
+    const items = ["a", "b", "c", "d"];
+    let array: readonly string[] = [];
+    const versions: (readonly string[])[] = [];
+    for (const item of items) {
+      versions.push(array);
+      array = appendTo(array, item);
+    }
+    versions.push(array);
+
+    assert.deepEqual(versions, [[], ["a"], ["a", "b"], ["a", "b", "c"], items]);
+    for (const [index, version] of versions.entries()) {
+      assert.deepEqual(version, items.slice(0, index));
+    }
+  });
+
+  test("two extensions of one array do not see each other", () => {
+    const base = appendTo([], "a");
+    const first = appendTo(base, "b");
+    const second = appendTo(base, "c");
+
+    assert.deepEqual(base, ["a"]);
+    assert.deepEqual(first, ["a", "b"]);
+    assert.deepEqual(second, ["a", "c"]);
+  });
+
+  test("appends past one fan-out", () => {
+    const size = FAN_OUT * 2;
+    let array: readonly number[] = [];
+    for (let index = 0; index < size; index += 1) {
+      array = appendTo(array, index);
+    }
+
+    assert.equal(array.length, size);
+    assert.deepEqual(array, itemsOf(size));
+  });
+
+  test("a short array is copied and shares nothing", () => {
+    const base = appendTo(["a"], "b");
+    const extended = appendTo(base, "c");
+
+    // Below the threshold the code keeps today's plain arrays, so each result
+    // is an ordinary array that owns its slots.
+    assert.notEqual(extended, base);
+    assert.deepEqual(base, ["a", "b"]);
+    assert.deepEqual(extended, ["a", "b", "c"]);
+  });
+
+  test("a long array converts once and keeps every earlier version", () => {
+    // The conversion at the threshold is where a plain array could leak its
+    // slots into the vector, so the versions around it are read back.
+    const size = VIEW_THRESHOLD + 3;
+    const versions: (readonly number[])[] = [];
+    let array: readonly number[] = [];
+    for (let index = 0; index < size; index += 1) {
+      versions.push(array);
+      array = appendTo(array, index);
+    }
+    versions.push(array);
+
+    for (
+      const index of [
+        0,
+        1,
+        VIEW_THRESHOLD - 1,
+        VIEW_THRESHOLD,
+        VIEW_THRESHOLD + 1,
+        size,
+      ]
+    ) {
+      const version = versions[index];
+      if (version === undefined) throw new Error(`no version ${index}`);
+      assert.equal(version.length, index, `version ${index} length`);
+      assert.deepEqual([...version], itemsOf(index), `version ${index} items`);
+    }
+    // The version that triggered the conversion still shows its own items.
+    const converted = versions[VIEW_THRESHOLD];
+    if (converted === undefined) throw new Error("no converted version");
+    assert.equal(converted.at(-1), VIEW_THRESHOLD - 1);
+    assert.equal(converted[0], 0);
+  });
+
+  test("two extensions of one long array do not see each other", () => {
+    let base: readonly number[] = [];
+    for (let index = 0; index < VIEW_THRESHOLD; index += 1) {
+      base = appendTo(base, index);
+    }
+    const first = appendTo(base, -1);
+    const second = appendTo(base, -2);
+
+    assert.equal(base.length, VIEW_THRESHOLD);
+    assert.deepEqual(first.slice(-2), [VIEW_THRESHOLD - 1, -1]);
+    assert.deepEqual(second.slice(-2), [VIEW_THRESHOLD - 1, -2]);
+  });
+});
+
+describe("dropLastFrom", () => {
+  test("drops the last element of a plain array", () => {
+    const base = ["a", "b"];
+
+    assert.deepEqual(dropLastFrom(base), ["a"]);
+    assert.deepEqual(dropLastFrom([]), []);
+    assert.deepEqual(base, ["a", "b"]);
+  });
+
+  test("leaves the earlier version alone", () => {
+    const base = appendTo(appendTo([], "a"), "b");
+    const shorter = dropLastFrom(base);
+
+    assert.deepEqual(base, ["a", "b"]);
+    assert.deepEqual(shorter, ["a"]);
+    assert.deepEqual(appendTo(shorter, "z"), ["a", "z"]);
+    assert.deepEqual(base, ["a", "b"]);
+  });
+
+  test("drops the last element of a view", () => {
+    let array: readonly number[] = [];
+    for (let index = 0; index < VIEW_THRESHOLD + 2; index += 1) {
+      array = appendTo(array, index);
+    }
+    const shorter = dropLastFrom(array);
+
+    assert.equal(shorter.length, VIEW_THRESHOLD + 1);
+    assert.equal(shorter.at(-1), VIEW_THRESHOLD);
+    assert.equal(array.length, VIEW_THRESHOLD + 2);
+    assert.equal(array.at(-1), VIEW_THRESHOLD + 1);
+    // Appending after a drop replaces the last item of the shorter version and
+    // leaves the longer one alone.
+    const replaced = appendTo(shorter, -1);
+    assert.equal(replaced.at(-1), -1);
+    assert.equal(array.at(-1), VIEW_THRESHOLD + 1);
+  });
+
+  test("drops the last element past one fan-out", () => {
+    const size = FAN_OUT * 2;
+    let array: readonly number[] = [];
+    for (let index = 0; index < size; index += 1) {
+      array = appendTo(array, index);
+    }
+
+    assert.deepEqual(dropLastFrom(array), itemsOf(size - 1));
+    assert.equal(array.length, size);
+    assert.deepEqual(array, itemsOf(size));
+  });
+});
