diff --git a/packages/core/src/internal/array-view.test.ts b/packages/core/src/internal/array-view.test.ts
new file mode 100644
index 00000000..eaceb7c9
--- /dev/null
+++ b/packages/core/src/internal/array-view.test.ts
@@ -0,0 +1,179 @@
+/**
+ * Unit tests for array-shaped views of elements that live in another
+ * structure.
+ */
+import { describe, test } from "node:test";
+import * as assert from "node:assert/strict";
+import { virtualArrayOf } from "./array-view.ts";
+
+const ITEMS = ["a", "b", "c", "d"] as const;
+
+function elementsOf(items: readonly string[]) {
+  return {
+    length: items.length,
+    get: (index: number) => items[index],
+  };
+}
+
+describe("virtualArrayOf", () => {
+  test("presents the elements of its source as an array", () => {
+    const view = virtualArrayOf(elementsOf(ITEMS));
+
+    assert.ok(Array.isArray(view));
+    assert.equal(view.length, ITEMS.length);
+    assert.equal(view[0], "a");
+    assert.equal(view[3], "d");
+    assert.equal(view[4], undefined);
+    assert.deepEqual(view.slice(1), ["b", "c", "d"]);
+    assert.deepEqual([...view], [...ITEMS]);
+    assert.deepEqual(view.map((item) => item.toUpperCase()), [
+      "A",
+      "B",
+      "C",
+      "D",
+    ]);
+    assert.ok(view.every((item) => typeof item === "string"));
+    assert.equal(view.join(","), ITEMS.join(","));
+    assert.equal(view.indexOf("c"), 2);
+    assert.equal(view.at(-1), "d");
+    assert.deepEqual(Object.keys(view), ["0", "1", "2", "3"]);
+    assert.equal(JSON.stringify(view), JSON.stringify(ITEMS));
+    assert.ok(1 in view);
+    assert.ok(Object.hasOwn(view, "2"));
+    assert.deepEqual(view, ITEMS);
+    assert.deepEqual(view, ["a", "b", "c", "d"]);
+  });
+
+  test("reports a shorter length than its source could serve", () => {
+    // The source serves a whole shared array and presents a window of it, so
+    // an element outside the window must not leak through.
+    const shared = ["a", "b", "c", "d"];
+    const view = virtualArrayOf({
+      length: 2,
+      get: (index) => shared[index],
+    });
+
+    assert.equal(view.length, 2);
+    assert.deepEqual([...view], ["a", "b"]);
+    assert.equal(view[2], undefined);
+    assert.deepEqual(Object.keys(view), ["0", "1"]);
+    assert.deepEqual(view.slice(0), ["a", "b"]);
+    assert.deepEqual(view, ["a", "b"]);
+  });
+
+  test("an empty view is an empty array", () => {
+    const view = virtualArrayOf(elementsOf([]));
+
+    assert.ok(Array.isArray(view));
+    assert.equal(view.length, 0);
+    assert.deepEqual([...view], []);
+    assert.deepEqual(view, []);
+    assert.equal(JSON.stringify(view), "[]");
+    assert.equal(view.at(-1), undefined);
+  });
+
+  test("carries symbol properties the way an array does", () => {
+    // annotateFreshArray() attaches annotations to array states as a symbol
+    // property, and the parser reads them back through the same view.
+    const annotation = Symbol.for("@test/array-view-annotation");
+    const view = virtualArrayOf(elementsOf(ITEMS)) as readonly string[] & {
+      [key: symbol]: unknown;
+    };
+
+    view[annotation] = "mark";
+    assert.equal(view[annotation], "mark");
+  });
+
+  test("refuses to write an element or the length", () => {
+    const writable = virtualArrayOf(elementsOf(ITEMS)) as string[];
+
+    assert.throws(() => {
+      writable[0] = "z";
+    }, TypeError);
+    assert.throws(() => {
+      writable.length = 0;
+    }, TypeError);
+    assert.throws(() => {
+      delete writable[1];
+    }, TypeError);
+    assert.deepEqual(writable, ITEMS);
+  });
+
+  test("gives a copy made from its descriptors its length and elements", () => {
+    const view = virtualArrayOf(elementsOf(ITEMS));
+
+    assert.equal(
+      Object.getOwnPropertyDescriptor(view, "length")?.value,
+      ITEMS.length,
+    );
+    // A `length` descriptor taken from the empty target would cut this copy
+    // back to no elements.
+    const copy: string[] = [];
+    for (const key of Reflect.ownKeys(view)) {
+      const descriptor = Reflect.getOwnPropertyDescriptor(view, key);
+      if (descriptor !== undefined) {
+        Object.defineProperty(copy, key, descriptor);
+      }
+    }
+    assert.equal(copy.length, ITEMS.length);
+    assert.deepEqual(copy, ITEMS);
+  });
+
+  test("refuses writes past its end and keeps no trace of them", () => {
+    const writable = virtualArrayOf(elementsOf(ITEMS)) as string[];
+    const pastEnd = String(ITEMS.length);
+
+    assert.throws(() => writable.push("z"), TypeError);
+    assert.throws(() => writable.unshift("z"), TypeError);
+    assert.throws(() => {
+      writable[ITEMS.length] = "z";
+    }, TypeError);
+    assert.throws(() => {
+      writable[ITEMS.length + 3] = "z";
+    }, TypeError);
+    assert.throws(
+      () => Object.defineProperty(writable, "0", { value: "z" }),
+      TypeError,
+    );
+    assert.throws(
+      () => Object.defineProperty(writable, pastEnd, { value: "z" }),
+      TypeError,
+    );
+    // A write that reached the target array would show up as a key and as an
+    // element past the end.
+    assert.equal(writable[ITEMS.length], undefined);
+    assert.ok(!(ITEMS.length in writable));
+    assert.deepEqual(Object.keys(writable), ["0", "1", "2", "3"]);
+    assert.deepEqual(writable, ITEMS);
+  });
+
+  test("refuses to be frozen and stays readable afterwards", () => {
+    const view = virtualArrayOf(elementsOf(ITEMS));
+
+    assert.throws(() => Object.freeze(view), TypeError);
+    assert.throws(() => Object.seal(view), TypeError);
+    assert.throws(() => Object.preventExtensions(view), TypeError);
+    // A view whose target was made non-extensible on the way to that error
+    // can no longer list its keys.
+    assert.ok(Object.isExtensible(view));
+    assert.deepEqual(Object.keys(view), ["0", "1", "2", "3"]);
+    assert.deepEqual(view, ITEMS);
+  });
+
+  test("two views of one source do not see each other's window", () => {
+    const shared = ["a", "b", "c", "d"];
+    const first = virtualArrayOf({
+      length: 3,
+      get: (index) => shared[index],
+    });
+    const second = virtualArrayOf({
+      length: 1,
+      get: (index) => shared[index + 2],
+    });
+
+    assert.deepEqual(first, ["a", "b", "c"]);
+    assert.deepEqual(second, ["c"]);
+    assert.equal(first[2], "c");
+    assert.equal(second[0], "c");
+  });
+});
