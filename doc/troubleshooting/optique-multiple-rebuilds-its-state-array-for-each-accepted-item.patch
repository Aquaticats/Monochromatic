+++ b/packages/core/src/internal/persistent-vector.ts
@@ -0,0 +1,408 @@
+/**
+ * An immutable vector: an indexed sequence whose versions share storage.
+ *
+ * `multiple()` rebuilds its state array for every item it accepts, so a parse
+ * of N positional arguments copies 1 + 2 + ... + N slots when that state is a
+ * plain array.  This
+ * vector appends and drops the last slot by copying only the nodes on the
+ * path to it: both cost O(log32 N) slots, and a vector obtained earlier keeps
+ * the slots it had, because no node, child list or item list is modified
+ * after it is created.
+ *
+ * A view over a vector that is still typed `readonly T[]` is built by
+ * {@link virtualArrayOf} in *array-view.ts*.
+ *
+ * @internal
+ * @since 1.4.0
+ * @module
+ */
+
+import { virtualArrayOf } from "./array-view.ts";
+
+/**
+ * Highest number of slots a leaf holds and of children a branch holds.
+ *
+ * A fixed 32-way fan-out keeps the tree shallow (32,768 items sit at depth 3)
+ * while every copied node is one small array copy.
+ */
+const MAX_SLOTS = 32;
+
+/** A terminal node holding one to {@link MAX_SLOTS} items. */
+interface Leaf<T> {
+  readonly kind: "leaf";
+  readonly items: readonly T[];
+}
+
+/** An interior node holding one to {@link MAX_SLOTS} subtrees. */
+interface Branch<T> {
+  readonly kind: "branch";
+  readonly size: number;
+  readonly children: readonly VectorNode<T>[];
+}
+
+type VectorNode<T> = Branch<T> | Leaf<T>;
+
+/**
+ * Counts the slots a subtree holds.
+ *
+ * @param node The subtree to count.
+ * @returns The number of items the subtree holds.
+ */
+function slotCount<T>(node: VectorNode<T>): number {
+  return node.kind === "leaf" ? node.items.length : node.size;
+}
+
+/**
+ * Builds a leaf out of items that are already immutable to the caller.
+ *
+ * @param items The items the leaf holds, never modified afterwards.
+ * @returns The new leaf.
+ */
+function leafOf<T>(items: readonly T[]): Leaf<T> {
+  return { kind: "leaf", items };
+}
+
+/**
+ * Builds a branch out of children that are already immutable to the caller,
+ * summing their slot counts into the size an index walk routes by.
+ *
+ * @param children The subtrees the branch holds, never modified afterwards.
+ * @returns The new branch.
+ */
+function branchOf<T>(children: readonly VectorNode<T>[]): Branch<T> {
+  let size = 0;
+  for (const child of children) size += slotCount(child);
+  return { kind: "branch", size, children };
+}
+
+/**
+ * Reads the item at an index by walking down from a subtree.
+ *
+ * @param node The subtree to read from.
+ * @param index The index within the subtree.
+ * @returns The item at the index, or `undefined` when the subtree is shorter.
+ */
+function elementAt<T>(node: VectorNode<T>, index: number): T | undefined {
+  let current: VectorNode<T> | undefined = node;
+  let offset = index;
+  while (current !== undefined) {
+    if (current.kind === "leaf") return current.items[offset];
+    let next: VectorNode<T> | undefined;
+    for (const child of current.children) {
+      const count = slotCount(child);
+      if (offset < count) {
+        next = child;
+        break;
+      }
+      offset -= count;
+    }
+    current = next;
+  }
+  return undefined;
+}
+
+/** A subtree grown by one slot, plus a sibling to insert after it. */
+interface Appended<T> {
+  readonly node: VectorNode<T>;
+  readonly sibling?: VectorNode<T>;
+}
+
+/**
+ * Appends an item to the rightmost leaf of a subtree.
+ *
+ * @param node The subtree to grow, left unmodified.
+ * @param value The item to append.
+ * @returns The grown subtree, and a sibling when it was already full.
+ */
+function appendRight<T>(node: VectorNode<T>, value: T): Appended<T> {
+  if (node.kind === "leaf") {
+    if (node.items.length < MAX_SLOTS) {
+      return { node: leafOf([...node.items, value]) };
+    }
+    return { node, sibling: leafOf([value]) };
+  }
+  const lastIndex = node.children.length - 1;
+  const last = node.children[lastIndex];
+  if (last === undefined) throw new RangeError("A branch holds no children.");
+  const grown = appendRight(last, value);
+  const children = node.children.slice();
+  children[lastIndex] = grown.node;
+  if (grown.sibling !== undefined) children.push(grown.sibling);
+  if (children.length <= MAX_SLOTS) {
+    return { node: branchOf(children) };
+  }
+  // A full branch splits into two halves so that the parent stays shallow.
+  const half = children.length >> 1;
+  return {
+    node: branchOf(children.slice(0, half)),
+    sibling: branchOf(children.slice(half)),
+  };
+}
+
+/**
+ * Drops the rightmost item of a subtree.
+ *
+ * @param node The subtree to shrink, left unmodified.
+ * @returns The shrunk subtree, or `undefined` when it held one item.
+ */
+function dropRight<T>(node: VectorNode<T>): VectorNode<T> | undefined {
+  if (node.kind === "leaf") {
+    if (node.items.length <= 1) return undefined;
+    return leafOf(node.items.slice(0, -1));
+  }
+  const lastIndex = node.children.length - 1;
+  const last = node.children[lastIndex];
+  if (last === undefined) throw new RangeError("A branch holds no children.");
+  const shrunk = dropRight(last);
+  if (shrunk === undefined) {
+    if (node.children.length === 1) return undefined;
+    return branchOf(node.children.slice(0, -1));
+  }
+  const children = node.children.slice();
+  children[lastIndex] = shrunk;
+  if (children.length === 1) return children[0];
+  return branchOf(children);
+}
+
+/**
+ * Walks a subtree in order.
+ *
+ * @param node The subtree to walk.
+ * @yields The items of the subtree, in index order.
+ */
+function* walkNode<T>(node: VectorNode<T>): Generator<T> {
+  if (node.kind === "leaf") {
+    yield* node.items;
+    return;
+  }
+  for (const child of node.children) yield* walkNode(child);
+}
+
+/**
+ * An immutable vector of items.
+ *
+ * Every operation returns a vector and leaves its receiver as it was, so a
+ * parser context that was discarded can hand its state to no one, and a
+ * context that was kept still sees the items it had.
+ *
+ * @template T The type of the stored items.
+ * @internal
+ * @since 1.4.0
+ */
+export interface PersistentVector<T> extends Iterable<T> {
+  /** The number of items the vector holds. */
+  readonly size: number;
+
+  /**
+   * Reads the item at an index.
+   *
+   * @param index The index to read, counted from the start.
+   * @returns The item at the index, or `undefined` when the index is out of
+   *          range or not a whole number.
+   */
+  get(index: number): T | undefined;
+
+  /**
+   * Returns a vector with an item after the last one.
+   *
+   * @param value The item to append.
+   * @returns A vector one item longer.
+   */
+  append(value: T): PersistentVector<T>;
+
+  /**
+   * Returns a vector without its last item.
+   *
+   * @returns A vector one item shorter, or an empty vector when the receiver
+   *          was empty.
+   */
+  dropLast(): PersistentVector<T>;
+
+  /**
+   * Copies the items into a plain array.
+   *
+   * @returns A new array holding the items in index order.
+   */
+  toArray(): readonly T[];
+
+  /**
+   * Walks the items in index order.
+   *
+   * @returns An iterator over the items.
+   */
+  [Symbol.iterator](): Iterator<T>;
+}
+
+class PersistentVectorImpl<T> implements PersistentVector<T> {
+  readonly #root: VectorNode<T> | undefined;
+  readonly #size: number;
+
+  constructor(root: VectorNode<T> | undefined, size: number) {
+    this.#root = root;
+    this.#size = size;
+  }
+
+  get size(): number {
+    return this.#size;
+  }
+
+  get(index: number): T | undefined {
+    if (!Number.isInteger(index) || index < 0 || index >= this.#size) {
+      return undefined;
+    }
+    const root = this.#root;
+    if (root === undefined) return undefined;
+    return elementAt(root, index);
+  }
+
+  append(value: T): PersistentVector<T> {
+    const root = this.#root;
+    if (root === undefined) {
+      return new PersistentVectorImpl(leafOf([value]), 1);
+    }
+    const grown = appendRight(root, value);
+    const nextRoot = grown.sibling === undefined
+      ? grown.node
+      : branchOf([grown.node, grown.sibling]);
+    return new PersistentVectorImpl(nextRoot, this.#size + 1);
+  }
+
+  dropLast(): PersistentVector<T> {
+    const root = this.#root;
+    if (root === undefined) return this;
+    return new PersistentVectorImpl(dropRight(root), this.#size - 1);
+  }
+
+  toArray(): readonly T[] {
+    return [...this];
+  }
+
+  [Symbol.iterator](): Iterator<T> {
+    const root = this.#root;
+    return root === undefined ? [][Symbol.iterator]() : walkNode(root);
+  }
+}
+
+/**
+ * Creates an empty vector.
+ *
+ * @template T The type of the items the vector will hold.
+ * @returns An empty vector.
+ * @internal
+ * @since 1.4.0
+ */
+export function emptyPersistentVector<T>(): PersistentVector<T> {
+  return new PersistentVectorImpl<T>(undefined, 0);
+}
+
+/**
+ * Creates a vector holding the items of an array.
+ *
+ * @template T The type of the stored items.
+ * @param items The items to hold, in index order; the array is read, not kept.
+ * @returns A vector holding the items.
+ * @internal
+ * @since 1.4.0
+ */
+export function persistentVectorOf<T>(
+  items: readonly T[],
+): PersistentVector<T> {
+  let vector = emptyPersistentVector<T>();
+  for (const item of items) vector = vector.append(item);
+  return vector;
+}
+/**
+ * Items a state array must hold before appending a view instead of a copy.
+ *
+ * An append to a plain array copies every slot it has, which costs about a
+ * nanosecond per slot, and an append to a view costs about a microsecond
+ * whatever the length, so the crossover sits near a thousand items.  Below this
+ * number the code keeps plain arrays and the expression it had before; above
+ * it, the cost of an append stops growing with the state.  It is a power of two
+ * because the vector's nodes hold 32 slots.  The size was checked by running one
+ * sweep with the threshold here and one at 2,048: a parse of 3,000 items took
+ * 20.6 ms when views started at 1,025 items, 25.4 ms when the copies ran to
+ * 2,048, and 26.5 ms with the array copy alone.
+ *
+ * Exported so tests can size their state around it; nothing outside this module
+ * reads it.
+ */
+export const VIEW_THRESHOLD = 1024;
+
+/** Vectors behind each array that {@link vectorViewOf} returned. */
+const vectorSources = new WeakMap<object, PersistentVector<unknown>>();
+
+/**
+ * Reads the vector behind an array-shaped value.
+ *
+ * @template T The type of the elements.
+ * @param array The array to read, plain or virtual.
+ * @returns The vector of a virtual array, or `undefined` for a plain one.
+ */
+function vectorOf<T>(array: readonly T[]): PersistentVector<T> | undefined {
+  // The value was stored by vectorViewOf with this same element type.
+  return vectorSources.get(array) as PersistentVector<T> | undefined;
+}
+
+/**
+ * Wraps a vector in an array-shaped view.
+ *
+ * @template T The type of the elements.
+ * @param vector The vector to present.
+ * @returns An array holding the vector's elements.
+ */
+function vectorViewOf<T>(vector: PersistentVector<T>): readonly T[] {
+  const view = virtualArrayOf<T>({
+    length: vector.size,
+    get: (index) => vector.get(index),
+  });
+  vectorSources.set(view, vector);
+  return view;
+}
+
+/**
+ * Returns an array with an element after the last one, sharing the storage of
+ * the earlier array.
+ *
+ * The receiver is never modified, so an array obtained earlier keeps its
+ * elements whatever is appended to a later one.  A parser context discarded by
+ * backtracking needs exactly that: `multiple()` extends its state once per
+ * accepted item, and rebuilding the whole array each time costs O(N²) for a
+ * parse of N items.
+ *
+ * @template T The type of the elements.
+ * @param array The array to extend, plain or virtual.
+ * @param value The element to append.
+ * @returns An array one element longer.
+ * @internal
+ * @since 1.4.0
+ */
+export function appendTo<T>(array: readonly T[], value: T): readonly T[] {
+  const vector = vectorOf(array);
+  if (vector === undefined) {
+    if (array.length < VIEW_THRESHOLD) return [...array, value];
+    // The first append past the threshold copies the plain array once; every
+    // later append of its result shares storage instead of copying.
+    return vectorViewOf(persistentVectorOf([...array, value]));
+  }
+  return vectorViewOf(vector.append(value));
+}
+
+/**
+ * Returns an array without its last element, sharing the storage of the
+ * earlier array.
+ *
+ * @template T The type of the elements.
+ * @param array The array to shorten, plain or virtual.
+ * @returns An array one element shorter, or an empty array when the receiver
+ *          was empty.
+ * @internal
+ * @since 1.4.0
+ */
+export function dropLastFrom<T>(array: readonly T[]): readonly T[] {
+  const vector = vectorOf(array);
+  if (vector === undefined) return array.slice(0, -1);
+  const shorter = vector.dropLast();
+  if (shorter.size === 0) return [];
+  return vectorViewOf(shorter);
+}
