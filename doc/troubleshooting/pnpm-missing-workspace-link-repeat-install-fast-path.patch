+/// Whether a `workspace:` dependency of a project has no entry at all in the
+/// project's modules directory. The isolated linker links every non-optional
+/// `workspace:` dependency of every project, so a missing entry there was never
+/// created or was removed outside pnpm, and nothing the fast path records moves
+/// when that happens. Skipped optional and excluded dependencies have no entry
+/// by design, as do the siblings of `dedupeDirectDeps`, and the other linkers
+/// place links elsewhere, so those are not judged here.
+pub(super) fn workspace_dependency_link_missing(check: &OptimisticRepeatInstallCheck<'_>) -> bool {
+    if check.layout.node_linker != NodeLinker::Isolated || check.config.dedupe_direct_deps {
+        return false;
+    }
+    let groups: Vec<DependencyGroup> = included_groups(check.layout.included)
+        .into_iter()
+        .filter(|group| matches!(group, DependencyGroup::Prod | DependencyGroup::Dev))
+        .collect();
+    check.project_manifests
+        .par_iter()
+        .any(|(root_dir, manifest)| {
+            project_modules_dirs(check, root_dir, manifest)
+                .iter()
+                .any(|modules_dir| {
+                    manifest
+                        .dependencies(groups.iter().copied())
+                        .any(|(alias, spec)| {
+                            spec.starts_with("workspace:")
+                                && fs::symlink_metadata(modules_dir.join(alias)).is_err()
+                        })
+                })
+        })
+}
