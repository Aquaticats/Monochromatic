+// getExprIP6Payload returns the IPv6 header offsets of saddr (8) and daddr (24), 16 bytes each.
+func getExprIP6Payload(what string) *expr.Payload {
+	offset := uint32(8) // saddr
+	if what == NFT_DADDR {
+		offset = 24
+	}
+	return &expr.Payload{
+		DestRegister: 1,
+		Offset:       offset,
+		Base:         expr.PayloadBaseNetworkHeader,
+		Len:          16,
+	}
+}
+
+// ipBytes returns 4 bytes for an IPv4 address and 16 bytes for an IPv6 address.
+func ipBytes(ip net.IP) []byte {
+	if ip4 := ip.To4(); ip4 != nil {
+		return ip4
+	}
+	return ip.To16()
