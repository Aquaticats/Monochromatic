+/// The smallest rectangle that holds all of `points`.
+fn bounding_rect(points: &[LogicalPoint]) -> LogicalRect {
+    let x_min = points.iter().fold(f32::MAX, |a, p| a.min(p.x));
+    let y_min = points.iter().fold(f32::MAX, |a, p| a.min(p.y));
+    let x_max = points.iter().fold(f32::MIN, |a, p| a.max(p.x));
+    let y_max = points.iter().fold(f32::MIN, |a, p| a.max(p.y));
+    LogicalRect::new(
+        LogicalPoint::new(x_min, y_min),
+        LogicalSize::new(x_max - x_min, y_max - y_min),
+    )
+}
