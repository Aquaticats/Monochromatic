-func display(name string, at *config.AuthToken, isDefault bool, out io.Writer, style func(a ...any) string) {
+// jsonPayload returns the token map to serialise. Without --reveal it returns a
+// copy whose credential fields are masked, leaving the caller's config untouched.
+func jsonPayload(tokens config.AuthTokens, reveal bool) config.AuthTokens {
+	if reveal {
+		return tokens
+	}
+
+	redacted := make(config.AuthTokens, len(tokens))
+	for name, at := range tokens {
+		if at == nil {
+			redacted[name] = nil
+			continue
+		}
+		copied := *at
+		copied.Token = maskedToken(at.Token)
+		copied.AccessToken = maskedToken(at.AccessToken)
+		copied.RefreshToken = maskedToken(at.RefreshToken)
+		redacted[name] = &copied
+	}
+	return redacted
+}
+
+// maskedToken mirrors pkg/commands/auth/show.go, which already masks by default
+// and reveals only behind an explicit --reveal flag, so this deprecated command
+// and the replacement its own notice names agree on one shape.
+func maskedToken(token string) string {
+	switch {
+	case token == "":
+		return ""
+	case len(token) > 8:
+		return token[:4] + "..." + token[len(token)-4:]
+	default:
+		return "****"
+	}
+}
