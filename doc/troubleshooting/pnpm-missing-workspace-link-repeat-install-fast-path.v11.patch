diff --git a/pnpm11/deps/status/test/findDanglingDirectDependencyLink.test.ts b/pnpm11/deps/status/test/findDanglingDirectDependencyLink.test.ts
new file mode 100644
index 0000000..ca4d109
--- /dev/null
+++ b/pnpm11/deps/status/test/findDanglingDirectDependencyLink.test.ts
@@ -0,0 +1,80 @@
+import fs from 'node:fs'
+import path from 'node:path'
+
+import { expect, test } from '@jest/globals'
+import { prepareEmpty } from '@pnpm/prepare'
+
+import {
+  findDanglingDirectDependencyLink,
+  type FindDanglingDirectDependencyLinkOptions,
+} from '../src/findDanglingDirectDependencyLink.js'
+
+type ModulesEntry = 'link' | 'absent' | 'dangling'
+
+async function findStaleEntry (
+  manifest: Record<string, unknown>,
+  entry: ModulesEntry,
+  options: Partial<FindDanglingDirectDependencyLinkOptions> = {}
+): Promise<string | undefined> {
+  prepareEmpty()
+  const rootDir = process.cwd()
+  const projectDir = path.join(rootDir, 'app')
+  fs.mkdirSync(path.join(projectDir, 'node_modules'), { recursive: true })
+  fs.mkdirSync(path.join(rootDir, 'lib'))
+  if (entry === 'link') {
+    fs.symlinkSync(path.join(rootDir, 'lib'), path.join(projectDir, 'node_modules', 'lib'), 'junction')
+  } else if (entry === 'dangling') {
+    fs.symlinkSync(path.join(rootDir, 'gone'), path.join(projectDir, 'node_modules', 'lib'), 'junction')
+  }
+  const found = await findDanglingDirectDependencyLink({
+    lockfileDir: rootDir,
+    modulesDir: 'node_modules',
+    packageConfigs: {},
+    rootProjectManifestDir: rootDir,
+    rootProjectManifest: { name: 'ws-root' },
+    allProjects: [{ rootDir: projectDir, manifest: { name: 'app', ...manifest } }],
+    ...options,
+  } as FindDanglingDirectDependencyLinkOptions)
+  return found == null ? undefined : path.relative(rootDir, found)
+}
+
+const libEntry = path.join('app', 'node_modules', 'lib')
+
+test('a link that is present is not stale', async () => {
+  expect(await findStaleEntry({ dependencies: { lib: 'workspace:*' } }, 'link')).toBeUndefined()
+})
+
+test('a link that points nowhere is stale', async () => {
+  expect(await findStaleEntry({ dependencies: { lib: 'workspace:*' } }, 'dangling')).toBe(libEntry)
+})
+
+test.each([
+  ['dependencies', 'workspace:*'],
+  ['devDependencies', 'workspace:^'],
+])('a missing entry for a workspace dependency in %s is stale', async (field, spec) => {
+  expect(await findStaleEntry({ [field]: { lib: spec } }, 'absent')).toBe(libEntry)
+})
+
+test('a missing entry for a registry dependency is not stale', async () => {
+  expect(await findStaleEntry({ dependencies: { lib: '^1.0.0' } }, 'absent')).toBeUndefined()
+})
+
+test('a missing entry for an optional workspace dependency is not stale', async () => {
+  expect(await findStaleEntry({ optionalDependencies: { lib: 'workspace:*' } }, 'absent')).toBeUndefined()
+})
+
+test('a missing entry is not stale under the hoisted linker', async () => {
+  expect(await findStaleEntry({ dependencies: { lib: 'workspace:*' } }, 'absent', { nodeLinker: 'hoisted' })).toBeUndefined()
+})
+
+test('a missing entry is not stale when direct dependencies are deduped', async () => {
+  expect(await findStaleEntry({ dependencies: { lib: 'workspace:*' } }, 'absent', { dedupeDirectDeps: true })).toBeUndefined()
+})
+
+test('a missing entry for an excluded dependency field is not stale', async () => {
+  expect(await findStaleEntry(
+    { devDependencies: { lib: 'workspace:*' } },
+    'absent',
+    { include: { dependencies: true, devDependencies: false, optionalDependencies: true } }
+  )).toBeUndefined()
+})
