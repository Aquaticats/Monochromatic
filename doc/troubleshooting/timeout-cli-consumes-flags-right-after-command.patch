+#[test]
+fn test_timeout_flags_right_after_the_command_belong_to_the_command() {
+    // Each case starts with a flag that timeout itself defines, placed directly after the command.
+    // `echo` prints whatever it receives, so the output shows what the command was given.
+    // Two or more arguments keep GNU echo from treating a lone `--help` or `--version` as its own request.
+    let cases: [&[&str]; 8] = [
+        &["-V", "x"],
+        &["--version", "x"],
+        &["-h", "x"],
+        &["--help", "x"],
+        &["-v", "x"],
+        &["--verbose", "x"],
+        &["-k", "3", "x"],
+        &["--kill-after", "3", "x"],
+    ];
+
+    for command_arguments in cases {
+        let mut cmd = Command::cargo_bin("timeout").unwrap();
+        cmd.args(["5", "echo"]).args(command_arguments);
+
+        cmd.assert()
+            .success()
+            .stdout(format!("{}\n", command_arguments.join(" ")))
+            .stderr("");
+    }
+}
