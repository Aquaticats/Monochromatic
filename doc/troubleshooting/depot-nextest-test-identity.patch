+  if (!value.passed || value.preparation.harness !== harness || value.preparation.applicationBase !== 'e02be6c8b8fe9efb41a7f8f1a0b311c17796588a' || value.preparation.cohortNonce !== expectedNonce || !value.runs.every(run => run.status === 0 && run.execution.actualCasesExactlyMatchSelection && run.execution.cleanup.tmpfsGone && run.execution.adapter?.rawSha256 === run.execution.junitSha256 && run.execution.adapter.mappings.length === run.execution.actualCases.length && run.execution.adapter.mappings.every(mapping => mapping.derivedClassname === mapping.testName && run.execution.actualCases.includes(mapping.testName)))) throw new PhysicalConsumerFailure('Physical producer/source/current-cohort assertion mismatch');
+  return { path, sha256: createHash('sha256').update(bytes).digest('hex'), value };
+});
+const seed = producers.find(value => value.value.phase === 'seed');
+const shards = producers.filter(value => value.value.phase === 'shard').sort((a, b) => a.value.shardIndex - b.value.shardIndex);
+if (!seed || shards.length !== 2 || shards[0].value.shardIndex !== 0 || shards[1].value.shardIndex !== 1 || new Set(producers.map(value => value.value.preparation.vmNonce)).size !== 3) throw new PhysicalConsumerFailure('Distinct declared seed/shard producers are missing');
+const candidates = fs.readFileSync(join(base, 'candidates.txt'), 'utf8').trim().split('\n').sort();
+const union = shards.flatMap(value => value.value.runs[0].execution.actualCases);
+if (union.length !== 34 || new Set(union).size !== 34 || JSON.stringify([...union].sort()) !== JSON.stringify(candidates)) throw new PhysicalConsumerFailure('Physical shard cases do not form the exact disjoint frozen union');
+const result = { passed: true, harness, cohortNonce: expectedNonce, applicationBase: 'e02be6c8b8fe9efb41a7f8f1a0b311c17796588a', candidateCount: candidates.length, shardCaseCounts: shards.map(value => value.value.runs[0].execution.actualCases.length), distinctProducerVmNonces: true, physicalSandboxIdentityRequiresApiJoin: true, exactDisjointUnion: true, productionSourceRepairClaimed: false, producers };
+fs.mkdirSync(join(base, 'evidence'), { recursive: true });
+fs.writeFileSync(join(base, 'evidence/consumer.json'), JSON.stringify(result, null, 2) + '\n');
+console.log(JSON.stringify({ passed: true, candidateCount: candidates.length, shardCaseCounts: result.shardCaseCounts, exactDisjointUnion: true, physicalSandboxIdentityRequiresApiJoin: true }));
+'''
+
+[tasks.history-lookup]
+shell = "node --input-type=module-typescript -e"
+run = '''
+const fs = await import('node:fs');
+const { spawnSync, execFileSync } = await import('node:child_process');
+const names = fs.readFileSync('candidates.txt', 'utf8').trim().split('\n');
+if (names.length !== 34 || new Set(names).size !== 34) throw new Error('Frozen history candidate scope differs');
+const key = 'research-identity-adapter-locks-e02be6c8-20261018';
+const cases = [
+  { label: 'original-per-test-index0', names, timing: 'testname', key, index: 0 },
+  { label: 'original-per-test-index1', names, timing: 'testname', key, index: 1 },
+  { label: 'per-test-class-timing', names, timing: 'classname', key, index: 0 },
+  { label: 'actual-class-test-timing', names: ['monochromatic-git-policy-cli'], timing: 'testname', key: key + ':actual-class', index: 0 },
+  { label: 'actual-class-class-timing', names: ['monochromatic-git-policy-cli'], timing: 'classname', key: key + ':actual-class', index: 0 },
+  { label: 'per-test-report-key', names, timing: 'testname', key: key + ':seed-1', index: 0 },
+  { label: 'actual-class-report-key', names: ['monochromatic-git-policy-cli'], timing: 'testname', key: key + ':seed-2', index: 0 },
+  { label: 'absent-class-negative', names: ['mono_research_definitely_absent_class_20261018'], timing: 'testname', key: key + ':absent-control', index: 0 },
+];
+fs.mkdirSync('history-evidence', { recursive: true });
+const records = [];
+for (const value of cases) {
+  const args = ['tests', 'split', '--candidate-type', 'classname', '--timings-type', value.timing, '--index', String(value.index), '--total', '2', '--key', value.key, '--output', 'json'];
+  const result = spawnSync('depot', args, { input: value.names.join('\n') + '\n', encoding: 'utf8', timeout: 20000, maxBuffer: 1048576 });
+  const output = result.status === 0 ? JSON.parse(result.stdout) : null;
+  if (output && (output.candidates_requested !== value.names.length || output.candidates.some(name => !value.names.includes(name)))) throw new Error('History response has an unexpected candidate scope');
+  const record = { ...value, args, status: result.status, signal: result.signal, error: result.error ? { code: result.error.code, syscall: result.error.syscall } : null, stdout: result.stdout, stderr: result.stderr, output };
+  records.push(record);
+  console.log(JSON.stringify({ label: value.label, status: result.status, candidatesWithTimings: output?.candidates_with_timings ?? null, selected: output?.candidates_selected ?? null }));
+}
+const record = { probe: 'physical-history-identity', source: execFileSync('git', ['rev-parse', 'HEAD'], { encoding: 'utf8' }).trim(), cli: execFileSync('depot', ['version'], { encoding: 'utf8' }).trim(), repository: process.env.GITHUB_REPOSITORY, ref: process.env.GITHUB_REF, sha: process.env.GITHUB_SHA, records, uploadsPerformed: false, applicationTestsExecuted: false, at: new Date().toISOString() };
+fs.writeFileSync('history-evidence/identity.json', JSON.stringify(record, null, 2) + '\n');
+if (records.some(value => value.status !== 0)) throw new Error('At least one bounded history lookup failed; retain separate request diagnostics');
+'''
+
+[tasks.map-report]
+dir = "{{config_root}}/../../.."
+shell = "node --input-type=module-typescript -e"
+run = '''
+import { readFileSync, writeFileSync, statSync } from 'node:fs';
+import { join, resolve } from 'node:path';
+import { createHash } from 'node:crypto';
+class IdentityAdapterFailure extends Error {}
+
+function hash(value) {
+  return createHash('sha256').update(value).digest('hex');
+}
+
+function whitespace(value) {
+  return /^[\t\n\r ]*$/u.test(value);
+}
+
+function parseTag(tag) {
+  const close = /^<\/([A-Za-z][A-Za-z_0-9-]*)>$/u.exec(tag);
+  if (close) return { name: close[1], close: true, empty: false, attributes: new Map() };
+  const opening = /^<([A-Za-z][A-Za-z_0-9-]*)([^<>]*?)(\/?)>$/u.exec(tag);
+  if (!opening) throw new IdentityAdapterFailure('Unsupported XML tag syntax');
+  const attributes = new Map();
+  const attributeSource = opening[2];
+  const pattern = /[\t\n\r ]+([a-z][a-z_0-9-]*)="([A-Za-z_0-9:.+-]+)"/uy;
+  let offset = 0;
+  while (offset < attributeSource.length) {
+    if (whitespace(attributeSource.slice(offset))) break;
+    pattern.lastIndex = offset;
+    const match = pattern.exec(attributeSource);
+    if (!match || match.index !== offset || attributes.has(match[1])) {
+      throw new IdentityAdapterFailure('Malformed or duplicate XML attribute');
+    }
+    const start = 1 + opening[1].length + match.index + match[0].indexOf('"') + 1;
+    attributes.set(match[1], { value: match[2], start, end: start + match[2].length });
+    offset = pattern.lastIndex;
+  }
+  return { name: opening[1], close: false, empty: opening[3] === '/', attributes };
+}
+
+function value(attributes, name) {
+  const attribute = attributes.get(name);
+  if (!attribute) throw new IdentityAdapterFailure('Required XML attribute is missing: ' + name);
+  return attribute.value;
+}
+
+function ensureAllowed({ attributes, allowed }) {
+  for (const key of attributes.keys()) {
+    if (!allowed.includes(key)) throw new IdentityAdapterFailure('Unexpected XML attribute: ' + key);
+  }
+}
+
+function escapeAttribute(text) {
+  const entities = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&apos;' };
+  return text.replace(/[&<>"']/gu, character => entities[character]);
+}
+
+function mapReport({ raw, selected, universe }) {
+  if (!Array.isArray(selected) || selected.length < 1 || selected.length > 34
+    || new Set(selected).size !== selected.length
+    || selected.some(name => typeof name !== 'string' || !/^[A-Za-z_0-9:]+$/u.test(name)
+      || Buffer.byteLength(name) > 4096 || !universe.includes(name))) {
+    throw new IdentityAdapterFailure('Selection contains duplicate, unknown or unsupported runnable names');
+  }
+  if (!raw.length || raw.length > 1048576 || raw.some(byte => byte > 126 || (byte < 32 && ![9, 10, 13].includes(byte)))) {
+    throw new IdentityAdapterFailure('This adapter accepts only bounded ASCII Nextest reports');
+  }
+  const xml = raw.toString('utf8');
+  const declaration = '<?xml version="1.0" encoding="UTF-8"?>';
+  const tokens = [...xml.matchAll(/<[^<>]*>/gu)];
+  let stage = 'declaration';
+  let cursor = 0;
+  const parts = [];
+  const mappings = [];
+  const seen = new Set();
+  for (const token of tokens) {
+    if (!whitespace(xml.slice(cursor, token.index))) throw new IdentityAdapterFailure('Unsupported XML text or markup');
+    parts.push(xml.slice(cursor, token.index));
+    const tag = token[0];
+    let replacement = tag;
+    if (stage === 'declaration') {
+      if (tag !== declaration) throw new IdentityAdapterFailure('The exact UTF-8 XML declaration is required');
+      stage = 'document';
+    } else {
+      const parsed = parseTag(tag);
+      const attributes = parsed.attributes;
+      if (stage === 'document' && parsed.name === 'testsuites' && !parsed.close && !parsed.empty) {
+        ensureAllowed({ attributes, allowed: ['name', 'tests', 'skipped', 'failures', 'errors', 'uuid', 'timestamp', 'time'] });
+        if (value(attributes, 'name') !== 'nextest-run' || value(attributes, 'tests') !== String(selected.length)
+          || ['skipped', 'failures', 'errors'].some(name => value(attributes, name) !== '0')) {
+          throw new IdentityAdapterFailure('The root report scope or passing status differs');
+        }
+        stage = 'suite';
+      } else if (stage === 'suite' && parsed.name === 'testsuite' && !parsed.close && !parsed.empty) {
+        ensureAllowed({ attributes, allowed: ['name', 'tests', 'skipped', 'failures', 'errors'] });
+        if (value(attributes, 'name') !== 'monochromatic-git-policy-cli'
+          || value(attributes, 'tests') !== String(selected.length)
+          || ['skipped', 'failures', 'errors'].some(name => value(attributes, name) !== '0')) {
+          throw new IdentityAdapterFailure('The original Nextest binary suite or passing status differs');
+        }
+        stage = 'cases';
+      } else if (stage === 'cases' && parsed.name === 'testcase' && parsed.empty && !parsed.close) {
+        ensureAllowed({ attributes, allowed: ['name', 'classname', 'timestamp', 'time'] });
+        const name = value(attributes, 'name');
+        const originalClassname = value(attributes, 'classname');
+        const time = value(attributes, 'time');
+        if (!selected.includes(name) || seen.has(name) || originalClassname !== 'monochromatic-git-policy-cli'
+          || !/^(?:0|[1-9][0-9]*)(?:\.[0-9]+)?$/u.test(time) || !Number.isFinite(Number(time))) {
+          throw new IdentityAdapterFailure('Duplicate, unselected, cross-binary or invalid-duration testcase');
+        }
+        const attribute = attributes.get('classname');
+        replacement = tag.slice(0, attribute.start) + escapeAttribute(name) + tag.slice(attribute.end);
+        mappings.push({ originalSuite: 'monochromatic-git-policy-cli', originalClassname, testName: name,
+          derivedClassname: name, durationSecondsText: time });
+        seen.add(name);
+      } else if (stage === 'cases' && parsed.name === 'testsuite' && parsed.close) {
+        stage = 'suite-closed';
+      } else if (stage === 'suite-closed' && parsed.name === 'testsuites' && parsed.close) {
+        stage = 'closed';
+      } else {
+        throw new IdentityAdapterFailure('Unsupported XML structure or nonempty testcase');
+      }
+    }
+    parts.push(replacement);
+    cursor = token.index + tag.length;
+  }
+  if (stage !== 'closed' || !whitespace(xml.slice(cursor)) || seen.size !== selected.length) {
+    throw new IdentityAdapterFailure('The report is incomplete or does not cover the exact selection');
+  }
+  parts.push(xml.slice(cursor));
+  return { xml: parts.join(''), mappings };
+}
+
+const base = join(process.cwd(), '.depot/research/test-identity-adapter');
+const paths = ['ADAPTER_RAW_PATH', 'ADAPTER_SELECTION_PATH', 'ADAPTER_DERIVED_PATH', 'ADAPTER_MAPPING_PATH']
+  .map(name => process.env[name]);
+if (paths.some(path => !path) || new Set(paths.map(path => resolve(path))).size !== paths.length) {
+  throw new IdentityAdapterFailure('Distinct explicit raw, selection, derived and mapping paths are required');
+}
+const [rawPath, selectionPath, derivedPath, mappingPath] = paths;
+if (statSync(rawPath).size > 1048576 || statSync(selectionPath).size > 1048576) {
+  throw new IdentityAdapterFailure('A source file exceeds the admitted parser bound');
+}
+const raw = readFileSync(rawPath);
+const selected = JSON.parse(readFileSync(selectionPath, 'utf8'));
+const universe = readFileSync(join(base, 'candidates.txt'), 'utf8').trim().split('\n');
+const mapped = mapReport({ raw, selected, universe });
+const derived = Buffer.from(mapped.xml);
+const receipt = { schemaVersion: 1, researchOnly: true, adapter: 'nextest-exact-testname-as-classname-v1',
+  rawSha256: hash(raw), rawBytes: raw.length, derivedSha256: hash(derived), derivedBytes: derived.length,
+  selected, mappings: mapped.mappings, originalSuiteAndTestNamesPreserved: true,
+  onlyClassnameAttributeValuesChanged: true, arbitraryJunitCompatibilityClaimed: false };
+writeFileSync(derivedPath, derived, { flag: 'wx', mode: 0o600 });
+writeFileSync(mappingPath, JSON.stringify(receipt, null, 2) + '\n', { flag: 'wx', mode: 0o600 });
+if (!readFileSync(rawPath).equals(raw)) throw new IdentityAdapterFailure('Raw report changed while mapping');
+console.log(JSON.stringify({ passed: true, researchOnly: true, rawSha256: receipt.rawSha256,
+  derivedSha256: receipt.derivedSha256, mappedCases: receipt.mappings.length }));
+'''
+
+[tasks.verify-report-mapping]
+dir = "{{config_root}}"
+shell = "node --input-type=module-typescript -e"
+run = '''
+import { readFileSync, writeFileSync, mkdtempSync, existsSync } from 'node:fs';
+import { join } from 'node:path';
+import { spawnSync, execFileSync } from 'node:child_process';
+import { createHash } from 'node:crypto';
+import { strict as assert } from 'node:assert';
+const input = process.env.ADAPTER_CONTROL_INPUT_DIRECTORY;
+if (!input) throw new Error('An explicit owned control-input directory is required');
+const raw = readFileSync(join(input, 'seed.xml'), 'utf8');
+const selected = [...raw.matchAll(/<testcase\b[^<>]*\bname="([A-Za-z_0-9:]+)"/gu)].map(value => value[1]);
+assert.equal(selected.length, 34);
+const firstTag = /<testcase\b[^<>]*\/>/u.exec(raw)[0];
+const first = selected[0];
+const second = selected[1];
+const hash = value => createHash('sha256').update(value).digest('hex');
+const scenarios = [
+  { name: 'original-seed', raw, selected, status: 0 },
+  ...[0, 1].map(index => {
+    const xml = readFileSync(join(input, 'shard-' + index + '.xml'), 'utf8');
+    return { name: 'original-shard-' + index, raw: xml,
+      selected: [...xml.matchAll(/<testcase\b[^<>]*\bname="([A-Za-z_0-9:]+)"/gu)].map(value => value[1]), status: 0 };
+  }),
+  { name: 'attribute-order', raw: raw.replace(firstTag, firstTag.replace(
+    'name="' + first + '" classname="monochromatic-git-policy-cli"',
+    'classname="monochromatic-git-policy-cli" name="' + first + '"')), selected, status: 0 },
+  { name: 'duplicate-selection', raw, selected: [...selected.slice(1), second], status: 1 },
+  { name: 'unknown-selection', raw, selected: ['research_absent_case_20261018', ...selected.slice(1)], status: 1 },
+  { name: 'selection-quote-boundary', raw, selected: ['x" injected="y', ...selected.slice(1)], status: 1 },
+  { name: 'selection-newline-boundary', raw, selected: ['x\ny', ...selected.slice(1)], status: 1 },
+  ...[
+    ['selection-delimiter-boundary', 'x<y>'],
+    ['selection-escape-boundary', 'x' + String.fromCharCode(92) + 'y'],
+    ['selection-traversal-boundary', '../../unowned'],
+    ['selection-command-boundary', 'x;unowned'],
+    ['selection-source-escape-boundary', String.fromCharCode(92) + 'u003c'],
+    ['selection-entity-boundary', 'x&amp;y'],
+  ].map(([name, invalid]) => ({ name, raw, selected: [invalid, ...selected.slice(1)], status: 1 })),
+  { name: 'duplicate-case', raw: raw.replace('name="' + first + '"', 'name="' + second + '"'), selected, status: 1 },
+  { name: 'unknown-report-case', raw: raw.replace('name="' + first + '"', 'name="research_absent_case_20261018"'), selected, status: 1 },
+  { name: 'cross-binary-class', raw: raw.replace('classname="monochromatic-git-policy-cli"', 'classname="other-binary"'), selected, status: 1 },
+  { name: 'duplicate-attribute', raw: raw.replace('classname="monochromatic-git-policy-cli"',
+    'classname="monochromatic-git-policy-cli" classname="monochromatic-git-policy-cli"'), selected, status: 1 },
+  { name: 'attribute-injection', raw: raw.replace('classname="monochromatic-git-policy-cli"',
+    'classname="monochromatic-git-policy-cli" injected="value"'), selected, status: 1 },
+  { name: 'negative-duration', raw: raw.replace(/(<testcase\b[^<>]* time=")[^"]+/u,
+    (all, prefix) => prefix + '-1'), selected, status: 1 },
+  { name: 'nonfinite-duration', raw: raw.replace(/(<testcase\b[^<>]* time=")[^"]+/u,
+    (all, prefix) => prefix + '9'.repeat(400)), selected, status: 1 },
+  { name: 'nested-failure', raw: raw.replace(firstTag, firstTag.slice(0, -2)
+    + '><failure message="invented">unowned</failure></testcase>'), selected, status: 1 },
+  { name: 'missing-case', raw: raw.replace(firstTag, ''), selected, status: 1 },
+  { name: 'entity-declaration', raw: raw.replace('<testsuites ', '<!DOCTYPE testsuites [<!ENTITY probe "x">]><testsuites '), selected, status: 1 },
+  { name: 'extra-root-markup', raw: raw + '<unowned/>', selected, status: 1 },
+  { name: 'unexpected-text', raw: raw.replace('</testsuite>', 'unowned-text</testsuite>'), selected, status: 1 },
+  { name: 'non-ascii', raw: raw.replace('nextest-run', 'nextest-rún'), selected, status: 1 },
+  { name: 'oversized', raw: ' '.repeat(1048577), selected, status: 1 },
+];
+const only = process.env.ADAPTER_MUTANT_ONLY;
+const chosen = only ? scenarios.filter(value => value.name === only) : scenarios;
+assert(chosen.length);
+const output = mkdtempSync(join(input, 'mapping-control-'));
+const rows = [];
+for (const scenario of chosen) {
+  const base = join(output, scenario.name);
+  const rawPath = base + '.raw.xml';
+  const selectionPath = base + '.selection.json';
+  const derivedPath = base + '.derived.xml';
+  const mappingPath = base + '.mapping.json';
+  writeFileSync(rawPath, scenario.raw);
+  writeFileSync(selectionPath, JSON.stringify(scenario.selected));
+  const result = spawnSync('mise', ['run', '//.depot/research/test-identity-adapter:map-report'], {
+    cwd: process.cwd(), env: { ...process.env, ADAPTER_RAW_PATH: rawPath, ADAPTER_SELECTION_PATH: selectionPath,
+      ADAPTER_DERIVED_PATH: derivedPath, ADAPTER_MAPPING_PATH: mappingPath },
+    encoding: 'utf8', timeout: 30000, maxBuffer: 1048576,
+  });
+  const row = { name: scenario.name, expectedStatus: scenario.status, status: result.status,
+    rawSha256: hash(scenario.raw), stdoutSha256: hash(result.stdout ?? ''), stderrSha256: hash(result.stderr ?? '') };
+  rows.push(row);
+  writeFileSync(join(output, 'controls.json'), JSON.stringify(rows, null, 2) + '\n');
+  assert.equal(result.status, scenario.status, scenario.name + ': ' + result.stderr);
+  assert.equal(readFileSync(rawPath, 'utf8'), scenario.raw);
+  if (scenario.status === 0) {
+    const expected = scenario.raw.replace(/<testcase\b[^<>]*\/>/gu, tag => {
+      const name = /\bname="([A-Za-z_0-9:]+)"/u.exec(tag)[1];
+      return tag.replace(/classname="[^"]*"/u, 'classname="' + name + '"');
+    });
+    assert.notEqual(expected, scenario.raw);
+    const derived = readFileSync(derivedPath, 'utf8');
+    assert.equal(derived, expected);
+    const mapping = JSON.parse(readFileSync(mappingPath, 'utf8'));
+    assert.equal(mapping.rawSha256, hash(scenario.raw));
+    assert.equal(mapping.derivedSha256, hash(derived));
+    assert.deepEqual(mapping.mappings.map(value => value.derivedClassname).sort(), [...scenario.selected].sort());
+  } else {
+    assert.equal(existsSync(derivedPath), false);
+    assert.equal(existsSync(mappingPath), false);
+  }
+}
+const record = { passed: true, source: execFileSync('git', ['rev-parse', 'HEAD'], { encoding: 'utf8' }).trim(),
+  scenarios: rows.length, positiveControls: rows.filter(value => value.status === 0).length,
+  rejectedControls: rows.filter(value => value.status === 1).length, output, rows };
+writeFileSync(join(output, 'result.json'), JSON.stringify(record, null, 2) + '\n');
+console.log(JSON.stringify(record));
+'''
diff --git a/.depot/workflows/test-identity-adapter.yml b/.depot/workflows/test-identity-adapter.yml
new file mode 100644
index 0000000000..6b96bdc020
--- /dev/null
+++ b/.depot/workflows/test-identity-adapter.yml
@@ -0,0 +1,118 @@
+name: research derived Nextest identities and physical shards
+on:
+  workflow_dispatch:
+permissions:
+  contents: read
+env:
+  MISE_AUTO_INSTALL: 'false'
+  MISE_LOCKED: '1'
+jobs:
+  seed:
+    runs-on: depot-ubuntu-24.04
+    timeout-minutes: 8
+    outputs:
+      cohort_nonce: ${{ steps.prepared.outputs.cohort_nonce }}
+    steps:
+    - uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd
+      with:
+        persist-credentials: false
+    - uses: jdx/mise-action@c2a87611a18de5b3828c5652fe268e992400cb5c
+      with:
+        # Keep the previously exercised bootstrap independent of application source.
+        version: 2026.10.9
+        install: false
+        cache: false
+    - run: mise install node github:depot/cli
+      working-directory: .depot/research/test-identity-adapter
+    - id: prepared
+      run: mise run //.depot/research/test-identity-adapter:prepare
+      working-directory: .depot/research/test-identity-adapter
+      env:
+        MONO_RESEARCH_IDENTITY_ADAPTER_URL_20261018: ${{ secrets.MONO_RESEARCH_IDENTITY_ADAPTER_URL_20261018 }}
+    - run: mise run //.depot/research/test-identity-adapter:run-cohort
+      working-directory: .depot/research/test-identity-adapter
+      env:
+        PROBE_PHASE: seed
+    - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
+      with:
+        name: research-test-identity-adapter-input
+        path: .depot/research/test-identity-adapter/transfer/diagnostic.zip
+        retention-days: 1
+        if-no-files-found: error
+    - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
+      if: always()
+      with:
+        name: research-test-identity-adapter-evidence-seed
+        path: .depot/research/test-identity-adapter/evidence/
+        retention-days: 7
+        if-no-files-found: error
+  physical:
+    needs: seed
+    runs-on: depot-ubuntu-24.04
+    timeout-minutes: 8
+    strategy:
+      max-parallel: 1
+      matrix:
+        index: [0, 1]
+    env:
+      PROBE_COHORT_NONCE: ${{ needs.seed.outputs.cohort_nonce }}
+    steps:
+    - uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd
+      with:
+        persist-credentials: false
+    - uses: jdx/mise-action@c2a87611a18de5b3828c5652fe268e992400cb5c
+      with:
+        # Match the seed bootstrap so only selection and physical allocation change.
+        version: 2026.10.9
