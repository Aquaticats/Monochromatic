diff --git a/packages/core/src/internal/immutable-string-map.test.ts b/packages/core/src/internal/immutable-string-map.test.ts
new file mode 100644
index 00000000..dad128cb
--- /dev/null
+++ b/packages/core/src/internal/immutable-string-map.test.ts
@@ -0,0 +1,184 @@
+/**
+ * Unit tests for the immutable string-keyed map the input trace stores its
+ * entries in.
+ */
+import { describe, test } from "node:test";
+import * as assert from "node:assert/strict";
+import * as fc from "fast-check";
+import {
+  createImmutableStringMap,
+  hashStringKey,
+  type ImmutableStringMap,
+} from "./immutable-string-map.ts";
+
+// =============================================================================
+// Helpers
+// =============================================================================
+
+// Overwrites and deletes only ever meet each other when the keys repeat, so
+// the random-operation test draws from a pool much smaller than its sequences.
+const KEY_POOL = [
+  "",
+  "a",
+  "b",
+  "aa",
+  "ab",
+  "ba",
+  "paths",
+  "paths0",
+  "paths1",
+  "a\u0000sb",
+];
+
+const COLLISION_SEARCH_LIMIT = 300_000;
+
+/**
+ * Finds two keys that hash to the same 32-bit value.
+ *
+ * Real keys almost never collide, so the shared-leaf path is only reachable
+ * on purpose.  The search is a birthday attack over a fixed key sequence, so
+ * it finds the same pair on every run.
+ */
+function findCollidingKeys(): readonly [string, string] | undefined {
+  const seen = new Map<number, string>();
+  for (let index = 0; index < COLLISION_SEARCH_LIMIT; index += 1) {
+    const key = `k${index}`;
+    const hash = hashStringKey(key);
+    const earlier = seen.get(hash);
+    if (earlier !== undefined) return [earlier, key];
+    seen.set(hash, key);
+  }
+  return undefined;
+}
+
+function assertMatches<V>(
+  map: ImmutableStringMap<V>,
+  expected: ReadonlyMap<string, V>,
+): void {
+  for (const key of KEY_POOL) {
+    assert.equal(map.get(key), expected.get(key), `key ${JSON.stringify(key)}`);
+  }
+}
+
+// =============================================================================
+// Tests
+// =============================================================================
+
+describe("immutable string map", () => {
+  test("set and get roundtrip", () => {
+    const map = createImmutableStringMap<number>().set("a", 1).set("b", 2);
+    assert.equal(map.get("a"), 1);
+    assert.equal(map.get("b"), 2);
+    assert.equal(map.get("c"), undefined);
+  });
+
+  test("an earlier map never observes a later write", () => {
+    const empty = createImmutableStringMap<number>();
+    const first = empty.set("a", 1);
+    const second = first.set("b", 2);
+    assert.equal(empty.get("a"), undefined);
+    assert.equal(first.get("a"), 1);
+    assert.equal(first.get("b"), undefined);
+    assert.equal(second.get("a"), 1);
+    assert.equal(second.get("b"), 2);
+  });
+
+  test("overwriting a key keeps the earlier map on the earlier value", () => {
+    const first = createImmutableStringMap<number>().set("a", 1);
+    const second = first.set("a", 2);
+    assert.equal(first.get("a"), 1);
+    assert.equal(second.get("a"), 2);
+  });
+
+  test("delete removes the key from the new map only", () => {
+    const first = createImmutableStringMap<number>().set("a", 1).set("b", 2);
+    const second = first.delete("a");
+    assert.equal(second.get("a"), undefined);
+    assert.equal(second.get("b"), 2);
+    assert.equal(first.get("a"), 1);
+  });
+
+  test("delete of a missing key leaves every other key readable", () => {
+    const first = createImmutableStringMap<number>().set("a", 1);
+    const second = first.delete("missing");
+    assert.equal(second.get("a"), 1);
+    assert.equal(second.get("missing"), undefined);
+    assert.equal(first.get("a"), 1);
+  });
+
+  test("every key of a long chain stays readable", () => {
+    const count = 5_000;
+    let map = createImmutableStringMap<number>();
+    for (let index = 0; index < count; index += 1) {
+      map = map.set(`k${index}`, index);
+    }
+    for (let index = count - 1; index >= 0; index -= 1) {
+      assert.equal(map.get(`k${index}`), index);
+    }
+    assert.equal(map.get("k"), undefined);
+    assert.equal(map.get(`k${count}`), undefined);
+  });
+
+  test("keys with the same hash are all retrievable", () => {
+    const colliding = findCollidingKeys();
+    assert.ok(
+      colliding != null,
+      `no two of the first ${COLLISION_SEARCH_LIMIT} keys share a hash, so the shared-leaf case lost its coverage.`,
+    );
+    const [first, second] = colliding;
+    const map = createImmutableStringMap<number>()
+      .set(first, 1)
+      .set(second, 2);
+    assert.equal(map.get(first), 1);
+    assert.equal(map.get(second), 2);
+
+    const afterDelete = map.delete(first);
+    assert.equal(afterDelete.get(first), undefined);
+    assert.equal(afterDelete.get(second), 2);
+    assert.equal(map.get(first), 1);
+
+    const overwritten = map.set(second, 3);
+    assert.equal(overwritten.get(first), 1);
+    assert.equal(overwritten.get(second), 3);
+  });
+
+  test("random operation sequences agree with a plain map", () => {
+    const setOperation = fc
+      .tuple(fc.constantFrom(...KEY_POOL), fc.integer({ min: 0, max: 1_000 }))
+      .map(([key, value]) => ({ kind: "set" as const, key, value }));
+    const deleteOperation = fc
+      .constantFrom(...KEY_POOL)
+      .map((key) => ({ kind: "delete" as const, key }));
+
+    fc.assert(
+      fc.property(
+        fc.array(fc.oneof(setOperation, deleteOperation), { maxLength: 60 }),
+        (operations) => {
+          let map = createImmutableStringMap<number>();
+          const expected = new Map<string, number>();
+          // Every intermediate map has to keep matching the plain map it was
+          // built beside, which is what a parser relying on an earlier trace
+          // needs from this structure.
+          const snapshots: {
+            readonly map: ImmutableStringMap<number>;
+            readonly expected: ReadonlyMap<string, number>;
+          }[] = [];
+          for (const current of operations) {
+            if (current.kind === "set") {
+              map = map.set(current.key, current.value);
+              expected.set(current.key, current.value);
+            } else {
+              map = map.delete(current.key);
+              expected.delete(current.key);
+            }
+            snapshots.push({ map, expected: new Map(expected) });
+          }
+          for (const snapshot of snapshots) {
+            assertMatches(snapshot.map, snapshot.expected);
+          }
+        },
+      ),
+      { numRuns: 200 },
+    );
+  });
+});
