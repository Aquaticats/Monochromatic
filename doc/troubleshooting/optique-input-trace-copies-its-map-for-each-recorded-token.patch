index 00000000..5f2fe79d
--- /dev/null
+++ b/packages/core/src/internal/immutable-string-map.ts
@@ -0,0 +1,350 @@
+/**
+ * An immutable map keyed by string, backed by a hash-array-mapped trie.
+ *
+ * The input trace records one entry per consumed input token, and every
+ * earlier trace version has to stay readable and unchanged, so a plain map
+ * copied on each write makes recording N tokens cost O(N²).  This map copies
+ * only the nodes on the path to the written key: a write and a read both
+ * touch O(log32 N) nodes, and earlier versions keep working because no node,
+ * child array or entry list is modified after it is created.
+ *
+ * @internal
+ * @since 1.4.0
+ * @module
+ */
+
+/** Bits of the key hash consumed per trie level, i.e. slots per branch. */
+const BITS_PER_LEVEL = 5;
+
+/** Number of child slots a branch node has, and the mask of one slot. */
+const SLOT_MASK = (1 << BITS_PER_LEVEL) - 1;
+
+/** Width of the hash returned by {@link hashStringKey}. */
+const HASH_BITS = 32;
+
+/**
+ * Computes the 32-bit hash that routes a key through the trie.
+ *
+ * Exported so tests can search for two keys whose hashes collide and thereby
+ * cover the shared-leaf case; nothing outside this module needs it.
+ *
+ * @param key The key to hash.
+ * @returns An unsigned 32-bit hash of the key.
+ * @internal
+ */
+export function hashStringKey(key: string): number {
+  // FNV-1a over the key's code units, then the murmur3 32-bit finalizer:
+  // FNV-1a alone avalanches poorly in the low bits, and the trie reads the
+  // low bits first.
+  let hash = 0x811c9dc5;
+  for (let index = 0; index < key.length; index += 1) {
+    hash ^= key.charCodeAt(index);
+    hash = Math.imul(hash, 0x01000193);
+  }
+  hash ^= hash >>> 16;
+  hash = Math.imul(hash, 0x85ebca6b);
+  hash ^= hash >>> 13;
+  hash = Math.imul(hash, 0xc2b2ae35);
+  hash ^= hash >>> 16;
+  return hash >>> 0;
+}
+
+/**
+ * One key-value pair in a leaf, with the hash that routed it there.
+ */
+interface LeafEntry<V> {
+  readonly hash: number;
+  readonly key: string;
+  readonly value: V;
+}
+
+/**
+ * A terminal node holding one entry, or several entries whose keys hash to
+ * the same 32-bit value.
+ */
+interface Leaf<V> {
+  readonly kind: "leaf";
+  readonly entries: readonly LeafEntry<V>[];
+}
+
+/**
+ * An interior node whose `bitmap` marks the slots that hold a child, each
+ * child sitting at the rank of its slot among the set bits.
+ */
+interface Branch<V> {
+  readonly kind: "branch";
+  readonly bitmap: number;
+  readonly children: readonly TrieNode<V>[];
+}
+
+type TrieNode<V> = Branch<V> | Leaf<V>;
+
+function branchOf<V>(
+  bitmap: number,
+  children: readonly TrieNode<V>[],
+): Branch<V> {
+  return { kind: "branch", bitmap, children };
+}
+
+function leafOf<V>(entry: LeafEntry<V>): Leaf<V> {
+  return { kind: "leaf", entries: [entry] };
+}
+
+/** Returns the slot of a hash at one trie level. */
+function slotAt(hash: number, shift: number): number {
+  return (hash >>> shift) & SLOT_MASK;
+}
+
+/** Returns the index of a slot in a branch's children array. */
+function rankOf(bitmap: number, bit: number): number {
+  let remaining = bitmap & (bit - 1);
+  let rank = 0;
+  while (remaining !== 0) {
+    remaining &= remaining - 1;
+    rank += 1;
+  }
+  return rank;
+}
+
+/**
+ * Returns the shallowest level at which two hashes occupy different slots, or
+ * `undefined` when they occupy the same slot at every level.
+ */
+function firstDifferingShift(
+  left: number,
+  right: number,
+  fromShift: number,
+): number | undefined {
+  for (
+    let shift = fromShift;
+    shift < HASH_BITS;
+    shift += BITS_PER_LEVEL
+  ) {
+    if (slotAt(left, shift) !== slotAt(right, shift)) return shift;
+  }
+  return undefined;
+}
+
+function getEntry<V>(
+  node: TrieNode<V> | undefined,
+  hash: number,
+  key: string,
+): V | undefined {
+  let current = node;
+  let shift = 0;
+  while (current !== undefined) {
+    if (current.kind === "leaf") {
+      // A leaf holds more than one entry only on a full 32-bit hash
+      // collision, so the key comparison decides, not the hash.
+      for (const entry of current.entries) {
+        if (entry.key === key) return entry.value;
+      }
+      return undefined;
+    }
+    const bit = 1 << slotAt(hash, shift);
+    if ((current.bitmap & bit) === 0) return undefined;
+    current = current.children[rankOf(current.bitmap, bit)];
+    shift += BITS_PER_LEVEL;
+  }
+  return undefined;
+}
+
+/**
+ * Builds the subtree that separates two single-entry leaves whose hashes
+ * first differ at `splitAt`, hanging it under the level `fromShift` that the
+ * caller's parent branch routes at.
+ */
+function branchSeparating<V>(
+  existingHash: number,
+  existing: Leaf<V>,
+  hash: number,
+  replacement: Leaf<V>,
+  splitAt: number,
+  fromShift: number,
+): Branch<V> {
+  const existingSlot = slotAt(existingHash, splitAt);
+  const slot = slotAt(hash, splitAt);
+  let node = branchOf(
+    (1 << existingSlot) | (1 << slot),
+    existingSlot < slot ? [existing, replacement] : [replacement, existing],
+  );
+  for (
+    let shift = splitAt - BITS_PER_LEVEL;
+    shift >= fromShift;
+    shift -= BITS_PER_LEVEL
+  ) {
+    node = branchOf(1 << slotAt(hash, shift), [node]);
+  }
+  return node;
+}
+
+function setInLeaf<V>(
+  leaf: Leaf<V>,
+  hash: number,
+  key: string,
+  value: V,
+  shift: number,
+): TrieNode<V> {
+  const written: LeafEntry<V> = { hash, key, value };
+  const writtenIndex = leaf.entries.findIndex((entry) => entry.key === key);
+  if (writtenIndex !== -1) {
+    const entries = leaf.entries.slice();
+    entries[writtenIndex] = written;
+    return { kind: "leaf", entries };
+  }
+  // Leaves are never empty, so the first entry stands for the whole leaf's
+  // routing: all its entries share one hash, or they would have been split.
+  const existing = leaf.entries[0];
+  const splitAt = firstDifferingShift(existing.hash, hash, shift);
+  if (splitAt === undefined) {
+    return { kind: "leaf", entries: [...leaf.entries, written] };
+  }
+  return branchSeparating(
+    existing.hash,
+    leaf,
+    hash,
+    leafOf(written),
+    splitAt,
+    shift,
+  );
+}
+
+function setEntry<V>(
+  node: TrieNode<V> | undefined,
+  hash: number,
+  key: string,
+  value: V,
+  shift: number,
+): TrieNode<V> {
+  if (node === undefined) return leafOf({ hash, key, value });
+  if (node.kind === "leaf") return setInLeaf(node, hash, key, value, shift);
+  const bit = 1 << slotAt(hash, shift);
+  const rank = rankOf(node.bitmap, bit);
+  const children = node.children.slice();
+  if ((node.bitmap & bit) === 0) {
+    children.splice(rank, 0, leafOf({ hash, key, value }));
+    return branchOf(node.bitmap | bit, children);
+  }
+  children[rank] = setEntry(
+    children[rank],
+    hash,
+    key,
+    value,
+    shift + BITS_PER_LEVEL,
+  );
+  return branchOf(node.bitmap, children);
+}
+
+function deleteEntry<V>(
+  node: TrieNode<V> | undefined,
+  hash: number,
+  key: string,
+  shift: number,
+): TrieNode<V> | undefined {
+  if (node === undefined) return undefined;
+  if (node.kind === "leaf") {
+    const index = node.entries.findIndex((entry) => entry.key === key);
+    if (index === -1) return node;
+    if (node.entries.length === 1) return undefined;
+    const entries = node.entries.slice();
+    entries.splice(index, 1);
+    return { kind: "leaf", entries };
+  }
+  const bit = 1 << slotAt(hash, shift);
+  if ((node.bitmap & bit) === 0) return node;
+  const rank = rankOf(node.bitmap, bit);
+  const child = deleteEntry(
+    node.children[rank],
+    hash,
+    key,
+    shift + BITS_PER_LEVEL,
+  );
+  if (child === node.children[rank]) return node;
+  const children = node.children.slice();
+  if (child === undefined) {
+    children.splice(rank, 1);
+    if (children.length === 0) return undefined;
+    return branchOf(node.bitmap & ~bit, children);
+  }
+  children[rank] = child;
+  // A branch left with one leaf routes nothing: a lookup reaches the leaf by
+  // its own slot at every level below.
+  if (children.length === 1 && child.kind === "leaf") return child;
+  return branchOf(node.bitmap, children);
+}
+
+/**
+ * An immutable map from strings to values.
+ *
+ * @template V The type of the stored values.
+ * @internal
+ * @since 1.4.0
+ */
+export interface ImmutableStringMap<V> {
+  /**
+   * Retrieves the value stored under a key.
+   *
+   * @param key The key to look up.
+   * @returns The stored value, or `undefined` if the key is absent.
+   */
+  get(key: string): V | undefined;
+
+  /**
+   * Returns a map holding a value under a key.
+   *
+   * The receiver is never modified, so a map obtained earlier keeps the
+   * values it had.
+   *
+   * @param key The key to store the value under.
+   * @param value The value to store.
+   * @returns A map with the value stored.
+   */
+  set(key: string, value: V): ImmutableStringMap<V>;
+
+  /**
+   * Returns a map without a key.
+   *
+   * The receiver is never modified, so a map obtained earlier keeps the
+   * entry.
+   *
+   * @param key The key to remove.
+   * @returns A map without the key.
+   */
+  delete(key: string): ImmutableStringMap<V>;
+}
+
+class ImmutableStringMapImpl<V> implements ImmutableStringMap<V> {
+  readonly #root: TrieNode<V> | undefined;
+
+  constructor(root: TrieNode<V> | undefined) {
+    this.#root = root;
+  }
+
+  get(key: string): V | undefined {
+    return getEntry(this.#root, hashStringKey(key), key);
+  }
+
+  set(key: string, value: V): ImmutableStringMap<V> {
+    return new ImmutableStringMapImpl(
+      setEntry(this.#root, hashStringKey(key), key, value, 0),
+    );
+  }
+
+  delete(key: string): ImmutableStringMap<V> {
+    return new ImmutableStringMapImpl(
+      deleteEntry(this.#root, hashStringKey(key), key, 0),
+    );
+  }
+}
+
+/**
+ * Creates an empty immutable string-keyed map.
+ *
+ * @template V The type of the stored values.
+ * @returns An empty map.
+ * @internal
+ * @since 1.4.0
+ */
+export function createImmutableStringMap<V>(): ImmutableStringMap<V> {
+  return new ImmutableStringMapImpl(undefined);
+}
