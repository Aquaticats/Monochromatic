{
  "name": "@monochromatic-dev/pi-terminal-title",
  "description": "Terminal tab title extension for pi: shows current tool, session state, and user prompt in the terminal window title",
  "type": "module",
  "private": true,
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aquaticat/Monochromatic.git",
    "directory": "packages/pi/terminal-title"
  },
  "exports": {
    ".": {
      "types": "./dist/final/node/src/index.d.ts",
      "default": "./dist/final/node/index.mjs"
    },
    "./ts": "./src/index.ts"
  },
  "pi": {
    "extensions": ["./dist/final/node/index.mjs"]
  },
  "files": [
    "dist/final",
    "src"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "catalog:",
    "@monochromatic-dev/config-tsdown": "workspace:*",
    "@monochromatic-dev/config-typescript": "workspace:*",
    "@monochromatic-dev/module-test": "workspace:*",
    "@types/bun": "catalog:"
  }
}
