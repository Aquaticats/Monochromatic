{
  "license": "LGPL-3.0-or-later",
  "name": "@monochromatic-dev/monorepo-task-cli",
  "description": "Mise-free task CLI for CI: runs this monorepo's task graph from package/task files with node directly, covering build, test, lint, prepare, changeset and the CI-referenced package tasks.",
  "type": "module",
  "private": true,
  "module": "dist/final/node/index.mjs",
  "main": "dist/final/node/index.mjs",
  "types": "dist/final/node/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/final/node/index.d.mts",
      "default": "./dist/final/node/index.mjs"
    },
    "./ts": "./src/index.ts",
    "./ts/*": "./src/*"
  },
  "bin": {
    "task-run": "dist/final/node/run.mjs"
  },
  "devDependencies": {
    "@monochromatic-dev/config-rolldown": "workspace:*",
    "@monochromatic-dev/config-typescript": "workspace:*",
    "@monochromatic-dev/test-harness-core": "workspace:*",
    "@types/node": "catalog:"
  },
  "dependencies": {
    "string-dedent": "catalog:",
    "tiny-readdir-glob": "catalog:"
  },
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aquaticats/Monochromatic.git",
    "directory": "package/monorepo-task/cli"
  },
  "sideEffects": true,
  "files": [
    "dist/final",
    "LICENSES"
  ],
  "homepage": "https://github.com/Aquaticats/Monochromatic/tree/main/package/monorepo-task/cli"
}
