{
  "name": "bash-output-filter",
  "description": "Filters Bash output, applies a one-second foreground timeout to eligible main-agent commands, and warns when native background tasks are disabled.",
  "version": "0.0.1",
  "author": {
    "name": "Aquaticat"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bundle/node/index.mjs"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bundle/node/index.mjs"
          }
        ]
      }
    ]
  }
}
