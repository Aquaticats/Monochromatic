# syntax=docker/dockerfile:1
# Custom dev VM image based on ucore-hci (Fedora CoreOS + HCI stack).
# Pattern: https://github.com/ublue-os/image-template
#
# Layers on top of ucore-hci:
# - KDE Plasma desktop (full plasma-workspace)
# - Browser (LibreWolf) + password manager (KeePassXC)
# - Terminal (OdyTTY upstream RPM)
# - Dev tools (helix, strace, inotify-tools, etc.)
# - mise (task runner in the user's ~/.local/bin; tool versions are provisioned
#   per worktree by `mise run toolchain:install`, never seeded into the image)
# - User account with passwordless sudo

FROM ghcr.io/ublue-os/ucore-hci:stable

# Add LibreWolf RPM repo (domain changed from rpm.librewolf.net in 2026)
RUN curl -fsSLo /etc/yum.repos.d/librewolf.repo \
    https://repo.librewolf.net/librewolf.repo

# Match the user's interim desktop version. Verify the upstream release artifact
# before rpm-ostree consumes it; upgrades must update the version and checksum together.
ARG ODYTTY_VERSION=0.17.5
ARG ODYTTY_RPM_SHA256=66694895f83eee90b2b75250c4f8bc0acce84052b200344295b6df2c9472ad55
RUN curl --fail --silent --show-error --location \
      "https://github.com/ghreprimand/odytty/releases/download/v${ODYTTY_VERSION}/odytty-${ODYTTY_VERSION}-x86_64.rpm" \
      --output /var/tmp/odytty.rpm \
    && printf '%s  %s\n' "${ODYTTY_RPM_SHA256}" /var/tmp/odytty.rpm | sha256sum --check --strict

# Install all system packages in a single layer.
# rpm-ostree is used because ucore-hci is an ostree native container.
# Opt in only when the selected metalink mirror is unsuitable for this build.
# Keep Fedora's package-signature checks and release/architecture substitutions.
ARG FEDORA_DIRECT_MIRROR=false
RUN test "${FEDORA_DIRECT_MIRROR}" != true || sed --in-place \
      --expression='s|^metalink=https://mirrors.fedoraproject.org/metalink?repo=fedora-\$releasever&arch=\$basearch$|baseurl=https://download-ib01.fedoraproject.org/pub/fedora/linux/releases/$releasever/Everything/$basearch/os/|' \
      --expression='s|^metalink=https://mirrors.fedoraproject.org/metalink?repo=updates-released-f\$releasever&arch=\$basearch$|baseurl=https://download-ib01.fedoraproject.org/pub/fedora/linux/updates/$releasever/Everything/$basearch/|' \
      /etc/yum.repos.d/fedora.repo /etc/yum.repos.d/fedora-updates.repo
RUN rpm-ostree install \
      plasma-workspace \
      sddm \
      konsole \
      dolphin \
      virt-manager \
      librewolf \
      keepassxc \
      /var/tmp/odytty.rpm \
      helix \
      strace \
      inotify-tools \
      python3-devel \
      potrace \
      msitools \
    && rpm-ostree cleanup -m \
    && ostree container commit

RUN rm --force /var/tmp/odytty.rpm

# Set graphical target and enable SDDM so KDE starts on boot.
# ucore-hci defaults to multi-user.target; without this, SDDM never starts.
# Symlinks must go in /usr/lib/systemd/system/ (the immutable ostree tree),
# not /etc/systemd/system/ (which ostree three-way merges and may discard).
RUN ln -sf graphical.target /usr/lib/systemd/system/default.target \
    && mkdir -p /usr/lib/systemd/system/graphical.target.wants \
    && ln -sf ../sddm.service /usr/lib/systemd/system/graphical.target.wants/sddm.service \
    && ln -sf sddm.service /usr/lib/systemd/system/display-manager.service

# Declare btrfs as the root filesystem for bootc-image-builder.
# Without this, bootc-image-builder fails with "missing required info: DefaultRootFs"
# because Fedora CoreOS / ucore does not ship a default.
RUN mkdir -p /usr/lib/bootc/install \
    && printf '%s\n' '[install.filesystem.root]' 'type = "btrfs"' \
       > /usr/lib/bootc/install/00-ucore-dev.toml

# Create user account with wheel group and passwordless sudo
RUN useradd --create-home --groups wheel user \
    && echo "user:password" | chpasswd \
    && printf '%s\n' '%wheel ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/wheel-nopasswd \
    && chmod 0440 /etc/sudoers.d/wheel-nopasswd

# Configure SDDM auto-login for user
RUN mkdir -p /etc/sddm.conf.d \
    && printf '%s\n' '[Autologin]' 'User=user' 'Session=plasma' \
       > /etc/sddm.conf.d/autologin.conf

# Install mise as user (goes to ~/.local/bin/mise).
# It runs repository tasks (`mise run`) only; tool versions are not managed here.
# Done after useradd so the home directory exists.
USER user
RUN curl -fsSL https://mise.jdx.dev/install.sh | sh
USER root

# Bake dotfiles from package/config/dotfiles/ into the user's ~/.config/.
# Build context is the monorepo root, so paths are relative to that.
COPY --chown=user:user package/config/dotfiles/odytty/ /home/user/.config/odytty/
COPY --chown=user:user package/config/dotfiles/kdeglobals package/config/dotfiles/xdg-terminals.list /home/user/.config/
