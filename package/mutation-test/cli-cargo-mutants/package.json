{
  "license": "LGPL-3.0-or-later",
  "name": "@monochromatic-dev/mutation-test-cli-cargo-mutants",
  "description": "Product-neutral tooling for cargo-mutants campaigns: a launcher that runs one capped systemd unit per Rust file and a host-wide slot limiter for campaign containers.",
  "type": "module",
  "private": true,
  "bin": {
    "cargo-mutants-parallel": "bin/mutation-parallel.ts",
    "cargo-mutants-gate-slot": "bin/gate-slot.ts"
  },
  "exports": {
    "./ts": "./src/index.ts",
    "./ts/*": "./src/*"
  },
  "files": [
    "bin",
    "src",
    "LICENSES"
  ],
  "dependencies": {
    "@monochromatic-dev/ownership-marker-foreign-borrowed": "workspace:*",
    "@monochromatic-dev/shell-argument-core": "workspace:*"
  },
  "devDependencies": {
    "@monochromatic-dev/caught-value-core": "workspace:*",
    "@monochromatic-dev/config-typescript": "workspace:*",
    "@monochromatic-dev/test-harness-core": "workspace:*",
    "@types/node": "catalog:"
  },
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aquaticat/Monochromatic.git",
    "directory": "package/mutation-test/cli-cargo-mutants"
  },
  "sideEffects": false
}
