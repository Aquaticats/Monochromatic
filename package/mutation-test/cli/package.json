{
  "license": "LGPL-3.0-or-later",
  "name": "@monochromatic-dev/mutation-test-cli",
  "description": "Container-native mutation testing framework built on yuku: sharded disposable Podman containers with taint-aware re-runs.",
  "type": "module",
  "private": true,
  "main": "src/index.ts",
  "module": "dist/final/node/index.mjs",
  "bin": {
    "mutation-test": "dist/final/node/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/final/node/index.d.mts",
      "default": "./dist/final/node/index.mjs"
    },
    "./ts": "./src/index.ts",
    "./ts/*": "./src/*"
  },
  "files": [
    "dist/final",
    "runtime",
    "src",
    "LICENSES"
  ],
  "devDependencies": {
    "@monochromatic-dev/config-rolldown": "workspace:*",
    "@monochromatic-dev/config-typescript": "workspace:*",
    "@monochromatic-dev/fs-path-core": "workspace:*",
    "@monochromatic-dev/test-harness-core": "workspace:*",
    "@types/node": "catalog:"
  },
  "dependencies": {
    "@monochromatic-dev/logger-core": "workspace:*",
    "@monochromatic-dev/ownership-marker-foreign-borrowed": "workspace:*",
    "@monochromatic-dev/test-harness-core-matrix": "workspace:*",
    "@optique/core": "catalog:",
    "@optique/run": "catalog:",
    "nano-spawn": "catalog:",
    "p-limit": "catalog:",
    "yuku-ast": "catalog:",
    "yuku-parser": "catalog:"
  },
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aquaticat/Monochromatic.git",
    "directory": "package/mutation-test/cli"
  },
  "sideEffects": true
}
