{
  "name": "@monochromatic-dev/pi-plugin-cost-dismissal",
  "description": "Shadow-records cost dismissals found in pi sessions: assistant prose is folded for size-dismissal sentences and recorded at tool_call, tool_result and turn_end, locally and as metadata only",
  "type": "module",
  "private": true,
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aquaticat/Monochromatic.git",
    "directory": "package/pi-plugin/cost-dismissal"
  },
  "exports": {
    ".": {
      "types": "./dist/final/node/index.d.mts",
      "default": "./dist/final/node/index.mjs"
    },
    "./ts": "./src/index.ts"
  },
  "pi": {
    "extensions": [
      "./dist/final/node/index.mjs"
    ]
  },
  "files": [
    "dist/final",
    "src"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "catalog:",
    "@monochromatic-dev/config-rolldown": "workspace:*",
    "@monochromatic-dev/config-typescript": "workspace:*",
    "@monochromatic-dev/test-harness-core": "workspace:*",
    "@types/node": "catalog:",
    "type-fest": "catalog:"
  },
  "dependencies": {
    "@monochromatic-dev/logger-core": "workspace:*",
    "@monochromatic-dev/ownership-marker-foreign-borrowed": "workspace:*"
  }
}
