{
  "license": "LGPL-3.0-or-later",
  "name": "@monochromatic-dev/pi-plugin-neuralwatt",
  "description": "NeuralWatt provider for pi: serves the checked-in model listing as the baseline catalog, refreshes it from the live listing at session start, and resolves the API key from pi's credential, the encrypted env store, then the environment",
  "type": "module",
  "private": true,
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aquaticat/Monochromatic.git",
    "directory": "package/pi-plugin/neuralwatt"
  },
  "exports": {
    ".": {
      "types": "./dist/final/node/index.d.mts",
      "default": "./dist/final/node/index.mjs"
    },
    "./ts": "./src/index.ts"
  },
  "pi": {
    "extensions": ["./dist/final/node/index.mjs"]
  },
  "files": [
    "dist/final",
    "src"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "dependencies": {
    "@monochromatic-dev/agent-harness-shared-neuralwatt-listing": "workspace:*",
    "@monochromatic-dev/caught-value-core": "workspace:*",
    "@monochromatic-dev/env-local-json-core": "workspace:*",
    "@monochromatic-dev/logger-core": "workspace:*",
    "@monochromatic-dev/ownership-marker-foreign-borrowed": "workspace:*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "catalog:",
    "@earendil-works/pi-coding-agent": "catalog:",
    "@monochromatic-dev/config-rolldown": "workspace:*",
    "@monochromatic-dev/config-typescript": "workspace:*",
    "@monochromatic-dev/test-harness-core": "workspace:*",
    "@types/node": "catalog:"
  }
}
