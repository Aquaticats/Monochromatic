{
  "name": "@monochromatic-dev/search-fetch-pi-plugin",
  "description": "Exa-first search and Linkup-first fetch extension for pi with global host blocklist enforcement",
  "type": "module",
  "private": true,
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aquaticat/Monochromatic.git",
    "directory": "package/search-fetch/pi-plugin"
  },
  "exports": {
    ".": {
      "types": "./dist/final/node/index.d.mts",
      "default": "./dist/final/node/index.mjs"
    },
    "./ts": "./src/index.ts"
  },
  "pi": {
    "extensions": ["./dist/final/node/index.mjs"]
  },
  "files": [
    "dist/final",
    "src",
    "README.md"
  ],
  "keywords": [
    "pi-package",
    "pi-extension",
    "exa",
    "linkup",
    "search"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "dependencies": {
    "@monochromatic-dev/search-fetch-core": "workspace:*",
    "@monochromatic-dev/logger-core": "workspace:*",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "catalog:",
    "@earendil-works/pi-coding-agent": "catalog:",
    "@monochromatic-dev/config-rolldown": "workspace:*",
    "@monochromatic-dev/config-typescript": "workspace:*",
    "@monochromatic-dev/test-harness-core": "workspace:*",
    "@types/node": "catalog:",
    "typebox": "catalog:",
    "typescript": "catalog:"
  }
}
