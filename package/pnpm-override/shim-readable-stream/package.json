{
  "license": "LGPL-3.0-or-later",
  "name": "@monochromatic-dev/pnpm-override-shim-readable-stream",
  "description": "API-compatible shim for readable-stream@3 and readable-stream@4; re-exports node:stream so any transitive readable-stream request keeps resolving after the upstream package is overridden out via pnpm-workspace.yaml. No workspace package requests readable-stream today (its winston, winston-transport, and isomorphic-git consumers left the workspace), so the override is dormant defense in depth.",
  "private": true,
  "type": "module",
  "main": "./index.cjs",
  "types": "./index.d.cts",
  "exports": {
    ".": {
      "types": "./index.d.cts",
      "default": "./index.cjs"
    },
    "./lib/_stream_writable.js": "./lib/_stream_writable.cjs",
    "./lib/_stream_readable.js": "./lib/_stream_readable.cjs",
    "./lib/_stream_transform.js": "./lib/_stream_transform.cjs",
    "./lib/_stream_duplex.js": "./lib/_stream_duplex.cjs",
    "./lib/_stream_passthrough.js": "./lib/_stream_passthrough.cjs",
    "./package.json": "./package.json"
  },
  "files": [
    "index.cjs",
    "index.d.cts",
    "lib",
    "LICENSES"
  ],
  "devDependencies": {
    "@monochromatic-dev/config-typescript": "workspace:*",
    "@monochromatic-dev/test-harness-core": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {},
  "version": "0.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aquaticat/Monochromatic.git",
    "directory": "package/pnpm-override/shim-readable-stream"
  }
}
