  "name": "@monochromatic-dev/pnpm-override-shim-node-domexception",
  "description": "API-compatible shim for node-domexception; re-exports globalThis.DOMException so consumers (fetch-blob, node-fetch) keep working after the deprecated upstream is overridden out via pnpm-workspace.yaml.",
  "private": false,
  "type": "commonjs",
  "main": "./index.cjs",
  "types": "./index.d.cts",
  "exports": {
    ".": {
      "types": "./index.d.cts",
      "default": "./index.cjs"
    }
  },
  "files": [
    "index.cjs",
    "index.d.cts",
    "LICENSES"
  ],
  "devDependencies": {
    "@monochromatic-dev/config-typescript": "workspace:*",
    "typescript": "catalog:"
  },
  "dependencies": {},
  "version": "0.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aquaticat/Monochromatic.git",
    "directory": "package/pnpm-override/shim-node-domexception"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
