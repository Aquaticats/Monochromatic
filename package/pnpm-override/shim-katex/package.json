  "name": "@monochromatic-dev/pnpm-override-shim-katex",
  "description": "Throwing shim for katex; keeps micromark-extension-math's lib/html.js importable after katex is overridden out via pnpm-workspace.yaml for GHSA-238p-pmpm-9mq7. Every member throws and nothing renders.",
  "private": true,
  "type": "module",
  "main": "./index.cjs",
  "types": "./index.d.cts",
