    ".": {
      "types": "./index.d.cts",
      "default": "./index.cjs"
    }
  },
  "files": [
    "index.cjs",
    "index.d.cts",
    "LICENSES"
  ],
  "devDependencies": {
    "@monochromatic-dev/config-typescript": "workspace:*",
    "@monochromatic-dev/test-harness-core": "workspace:*",
    "@types/node": "catalog:",
    "remark-math": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {},
  "version": "0.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aquaticat/Monochromatic.git",
    "directory": "package/pnpm-override/shim-katex"
  }
