# Private pnpr registry image (doc/decision/private-npm-registry.md).
#
# Base: pnpr 0.1.0-alpha.16 patched so GitHub Actions OIDC workload publishes work
# (doc/troubleshooting/pnpr-oidc-github-actions-discovery.md). Built and published by
# .github/workflows/pnpr-patched-image.yml on branch pnpr-oidc-workload-discovery of Aquaticat/pnpm
# from upstream's pnpr/docker/Dockerfile: Debian slim, ca-certificates, a static musl pnpr,
# user pnpr, WORKDIR /pnpr, and /pnpr/storage owned by pnpr.
# Pinned by OCI index digest so Coolify rebuilds start from the same layers.
# Refresh after a new fork run: the run's "pnpr image" notice prints tag@digest.
# This base gates the deploy: run `pnpr upgrade-storage` on the volume first (it aborts startup
# on an unmarked store) and serve npm under /npm (doc/troubleshooting/pnpr-base-move.md).
FROM ghcr.io/aquaticat/pnpr:0.1.0-alpha.16-oidc-workload-discovery.01dc1384276b@sha256:09a9818eaebba777848f3d01382c97143e232d95085ea4950408ad436505109c

# Generated by @monochromatic-dev/config-pnpr; baked in so a Coolify redeploy is the only way config changes.
COPY config.yaml /pnpr/config.yaml

EXPOSE 7677

ENTRYPOINT ["pnpr"]
# --disable-resolver: the install accelerator fetches upstream indexes for clients,
# and this registry deliberately proxies nothing.
CMD ["--config", "/pnpr/config.yaml", "--listen", "0.0.0.0:7677", "--storage", "/pnpr/storage", "--disable-resolver"]
