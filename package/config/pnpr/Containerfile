# Private pnpr registry image (doc/decision/private-npm-registry.md).
#
# Upstream 0.1.0-alpha.17 includes the GitHub Actions OIDC discovery fix.
# Pin the OCI index digest so Coolify rebuilds use the verified release artifacts.
# This release requires an empty store; compose.yaml selects a fresh volume and
# retains the alpha.16 volume for rollback. Never run the removed upgrade-storage command.
# Upgrade evidence: doc/planning/pnpr-alpha17-upgrade.md.
FROM ghcr.io/pnpm/pnpr:0.1.0-alpha.17@sha256:884ba0cd30b81428247f46e2d1e818fe3fbccfd54e38a13600e5ffb0a5198f4e

# Generated by @monochromatic-dev/config-pnpr; baked in so a Coolify redeploy is the only way config changes.
COPY config.yaml /pnpr/config.yaml

EXPOSE 7677

ENTRYPOINT ["pnpr"]
# --disable-resolver: the install accelerator fetches upstream indexes for clients,
# and this registry deliberately proxies nothing.
CMD ["--config", "/pnpr/config.yaml", "--listen", "0.0.0.0:7677", "--storage", "/pnpr/storage", "--disable-resolver"]
