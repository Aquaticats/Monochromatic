{
  "include": [
    "${configDir}/src/**/*.ts",
    "${configDir}/src/**/*.astro",
    "${configDir}/src/**/*.mdx",
    "${configDir}/*.config.ts",
    "${configDir}/.astro/types.d.ts"
  ],
  "exclude": [
    // Every entry spells out ${configDir}: TypeScript resolves a bare relative
    // path against the file that declares it, so an unprefixed entry would
    // filter this package's own directories in every consumer.
    "${configDir}/dist",
    "${configDir}/bak",
    "${configDir}/node_modules",
    "${configDir}/**/deprecated/**",
    // tsgo's LSP panics on files with unrecognized extensions
    // during project loading. See doc/troubleshooting/typescript.md
    // "tsgo LSP panics on non-source files".
    "${configDir}/**/*.svg",
    "${configDir}/**/*.png",
    "${configDir}/**/*.jpg",
    "${configDir}/**/*.jpeg",
    "${configDir}/**/*.gif",
    "${configDir}/**/*.webp",
    "${configDir}/**/*.ico",
    "${configDir}/**/*.woff",
    "${configDir}/**/*.woff2",
    "${configDir}/**/*.ttf",
    "${configDir}/**/*.eot",
    "${configDir}/**/*.mp3",
    "${configDir}/**/*.mp4",
    "${configDir}/**/*.webm",
    "${configDir}/**/*.pdf"
  ],
  "compilerOptions": {
    "rootDirs": [
      "${configDir}/src",
      "${configDir}"
    ],
    "paths": {
      "@/*": ["${configDir}/*"],
      "@_/*": ["${configDir}/src/*"]
    },
    "outDir": "${configDir}/dist/final/types",
    // Incremental build state lives outside dist/final so it never ships in a
    // package tarball (issue #336); task-util/tsc-filter.ts cleans this path.
    "tsBuildInfoFile": "${configDir}/.cache/typescript/tsconfig.tsbuildinfo",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noPropertyAccessFromIndexSignature": false,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": false,
    "noUnusedParameters": true,
    "noUncheckedSideEffectImports": true,
    "preserveWatchOutput": true,

    //region Modules

    "allowImportingTsExtensions": true,

    /* To work around the fact that some dependent packages export type declaration files with relative path but without extensions.
    For example, execa */
    "module": "preserve",
    "moduleResolution": "bundler",

    "resolveJsonModule": true,
    "types": [
      "node"
    ],

    //endregion

    //region Emit

    // error TS5096: Option 'allowImportingTsExtensions' can only be used when either 'noEmit' or 'emitDeclarationOnly' is set.
    // "emitDeclarationOnly": true,
    "noEmit": true,

    "declaration": true,
    "isolatedDeclarations": true,
    "newLine": "lf",

    // Sometimes we're importing types in a test file, which needs tsc to emit the types before the errors disappear.
    // Setting this to true will cause a deadlock.
    "noEmitOnError": false,

    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,

    "preserveConstEnums": true,
    "allowJs": false,
    "checkJs": false,

    //endregion

    //region Editor Support

    "disableSizeLimit": true,

    //endregion

    //region Interop Constraints

    "esModuleInterop": true,

    // error TS5104: Option 'isolatedModules' is redundant and cannot be specified with option 'verbatimModuleSyntax'.
    // "isolatedModules": true,

    //endregion

    //region Language and Environment

    "jsx": "preserve",
    "jsxImportSource": "vue",

    "lib": ["ESNext"],

    "libReplacement": false,

    "target": "esnext",

    //endregion

    //region Compiler Diagnostics

    // Too much noise. Enable on demand.
    // "explainFiles": true,

    "listEmittedFiles": true,

    // Too much noise. Enable on demand.
    // "listFiles": true,

    // Too much noise. Enable on demand.
    // "traceResolution": true,

    //endregion

    //region Projects

    "composite": true,

    //endregion

    //region Output Formatting

    "noErrorTruncation": true,

    //endregion

    //region Completeness

    "skipLibCheck": true,

    //endregion

    //region Command Line

    //endregion

    //region Watch Options

    "assumeChangesOnlyAffectDirectDependencies": true
    //endregion

    //region Type Acquisition

    //endregion
  },
  "$schema": "https://json.schemastore.org/tsconfig"
}
