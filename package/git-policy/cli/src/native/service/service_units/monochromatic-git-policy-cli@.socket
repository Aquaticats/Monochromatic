# Written by the git wrapper for its commit service (monochromatic-git-policy-cli-unit); the wrapper rewrites this file when it changes.
# One instance per worktree: the instance name is a hash of the worktree's own Git directory (service_instance.rs).
[Unit]
Description=Commit service socket of one worktree for the git wrapper

[Socket]
# The wrapper looks for the socket at the same place under the user's runtime directory (service_instance.rs); a runtime
# directory too long for one socket address is listened at under an abstract name instead, and the line below is written
# in one form or the other before this file is put here (service_address_of_a_worktree.rs).
ListenStream=@LISTEN_STREAM@
SocketMode=0600
DirectoryMode=0700
