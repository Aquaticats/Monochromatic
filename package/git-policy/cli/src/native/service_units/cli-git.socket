# Written by the git wrapper for its commit service (cli-git-unit); the wrapper rewrites this file when it changes.
[Unit]
Description=Commit service socket for the git wrapper

[Socket]
# The wrapper looks for the socket at the same place under the user's runtime directory (service_commit.rs).
ListenStream=%t/cli-git/service.sock
SocketMode=0600
DirectoryMode=0700
