// Transient combined search. Native code owns query generations and native-path result identities.
import { Surface } from "surface.slint";
import { ScrollView, Palette } from "std-widgets.slint";
import { QueryInput } from "query-input.slint";

export struct SearchEntry {
    path: string,
    detail: string,
    preview: string,
}

export component ProjectSearch inherits Rectangle {
    in property <[SearchEntry]> entries;
    in property <string> scope-label;
    in property <string> error-message;
    in property <bool> busy;
    in-out property <string> query;
    in-out property <int> selected-row: -1;
    // Ink for text and marks on a selected row. The owner passes the ink native code chooses from the
    // selection fill; the palette's own selection ink, the fallback here, is black in the dark scheme.
    in property <brush> selected-ink: Palette.selection-foreground;
    callback edited(string);
    callback choose(int);
    callback dismiss;
    background: Surface.background;
    border-width: 1px;
    border-color: Palette.foreground;
    accessible-role: search;
    accessible-label: "Search files and contents";
    forward-focus: input;
    public function focus-query() { input.focus(); }
    public function reset-scroll() { results.content-y = 0px; }
    // The clear control of the query: whether it is shown, and its layout cell in window coordinates.
    out property <bool> clear-shown: input.clear-shown;
    out property <length> clear-x: input.clear-x;
    out property <length> clear-y: input.clear-y;
    out property <length> clear-width: input.clear-width;
    out property <length> clear-height: input.clear-height;
    private property <length> row-height: 64px;
    // The query box's description for assistive tools, worded like the find box's match count: empty without a
    // query, "Searching" while results are pending, the error when there is one, "No results", "Result 2 of 5"
    // for the selected row, and "5 results, none selected" without one.
    private property <string> result-detail: root.query == "" ? ""
        : root.busy ? "Searching"
        : root.error-message != "" ? root.error-message
        : root.entries.length == 0 ? "No results"
        : root.selected-row >= 0 && root.selected-row < root.entries.length ? "Result \{root.selected-row + 1} of \{root.entries.length}"
        : root.entries.length == 1 ? "1 result, none selected" : "\{root.entries.length} results, none selected";

    function move-selection(delta: int) {
        if root.entries.length == 0 { return; }
        root.selected-row = mod(root.selected-row + delta + root.entries.length, root.entries.length);
        if results.content-y + root.selected-row * root.row-height < 0px {
            results.content-y = -root.selected-row * root.row-height;
        } else if results.content-y + (root.selected-row + 1) * root.row-height > results.visible-height {
            results.content-y = results.visible-height - (root.selected-row + 1) * root.row-height;
        }
    }

    // Consume clicks in panel padding instead of forwarding them to the outside-dismiss layer.
    TouchArea { width: parent.width; height: parent.height; }

    // Capture result-navigation keys before the query input consumes them.
    FocusScope {
        width: parent.width;
        height: parent.height;
        // Only the query input holds focus; this scope observes its keys. As a focus owner it would take
        // keyboard focus from the input on a click in the panel's padding.
        focus-on-tab-navigation: false;
        focus-on-click: false;
        capture-key-pressed(event) => {
            if event.text == Key.Escape { root.dismiss(); return accept; }
            if event.text == Key.Tab { return accept; }
            if event.text == Key.DownArrow { root.move-selection(1); return accept; }
            if event.text == Key.UpArrow { root.move-selection(-1); return accept; }
            if event.text == Key.Return { root.choose(root.selected-row); return accept; }
            reject
        }
        VerticalLayout {
            padding: 12px;
            spacing: 8px;
            Text {
                height: 28px;
                text: "Search · " + root.scope-label;
                color: Palette.foreground;
                font-weight: 600;
                overflow: elide;
                vertical-alignment: center;
            }
            input := QueryInput {
                max-height: 48px;
                text <=> root.query;
                placeholder-text: "Files and contents · % for contents only";
                clear-label: "Clear search query";
                selected-ink: root.selected-ink;
                accessible-description: root.result-detail;
                accessible-label: "Search query";
                edited(text) => { root.edited(text); }
            }
            if root.busy || (root.query != "" && root.entries.length == 0 && root.error-message == ""): Text {
                text: root.busy ? "Searching…" : "No results";
                color: Palette.foreground;
                font-weight: 600;
            }
            if root.error-message != "": ScrollView {
                max-height: 96px;
                content-width: self.visible-width;
                Text {
                    width: parent.visible-width;
                    text: root.error-message;
                    color: Palette.foreground;
                    font-weight: 600;
                    wrap: word-wrap;
                }
            }
            results := ScrollView {
                vertical-stretch: 1;
                content-width: self.visible-width;
                content-height: max(self.visible-height, root.entries.length * root.row-height);
                accessible-role: list;
                accessible-label: "Search results";
                accessible-item-count: root.entries.length;
                // At most 50 rows exist. No virtual row can redirect a held click to a newly bound item.
                for entry[index] in root.entries: Rectangle {
                    y: index * root.row-height;
                    width: max(48px, results.visible-width);
                    height: root.row-height;
                    private property <bool> selected: index == root.selected-row;
                    background: selected ? Palette.selection-background : transparent;
                    border-width: selected ? 1px : 0px;
                    border-color: Palette.foreground;
                    accessible-role: list-item;
                    accessible-label: entry.path;
                    accessible-description: entry.detail + " " + entry.preview;
                    accessible-item-selected: selected;
                    accessible-item-selectable: true;
                    accessible-item-index: index;
                    accessible-action-default => { root.choose(index); }
                    Text {
                        x: 8px;
                        y: 6px;
                        width: parent.width - 16px;
                        height: 24px;
                        text: entry.path;
                        color: parent.selected ? root.selected-ink : Palette.foreground;
                        font-weight: parent.selected ? 600 : 400;
                        overflow: elide;
                        // The row carries its path and detail as name and description; its texts are not read again.
                        accessible-role: none;
                    }
                    Text {
                        x: 8px;
                        y: 32px;
                        width: parent.width - 16px;
                        height: 24px;
                        text: entry.detail + (entry.preview == "" ? "" : " · " + entry.preview);
                        color: parent.selected ? root.selected-ink : Palette.foreground;
                        overflow: elide;
                        accessible-role: none;
                    }
                    TouchArea {
                        width: parent.width;
                        height: parent.height;
                        // A new result model recreates these repeated items and cancels their pending clicks.
                        clicked => { root.choose(index); }
                    }
                }
            }
        }
    }
}
