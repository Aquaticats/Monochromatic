# Build environment for the `nested-wayland-session` compositor.
# The host is an immutable-style Fedora without the dev headers Smithay's build
# links against, so all cargo work happens inside this container (see mise.toml).
# The base is CachyOS, unpinned (doc/decision/container-base-distro.md); CACHYOS_IMAGE lets the caller pick the
# x86-64-v3 or x86-64-v4 build of CachyOS that the host CPU supports.
# This image is BUILD-ONLY: the resulting binary runs on the HOST Wayland session
# (it is itself a nested winit client of the host compositor and needs the host
# GPU), so the image carries no GUI/GL runtime, only the build toolchain and the
# development libraries the crate graph links at build time.
ARG CACHYOS_IMAGE=docker.io/cachyos/cachyos:latest
FROM ${CACHYOS_IMAGE}

# Build toolchain + link-time development libraries (Arch ships headers in the main package, so there are no -devel names):
#   gcc                    cc for the -sys crates' small C shims
#   pkgconf                pkg-config, used by wayland-sys / drm-sys to locate libs
#   clang                  libclang for any bindgen in the drm-sys / wayland-sys graph
#   wayland                libwayland-server, linked by wayland-backend's
#                          server_system backend (smithay's `use_system_lib`, which
#                          enables the EGL bind_wl_display / wl_drm accel path)
#   libxkbcommon           the `xkbcommon` crate links libxkbcommon at build time
#                          (it is NOT dlopened, unlike winit's wayland-client), so
#                          the header + .so must be present to link
#   libdrm                 drm-ffi / drm-sys (Smithay `backend_drm`) need libdrm to
#                          resolve the render node for dmabuf v4 feedback
#   libglvnd               EGL headers, defensive: renderer_gl dlopens libEGL at
#                          runtime, but this keeps any build-time probe satisfied
#   dbus                   dbus-daemon, the private session bus used by --color-scheme integration tests
# libEGL / libGLESv2 / libwayland-client themselves are dlopened by the binary at
# RUNTIME on the host, so they are not part of this build image.
RUN pacman --sync --refresh --sysupgrade --noconfirm --needed \
      gcc \
      pkgconf \
      clang \
      wayland \
      libxkbcommon \
      libdrm \
      libglvnd \
      dbus \
    && rm --recursive --force /var/cache/pacman/pkg/*

# Rust toolchain via rustup, not the distro `rust` package, matching the
# sibling desktop-app images and giving the exact nightly that toolchain.lock.json pins. RUSTUP_HOME persists in the image; the install uses a
# throwaway CARGO_HOME=/usr/local so the cargo/rustc/clippy proxy shims land on the
# already-persistent PATH, while the real CARGO_HOME is the /cargo named volume set
# below (mounted at run time, holding only the registry/git cache).
# The toolchain is the nightly toolchain.lock.json pins (`.tools.rust.version`); the build context is this
# package directory, so this default is kept in sync with that key, and `--build-arg RUST_TOOLCHAIN=` overrides it.
ARG RUST_TOOLCHAIN=nightly-2026-10-29
ENV RUSTUP_HOME=/rustup
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
      | env CARGO_HOME=/usr/local sh -s -- -y --no-modify-path --profile minimal \
          --default-toolchain "${RUST_TOOLCHAIN}" --component clippy

# cargo-nextest is the test runner the `test` mise task invokes. Install the
# prebuilt binary from get.nexte.st into /usr/local/bin (on PATH, persistent)
# rather than `cargo install cargo-nextest`, which would add a multi-minute source
# compile to every image rebuild. Arch-aware: get.nexte.st serves separate x86_64
# and aarch64 builds.
RUN arch="$(uname -m)" \
    && case "$arch" in \
      x86_64) nextest_url="https://get.nexte.st/latest/linux" ;; \
      aarch64) nextest_url="https://get.nexte.st/latest/linux-arm" ;; \
      *) echo "unsupported architecture: $arch" >&2; exit 1 ;; \
    esac \
    && curl --proto '=https' --tlsv1.2 --location --silent --show-error --fail "$nextest_url" \
      | tar zxf - -C /usr/local/bin

ENV CARGO_HOME=/cargo
WORKDIR /work
