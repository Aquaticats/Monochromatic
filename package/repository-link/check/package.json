{
  "license": "LGPL-3.0-or-later",
  "name": "@monochromatic-dev/repository-link-check",
  "description": "The shared check that tells a tool whether the repository link to the 860 drive is usable, with the bins that run it, run a command after it, and record the identity it enforces.",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "module": "dist/final/node/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/final/node/index.d.mts",
      "default": "./dist/final/node/index.mjs"
    },
    "./ts": "./src/index.ts",
    "./ts/*": "./src/*"
  },
  "bin": {
    "repository-link-check": "dist/final/node/check.mjs",
    "repository-link-run": "dist/final/node/run.mjs",
    "repository-link-record": "dist/final/node/record.mjs",
    "repository-link-launch": "dist/final/node/launch.mjs"
  },
  "devDependencies": {
    "@monochromatic-dev/config-rolldown": "workspace:*",
    "@monochromatic-dev/config-typescript": "workspace:*",
    "@monochromatic-dev/test-harness-core": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "files": [
    "dist/final",
    "src",
    "LICENSES",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Aquaticats/Monochromatic.git",
    "directory": "package/repository-link/check"
  },
  "homepage": "https://github.com/Aquaticats/Monochromatic/tree/main/package/repository-link/check"
}
