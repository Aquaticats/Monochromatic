{
  "license": "LGPL-3.0-or-later",
  "name": "@monochromatic-dev/wg-cli-quicker",
  "description": "CLI that brings a WireGuard interface up and down like wg-quick, but parses the config in TypeScript so a very large AllowedIPs value cannot hang startup.",
  "type": "module",
  "private": true,
  "main": "src/tunnel.ts",
  "module": "dist/final/node/tunnel.mjs",
  "bin": {
    "wg-quicker": "dist/final/node/index.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/final/node/tunnel.d.mts",
      "default": "./dist/final/node/tunnel.mjs"
    },
    "./ts": "./src/tunnel.ts",
    "./ts/*": "./src/*"
  },
  "files": [
    "dist/final",
    "LICENSES"
  ],
  "devDependencies": {
    "@monochromatic-dev/config-rolldown": "workspace:*",
    "@monochromatic-dev/config-typescript": "workspace:*",
    "@monochromatic-dev/test-harness-core": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@monochromatic-dev/async-time-core": "workspace:*",
    "@monochromatic-dev/logger-core": "workspace:*",
    "@monochromatic-dev/wg-core-allowedips": "workspace:*",
    "@monochromatic-dev/or-throw-core": "workspace:*",
    "string-dedent": "catalog:"
  },
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aquaticat/Monochromatic.git",
    "directory": "package/wg/cli-quicker"
  },
  "sideEffects": true
}
