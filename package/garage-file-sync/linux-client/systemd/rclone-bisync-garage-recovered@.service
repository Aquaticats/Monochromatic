[Unit]
Description=Desktop notice that a failing Garage sync unit recovered
Documentation=file://%h/Monochromatic/package/garage-file-sync/linux-client/README.md
# Template, started by OnSuccess=rclone-bisync-garage-recovered@%n.service (drop-in
# 60-alert-on-failure.conf of the sync unit, and the trigger unit); the instance is the
# unit whose run ended cleanly. With no open alert streak the entry exits without a
# notice, so this runs after every five-minute sync for almost nothing. OnSuccess= also
# fires for a run stopped by hand, which the entry tells apart from exit status 0 through
# MONITOR_EXIT_CODE and MONITOR_EXIT_STATUS. It is a separate template from
# rclone-bisync-garage-alert@.service because systemd 262 passes no MONITOR_* variables to
# a handler one unit names in both OnFailure= and OnSuccess= (measured, 2026-11-25).
# The handler calls notify-send, which needs the graphical session's notification server,
# so a recovery while logged out is not shown; the streak stays open, and the next clean
# run tries the notice again.

[Service]
Type=oneshot
# `/usr/bin/env node` follows the user manager's PATH, which ~/.config/environment.d/ can
# extend, and node runs the TypeScript entry straight from this checkout the way
# claude-cpu-watch.service runs its own source. The entry writes its per-unit alert
# streak under ~/.local/state/rclone-bisync-garage-alert/, so it has to be the same file
# the repository holds, never a copy.
ExecStart=/usr/bin/env node %h/Monochromatic/package/garage-file-sync/linux-client/src/alert.ts %i --trigger=unit-succeeded
# notify-send waits up to 25 s for a reply from the notification server (GLib default);
# the entry gives journalctl and notify-send 30 s each.
TimeoutStartSec=90
