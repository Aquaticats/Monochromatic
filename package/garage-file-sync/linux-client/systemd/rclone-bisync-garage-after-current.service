[Unit]
Description=Start a Garage bisync run after the one that is running now
# Ordered after the sync unit, with no Requires= or Wants=: when nothing is running,
# the trigger starts at once; when a run is active, its start waits for that run to
# end and then starts one more. systemd merges every request that lands during a run
# into one pending job (measured), so a burst of changes during a run gives exactly
# one follow-up run.
After=rclone-bisync-garage.service
# A failed step (the sync unit missing or refused) means a change was never synced
# until the next timer run, so it raises the same desktop alert as a failed sync.
OnFailure=rclone-bisync-garage-alert@%n.service
# Its next successful run closes that alert streak with one recovery notice; with no
# streak open the handler exits without a notice.
OnSuccess=rclone-bisync-garage-recovered@%n.service

[Service]
# One step, and --no-block so the trigger and the watcher's hook return at once
# instead of waiting for a run that can take up to 100 minutes.
# No RemainAfterExit=: the unit must return to inactive, so the next request starts
# it again instead of joining a finished run.
Type=oneshot
ExecStart=/usr/bin/systemctl --user start --no-block rclone-bisync-garage.service
