{
  "name": "@monochromatic-dev/dsh-plugin-advisor",
  "description": "In-process DSH Advisor plugin: consults scoped reviewer models through ctx.llm with the unified pi-advisor.json config, the advisor tool, and /advisor command parity",
  "type": "module",
  "private": true,
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aquaticat/Monochromatic.git",
    "directory": "package/dsh-plugin/advisor"
  },
  "exports": {
    ".": {
      "types": "./dist/final/node/index.d.mts",
      "default": "./dist/final/node/index.mjs"
    },
    "./ts": "./src/index.ts",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "dist/final",
    "src",
    "cordis.patch.yml",
    "locale/en.json",
    "icon.svg",
    "README.md"
  ],
  "sideEffects": false,
  "keywords": [
    "dsh-bundle",
    "dsh-plugin",
    "advisor",
    "code-review"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@monochromatic-dev/agent-harness-shared-advisor": "workspace:*",
    "@monochromatic-dev/agent-harness-shared-model-selection": "workspace:*",
    "@monochromatic-dev/module-caught-value": "workspace:*",
    "@monochromatic-dev/module-logger": "workspace:*",
    "@monochromatic-dev/ownership-marker-foreign-borrowed": "workspace:*"
  },
