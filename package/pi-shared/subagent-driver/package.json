{
  "license": "LGPL-3.0-or-later",
  "name": "@monochromatic-dev/pi-shared-subagent-driver",
  "description": "Runs one Pi agent unattended over RPC: sends the prompt, declines dialogs, enforces its limits, records a feed and a summary, and delivers steering messages from an inbox folder. Two more commands watch the runs folder for a run that should have come back, and describe one that has not.",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "module": "dist/final/node/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/final/node/index.d.mts",
      "default": "./dist/final/node/index.mjs"
    },
    "./ts": "./src/index.ts",
    "./ts/*": "./src/*"
  },
  "bin": {
    "drive-pi-subagent": "dist/final/node/drive-pi-subagent.mjs",
    "watch-overdue-pi-runs": "dist/final/node/watch-overdue-pi-runs.mjs",
    "check-in-on-pi-runs": "dist/final/node/check-in-on-pi-runs.mjs",
    "start-pi-run-in-a-free-slot": "dist/final/node/start-pi-run-in-a-free-slot.mjs",
    "retry-start-pi-run-until-a-slot-frees": "dist/final/node/retry-start-pi-run-until-a-slot-frees.mjs",
    "start-a-batch-of-pi-runs": "dist/final/node/start-a-batch-of-pi-runs.mjs",
    "latest-pi-run-reports": "dist/final/node/latest-pi-run-reports.mjs",
    "send-note-to-running-pi-runs": "dist/final/node/send-note-to-running-pi-runs.mjs",
    "stop-pi-runs-not-on-the-wrapper": "dist/final/node/stop-pi-runs-not-on-the-wrapper.mjs",
    "start-kimi-reviews": "dist/final/node/start-kimi-reviews.mjs",
    "list-recent-pi-run-ends": "dist/final/node/list-recent-pi-run-ends.mjs"
  },
  "devDependencies": {
    "@monochromatic-dev/config-rolldown": "workspace:*",
    "@monochromatic-dev/config-typescript": "workspace:*",
    "@monochromatic-dev/test-harness-core": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "files": [
    "dist/final",
    "src",
    "LICENSES",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Aquaticat/Monochromatic.git",
    "directory": "package/pi-shared/subagent-driver"
  },
  "dependencies": {
    "@monochromatic-dev/caught-value-core": "workspace:*"
  }
}
