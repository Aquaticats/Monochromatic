{
  "$schema": "../../../node_modules/oxlint/configuration_schema.json",
  // Dedicated config for fixture linting: all no-restricted-syntax rules enabled,
  // no ignorePatterns that would skip invalid/ or test-fixture/ paths.
  // Used by the lint-fixture mise task and the oxlint-no-restricted-syntax unit tests.
  "jsPlugins": [
    "../../oxlint-plugin/no-restricted-syntax/dist/final/node/index.mjs"
  ],
  "ignorePatterns": [
    "**/dist",
    "**/node_modules"
  ],
