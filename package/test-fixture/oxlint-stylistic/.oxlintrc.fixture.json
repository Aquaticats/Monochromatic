{
  "$schema": "../../../node_modules/oxlint/configuration_schema.json",
  // Dedicated config for fixture linting: all stylistic rules enabled,
  // no ignorePatterns that would skip invalid/ or test-fixture/ paths.
  // Used by the lint-fixture mise task and the oxlint-stylistic unit tests.
  "jsPlugins": [
    "../../oxlint-plugin/stylistic/dist/final/node/index.mjs"
  ],
  "ignorePatterns": [
    "**/dist",
    "**/node_modules"
  ],
  "rules": {
    "stylistic/indentation": "error",
    "stylistic/require-asterisk-prefix": [
      "error",
      "never"
    ],
    "stylistic/param-per-line": "error",
    "stylistic/argument-per-line": "error",
    "stylistic/array-element-per-line": "error",
    "stylistic/object-property-per-line": "error",
    "stylistic/import-per-line": "error",
    "stylistic/export-per-line": "error",
    "stylistic/type-property-per-line": "error",
    "stylistic/tuple-per-line": "error",
    "stylistic/destructure-per-line": "error",
    "stylistic/block-body-newline": "error",
    "stylistic/one-var-declaration-per-line": "error",
    "stylistic/max-statements-per-line": "error",
    "stylistic/semi": "error",
    "stylistic/comma-dangle": "error",
    "stylistic/no-mixed-operators": "error",
    "stylistic/chain-per-line": "error",
    "stylistic/invocation-depth-per-line": "error"
  }
}
