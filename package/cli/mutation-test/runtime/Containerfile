FROM fedora:latest

ENV MISE_DATA_DIR=/mise
ENV MISE_CONFIG_DIR=/mise
ENV MISE_CACHE_DIR=/mise/cache
ENV PATH=/usr/local/bin:/baked/node_modules/.bin:$PATH

RUN dnf install --assumeyes dnf-plugins-core ca-certificates curl git libatomic procps-ng rsync which \
  && dnf copr enable --assumeyes jdxcode/mise \
  && dnf install --assumeyes mise \
  && dnf clean all \
  && rm --recursive --force /var/cache/dnf

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

WORKDIR /baked
COPY . /baked

# The baked mise.toml sets npm.package_manager = "pnpm", so once trusted, mise
# would install npm:pnpm by running `pnpm add --global pnpm` -- but pnpm does not
# exist yet in a fresh container, so that bootstrap fails with ENOENT. Force npm
# (bundled with node) as the package manager for this install step only; pnpm is
# used directly for the frozen-lockfile install once it exists.
# Node and pnpm versions resolve from the baked mise.toml/mise.lock until the
# cutover. `toolchain.lock.json` (repository root) is the source of truth for every
# tool version (doc/decision/mpm-toolchain-adoption.md): `tools.node` and
# `tools.pnpm` record the archived artifacts this step fetches and verifies in
# place of `mise install` once the lock lands.
RUN export MISE_NPM_PACKAGE_MANAGER=npm \
  && mise trust /baked/mise.toml \
  && mise install --yes node npm:pnpm \
  && ln --symbolic --force "$(mise exec node -- which node)" /usr/local/bin/node \
  && ln --symbolic --force "$(mise exec node -- which npm)" /usr/local/bin/npm \
  && ln --symbolic --force "$(mise exec node npm:pnpm -- which pnpm)" /usr/local/bin/pnpm \
  && mise exec node npm:pnpm -- pnpm install --frozen-lockfile

CMD ["node", "--version"]
