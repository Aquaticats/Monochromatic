# XML tokens that matter to this parser. libFuzzer splices these into inputs, which reaches
# comment, CDATA, reference and quote boundaries far faster than byte-only mutation.
tag_open="<"
tag_close=">"
end_tag_open="</"
empty_tag_close="/>"
comment_open="<!--"
comment_close="-->"
comment_double_dash="--"
cdata_open="<![CDATA["
cdata_close="]]>"
pi_open="<?"
pi_close="?>"
declaration="<?xml version=\"1.0\" encoding=\"UTF-8\"?>"
doctype="<!DOCTYPE"
double_quote="\""
single_quote="'"
equals="="
ampersand="&"
entity_amp="&amp;"
entity_lt="&lt;"
entity_quot="&quot;"
entity_apos="&apos;"
reference_decimal="&#10;"
reference_hex="&#x41;"
reference_bad="&#0;"
reference_unknown="&foo;"
bom="\xEF\xBB\xBF"
carriage_return="\x0D"
line_feed="\x0A"
tab="\x09"
control="\x01"
