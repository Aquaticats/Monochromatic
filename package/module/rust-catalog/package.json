{
  "license": "LGPL-3.0-or-later",
  "name": "@monochromatic-dev/module-rust-catalog",
  "description": "Parsing and validation of rust-catalog.toml, the pnpm-style Rust dependency catalog.",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "module": "dist/final/node/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/final/node/index.d.mts",
      "default": "./dist/final/node/index.mjs"
    },
    "./ts": "./src/index.ts",
    "./ts/*": "./src/*"
  },
  "files": [
    "dist/final",
    "src",
    "LICENSES"
  ],
  "dependencies": {
    "@monochromatic-dev/module-logger": "workspace:*",
    "@monochromatic-dev/module-toml-edit": "workspace:*"
  },
  "devDependencies": {
    "@monochromatic-dev/config-rolldown": "workspace:*",
    "@monochromatic-dev/config-typescript": "workspace:*",
    "@monochromatic-dev/module-test": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Aquaticat/Monochromatic.git",
    "directory": "package/module/rust-catalog"
  }
}
