{
  "license": "LGPL-3.0-or-later",
  "name": "@monochromatic-dev/logger-core",
  "description": "Zero-config multi-sink logger with tagged composition. Auto-discovers console, sessionStorage, and localStorage backends at import time, plus the file backend under Node and IndexedDB in browsers, with no dynamic imports in either build.",
  "type": "module",
  "sideEffects": false,
  "module": "dist/final/neutral/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/final/neutral/index.d.mts",
      "node": "./dist/final/node/index.mjs",
      "default": "./dist/final/neutral/index.mjs"
    },
    "./node": {
      "types": "./dist/final/node/node.d.mts",
      "default": "./dist/final/node/node.mjs"
    },
    "./browser": {
      "types": "./dist/final/neutral/browser.d.mts",
      "default": "./dist/final/neutral/browser.mjs"
    },
    "./ts": "./src/index.ts",
    "./ts/*": "./src/*"
  },
  "imports": {
    "#default-sinks": {
      "node": "./src/default-sinks.node.ts",
      "default": "./src/default-sinks.neutral.ts"
    }
  },
  "files": [
    "dist/final",
    "src",
    "doc/file-destinations.md",
    "LICENSES",
    "CHANGELOG.md"
  ],
  "devDependencies": {
    "@monochromatic-dev/config-rolldown": "workspace:*",
    "@monochromatic-dev/config-typescript": "workspace:*",
    "@monochromatic-dev/async-time-core": "workspace:*",
    "@monochromatic-dev/caught-value-core": "workspace:*",
    "@monochromatic-dev/test-harness-core": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {},
  "version": "0.4.5",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aquaticats/Monochromatic.git",
    "directory": "package/logger/core"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/final/neutral/index.d.mts",
        "node": "./dist/final/node/index.mjs",
        "default": "./dist/final/neutral/index.mjs"
      },
      "./node": {
        "types": "./dist/final/node/node.d.mts",
        "default": "./dist/final/node/node.mjs"
      },
      "./browser": {
        "types": "./dist/final/neutral/browser.d.mts",
        "default": "./dist/final/neutral/browser.mjs"
      }
    }
  }
}
