[Unit]
Description=Claude session CPU cap reconciler and system degradation watcher
Documentation=file://%h/Monochromatic/package/claude-cpu-cap/daemon/README.md

[Service]
# The manager does not read the shell's PATH: `env` finds `node` on the user manager's own PATH, which
# ~/.config/environment.d/ can extend, so the unit follows whichever Node the machine installs.
ExecStart=/usr/bin/env node %h/Monochromatic/package/claude-cpu-cap/daemon/src/cpu-watch.ts
Restart=on-failure
RestartSec=30
MemoryMax=256M

[Install]
WantedBy=default.target
