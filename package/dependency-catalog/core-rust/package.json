  "name": "@monochromatic-dev/dependency-catalog-core-rust",
  "description": "Parsing and validation of rust-catalog.toml, the pnpm-style Rust dependency catalog.",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "module": "dist/final/node/index.mjs",
  "exports": {
