{
  "license": "LGPL-3.0-or-later",
  "name": "@monochromatic-dev/terminal-exec-cli",
  "description": "Cross-platform terminal emulator launcher. XDG + KDE kdeglobals on Linux, Windows Terminal / cmd on Windows.",
  "type": "module",
  "private": true,
  "main": "src/launch.ts",
  "module": "dist/final/node/launch.mjs",
  "bin": {
    "terminal-exec": "dist/final/node/index.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/final/node/launch.d.mts",
      "default": "./dist/final/node/launch.mjs"
    },
    "./ts": "./src/launch.ts",
    "./ts/*": "./src/*"
  },
  "files": [
    "dist/final",
    "LICENSES"
  ],
  "devDependencies": {
    "@monochromatic-dev/config-rolldown": "workspace:*",
    "@monochromatic-dev/config-typescript": "workspace:*",
    "@monochromatic-dev/test-harness-core": "workspace:*",
    "@types/node": "catalog:"
  },
  "dependencies": {
    "@monochromatic-dev/caught-value-core": "workspace:*",
    "@monochromatic-dev/logger-core": "workspace:*"
  },
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aquaticat/Monochromatic.git",
    "directory": "package/terminal-exec/cli"
  },
  "sideEffects": true
}
