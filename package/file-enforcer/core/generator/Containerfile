# Minimal repology-updater environment for package index generation.
# Fetches only the repos we care about, not the full production set.
#
# Build (with GitHub token for authenticated clones):
#   podman build --secret id=github_token,env=GITHUB_TOKEN \
#     -t repology-updater -f generator/Containerfile generator/
#
# Run (fetches repos, auto-inits on first run):
#   podman run --rm -v repology-state:/state -v repology-parsed:/parsed \
#     -v repology-pgdata:/var/lib/pgsql/data repology-updater \
#     --fetch --fetch --parse --database
#
# Extract data:
#   podman run --rm -v repology-state:/state -v repology-parsed:/parsed \
#     -v repology-pgdata:/var/lib/pgsql/data repology-updater --extract

# The base is CachyOS, unpinned (doc/decision/container-base-distro.md); CACHYOS_IMAGE lets the caller pick the x86-64-v3 or
# x86-64-v4 build of CachyOS that the host CPU supports.
ARG CACHYOS_IMAGE=docker.io/cachyos/cachyos:latest
FROM ${CACHYOS_IMAGE}

# PostgreSQL 18, Python 3.14, libversion build deps.
# Arch ships headers in the main packages, so there are no -devel names:
#   postgresql             the server and contrib modules (pg_trgm)
#   postgresql-libs        libpq, pg_config and the server headers the libversion extension builds against
#   python, python-pip     the interpreter and pip
#   gcc, make, cmake       C and C++ compilers (gcc covers g++), and the build tools for libversion
#   pkgconf                pkg-config
#   rpm-tools              rpm2cpio and the Python rpm bindings
#   yajl, libxml2, libxslt development libraries (headers included)
# --disable-sandbox: pacman's hook sandbox needs a network namespace a rootless podman build cannot create, and without it
# hooks such as the sysusers one that creates system users fail.
RUN pacman --disable-sandbox --sync --refresh --sysupgrade --noconfirm --needed \
    postgresql \
    postgresql-libs \
    python \
    python-pip \
    gcc \
    make \
    cmake \
    pkgconf \
    git \
    rsync \
    rpm-tools \
    cpio \
    yajl \
    libxml2 \
    libxslt \
    && rm --recursive --force /var/cache/pacman/pkg/*

# entrypoint.sh keeps the cluster in /var/lib/pgsql/data, the directory the repology-pgdata volume mounts over. Arch's
# package uses /var/lib/postgres instead, so the directory is created here, owned by the postgres user, and a named
# volume copies that ownership on first use.
RUN install --directory --owner=postgres --group=postgres /var/lib/pgsql/data

# Configure git to use GitHub token when available (via build secret).
# The credential helper writes the token into the extraheader so all
# github.com clones are authenticated, avoiding rate limits.
RUN --mount=type=secret,id=github_token \
    if [ -f /run/secrets/github_token ] && [ -s /run/secrets/github_token ]; then \
        TOKEN=$(cat /run/secrets/github_token) \
        && git config --global url."https://${TOKEN}@github.com/".insteadOf "https://github.com/" ; \
    fi

# Build and install libversion + pg extension. Arch's PostgreSQL is configured with LLVM JIT, so pgxs would compile
# LLVM bitcode with clang; the extension needs no JIT bitcode, so `with_llvm=no` skips that and the clang dependency.
RUN git clone --depth 1 https://github.com/repology/libversion.git /tmp/libversion \
    && cd /tmp/libversion \
    && cmake -DCMAKE_INSTALL_PREFIX=/usr . \
    && make -j"$(nproc)" \
    && make install \
    && ldconfig \
    && rm -rf /tmp/libversion

RUN git clone --depth 1 https://github.com/repology/postgresql-libversion.git /tmp/pg-libversion \
    && cd /tmp/pg-libversion \
    && make with_llvm=no -j"$(nproc)" \
    && make with_llvm=no install \
    && rm -rf /tmp/pg-libversion

# Clone repology-updater and rules
WORKDIR /repology
RUN git clone --depth 1 https://github.com/repology/repology-updater.git . \
    && git clone --depth 1 https://github.com/repology/repology-rules.git rules.d

# Remove the credential helper so the token is not baked into the image
RUN git config --global --unset-all url."https://github.com/".insteadOf 2>/dev/null || true

# Python dependencies
RUN pip install --no-cache-dir --break-system-packages -r requirements.txt

# Custom config scoped to our target repos
COPY repology.conf /repology/repology.conf

# Extraction SQL
COPY extract.sql /repology/extract.sql

# Entrypoint script
COPY entrypoint.sh /repology/entrypoint.sh
RUN chmod +x /repology/entrypoint.sh

# Persistent volumes for incremental updates
VOLUME ["/state", "/parsed"]

ENTRYPOINT ["/repology/entrypoint.sh"]
