{
  "license": "LGPL-3.0-or-later",
  "name": "@monochromatic-dev/issue-acceptance-cli",
  "description": "Check a GitHub issue's acceptance against a branch and settle it: close it with the evidence, or comment on it and leave it open.",
  "type": "module",
  "private": true,
  "main": "src/index.ts",
  "bin": {
    "issue-acceptance": "dist/final/node/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/final/node/index.d.mts",
      "default": "./dist/final/node/index.mjs"
    },
    "./ts": "./src/index.ts",
    "./ts/*": "./src/*"
  },
  "files": [
    "dist/final",
    "src",
    "LICENSES"
  ],
  "dependencies": {
    "nano-spawn": "catalog:",
    "string-dedent": "catalog:"
  },
  "devDependencies": {
    "@monochromatic-dev/config-rolldown": "workspace:*",
    "@monochromatic-dev/config-typescript": "workspace:*",
    "@monochromatic-dev/test-harness-core": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aquaticats/Monochromatic.git",
    "directory": "package/issue-acceptance/cli"
  },
  "sideEffects": true
}
