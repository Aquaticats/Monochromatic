{
  "license": "LGPL-3.0-or-later",
  "name": "@monochromatic-dev/git-executable-core",
  "description": "Resolve a native Git executable without re-entering the workspace Git policy wrapper.",
  "type": "module",
  "sideEffects": false,
  "private": true,
  "version": "0.0.1",
  "module": "dist/final/node/index.mjs",
  "types": "dist/final/node/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/final/node/index.d.mts",
      "default": "./dist/final/node/index.mjs"
    },
    "./ts": "./src/index.ts"
  },
  "files": [
    "dist/final",
    "src",
    "LICENSES",
    "README.md"
  ],
  "dependencies": {
    "@monochromatic-dev/logger-core": "workspace:*",
    "@monochromatic-dev/ownership-marker-foreign-borrowed": "workspace:*"
  },
  "devDependencies": {
    "@monochromatic-dev/config-rolldown": "workspace:*",
    "@monochromatic-dev/config-typescript": "workspace:*",
    "@monochromatic-dev/test-harness-core": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Aquaticat/Monochromatic.git",
    "directory": "package/git-executable/core"
  }
}
