// Folder with no audio, dark, on the inner panel with the folder name in the headline.
export component FolderNoAudioInnerDark inherits Window {
    width: 851px;
    height: 620px;
    background: Theme.canvas;
    init => { Theme.scheme-override = 2; }
    FirstRunPane {
        state: 2;
        folder-name: "Cult of Luna";
        title: "No audio found in Cult of Luna";
        body: "The chosen folder was checked completely and contains no supported audio files. Opening a different folder changes the music source.";
        primary-label: "Open a folder";
        secondary-labels: ["Settings"];
        explanation: "";
    }
}

