// Preview windows for the three first-run states, using the exact copy from core/FirstRunState.kt.
import { Theme } from "../theme.slint";
import { FirstRunPane } from "../first_run.slint";

// Declined state on the 443 wide cover, dark.
export component DeclinedCoverDark inherits Window {
    width: 443px;
    height: 620px;
    background: Theme.canvas;
    init => { Theme.scheme-override = 2; }
    FirstRunPane {
        state: 0;
        title: "The device music library can't be read";
        body: "It is open as your library, but access to music on this device was not granted. Allow access, or open a folder instead.";
        primary-label: "Allow access";
        secondary-labels: ["Open a folder", "Settings"];
        explanation: "True peak is measured automatically for every audio file. Analysis uses CPU and battery; playback remains available while it runs.";
    }
}

// Declined state on the 443 wide cover, light.
export component DeclinedCoverLight inherits Window {
    width: 443px;
    height: 620px;
    background: Theme.canvas;
    init => { Theme.scheme-override = 1; }
    FirstRunPane {
        state: 0;
        title: "The device music library can't be read";
        body: "It is open as your library, but access to music on this device was not granted. Allow access, or open a folder instead.";
        primary-label: "Allow access";
        secondary-labels: ["Open a folder", "Settings"];
        explanation: "True peak is measured automatically for every audio file. Analysis uses CPU and battery; playback remains available while it runs.";
    }
}

