// System library with no audio, dark, on the cover.
export component SystemNoAudioCoverDark inherits Window {
    width: 443px;
    height: 620px;
    background: Theme.canvas;
    init => { Theme.scheme-override = 2; }
    FirstRunPane {
        state: 1;
        title: "No audio found in the device music library";
        body: "The device music library was checked completely. You can open a folder that is not listed there.";
        primary-label: "Open a folder";
        secondary-labels: ["Settings"];
        explanation: "";
    }
}

