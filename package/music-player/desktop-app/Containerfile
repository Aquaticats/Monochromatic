# Build + run environment for the `music-player` app.
# The host is an immutable-style Fedora without dev headers, so all cargo
# work happens inside this container (see mise.toml tasks). The image also
# carries the GUI/audio runtime libraries so the `run` task can drive the
# Slint UI against the host's Wayland + PipeWire sockets (passed through).
# Pinned by digest (the multi-arch index of fedora:41, resolved 2026-10-18) so a moving tag cannot change the build
# input. Refresh on purpose: skopeo inspect --raw docker://registry.fedoraproject.org/fedora:41 | sha256sum
FROM registry.fedoraproject.org/fedora@sha256:893f7eeffce8e3e2bb2bc62786ba5603fb1e0bd6ba07091acb892266b95bafdf

# Build toolchain:
#   rustup-installed nightly Rust compiler + cargo + clippy. NOT Fedora's `rust`
#                          package: Slint 1.17.0 declares rust-version 1.92,
#                          while Fedora 41 ships 1.91.1. rustup installs the
#                          nightly toolchain.lock.json pins (see the rustup RUN below).
#   gcc                    cc for building C dependencies (libopus is compiled
#                          from source by opusic-sys, the opus crate's -sys
#                          backend; see the opus pin in Cargo.toml)
#   cmake, ninja-build     opusic-sys builds vendored libopus 1.6.1 via CMake
#                          (Ninja generator); the host gets cmake from mise, but
#                          the container does not see host mise tools, so install
#                          it here. See
#                          doc/troubleshooting/audiopus-cmake4-libopus-min-version.md
#   clang, clang-devel     libclang for bindgen used by pipewire's libspa-sys
#   pkgconf-pkg-config     pkg-config used to locate libpipewire (no longer opus:
#                          opusic-sys vendors and statically links libopus)
#   *-devel                headers for the native audio dependencies
# Runtime (for `run`):
#   mesa-*                 OpenGL/EGL for the femtovg renderer + DRI drivers
#   libxkbcommon, wayland  winit Wayland backend
#   fontconfig, freetype   Slint font loading
#   google-noto-sans-cjk-fonts  CJK glyph coverage. Slint 1.16's femtovg
#                          renderer lays text out with parley + fontique
#                          (system_fonts enabled), which falls back per script
#                          to a system font. Without a CJK font installed,
#                          Japanese/Chinese/Korean filenames render as blanks.
#   xdg-desktop-portal     rfd file picker over the portal (when D-Bus passed)
#   dbus-daemon            the notification tests (D122, D107) start a private
#                          session bus of their own; they never use a host bus
RUN dnf install -y \
      gcc \
      cmake ninja-build \
      clang clang-devel \
      pkgconf-pkg-config \
      pipewire-devel \
      mesa-dri-drivers mesa-libgbm libglvnd-glx libglvnd-egl \
      libwayland-client libwayland-cursor libwayland-egl libxkbcommon \
      fontconfig fontconfig-devel freetype freetype-devel \
      google-noto-sans-cjk-fonts \
      dbus-daemon \
    && dnf clean all

# Rust toolchain via rustup, not Fedora's `rust` package (1.91.1), because
# Slint 1.17.0 declares rust-version 1.92. RUSTUP_HOME holds the toolchain and
# persists in the image. The install uses a throwaway
# CARGO_HOME=/usr/local so the cargo/rustc/clippy proxy shims land in
# /usr/local/bin (already on PATH, persistent in the image); the real CARGO_HOME
# is set to /cargo below, a named volume that holds only the registry/git cache
# at run time. If CARGO_HOME were /cargo here, the run-time volume mount would
# shadow the proxies. `--profile minimal` plus the clippy component keeps the
# layer small while still providing `cargo clippy`.
# The toolchain is the nightly toolchain.lock.json pins (`.tools.rust.version`), as in Containerfile.windows-gnu;
# the build context is this package directory, so this default is kept in sync with that key, and
# `--build-arg RUST_TOOLCHAIN=` overrides it.
ARG RUST_TOOLCHAIN=nightly-2026-10-29
ENV RUSTUP_HOME=/rustup
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
      | env CARGO_HOME=/usr/local sh -s -- -y --no-modify-path --profile minimal \
          --default-toolchain "${RUST_TOOLCHAIN}" --component clippy

# cargo-nextest is the test runner the `test` mise task invokes
# (`cargo nextest run`). Install the prebuilt binary from get.nexte.st into
# /usr/local/bin (already on PATH, persistent in the image) rather than
# `cargo install cargo-nextest`, which would add a multi-minute source compile
# to every image rebuild. Arch-aware: get.nexte.st serves separate x86_64 and
# aarch64 builds. The standard Fedora image already ships `tar`/`gzip` for the
# `tar zxf` extraction.
RUN arch="$(uname -m)" \
    && case "$arch" in \
      x86_64) nextest_url="https://get.nexte.st/latest/linux" ;; \
      aarch64) nextest_url="https://get.nexte.st/latest/linux-arm" ;; \
      *) echo "unsupported architecture: $arch" >&2; exit 1 ;; \
    esac \
    && curl --proto '=https' --tlsv1.2 --location --silent --show-error --fail "$nextest_url" \
      | tar zxf - -C /usr/local/bin

ENV CARGO_HOME=/cargo
# Enable Slint's experimental builtins so `FlexboxLayout` (used for the wrapping,
# variable-width page-tab bar) is recognised. slint-build reads this env var at
# compile time (build.rs); without it the Slint compiler rejects `FlexboxLayout`
# with "Unknown element". It is baked here so every cargo task (build, check,
# clippy, test, run) compiles the UI consistently. The feature is experimental
# upstream and its API may change across Slint versions.
ENV SLINT_ENABLE_EXPERIMENTAL_FEATURES=1
WORKDIR /work
