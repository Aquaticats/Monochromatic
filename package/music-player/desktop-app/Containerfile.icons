# Icon-rendering toolchain for the `gen:icons` mise task. The host is an
# immutable-style Fedora without these tools, so icon generation runs in this
# throwaway image (same podman pattern as the build Containerfile). gen:icons is
# rare (regenerate only when asset/icon.svg changes), and its outputs
# (asset/music-player.icns, asset/music-player.ico) are committed, so neither
# the build nor the sign tasks need this image.
#   librsvg      rsvg-convert: render asset/icon.svg to PNG at each size
#   libicns      png2icns: pack the PNGs into a macOS .icns
#   icoutils     icotool: pack the PNGs into a Windows .ico
#   imagemagick  fallback rasteriser / format glue if needed
# The base is CachyOS, unpinned (doc/decision/container-base-distro.md): an upstream update that breaks this build is
# a bug to fix at once, never a reason to pin. CACHYOS_IMAGE lets the caller choose the CPU-level variant of the image.
ARG CACHYOS_IMAGE=docker.io/cachyos/cachyos:latest
FROM ${CACHYOS_IMAGE}
# --disable-sandbox: pacman's hook sandbox needs a network namespace that a rootless podman build cannot create, and without it
# hooks (fontconfig cache, sysusers, ldconfig) fail silently (doc/troubleshooting/pacman-hook-sandbox-rootless-podman-build.md).
RUN pacman --disable-sandbox --sync --refresh --sysupgrade --noconfirm --needed \
      librsvg \
      libicns \
      icoutils \
      imagemagick \
    && rm --recursive --force /var/cache/pacman/pkg/*
WORKDIR /work
