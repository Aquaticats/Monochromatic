<?xml version='1.0' encoding='utf-8'?>
<manifest xmlns:android='http://schemas.android.com/apk/res/android'>
  <!-- Read the shared audio library: the granular media permission on API 33+, the broad storage
         permission (capped so it is not requested on API 33+) on API 26-32. -->
  <uses-permission android:name='android.permission.READ_MEDIA_AUDIO' />
  <uses-permission
    android:name='android.permission.READ_EXTERNAL_STORAGE'
    android:maxSdkVersion='32'
  />

  <!-- Background playback runs in a mediaPlayback foreground service. At targetSdk 36 (>= 34) both
         the base permission and the typed FOREGROUND_SERVICE_MEDIA_PLAYBACK are mandatory or
         startForeground throws. POST_NOTIFICATIONS is asked for once, when the first true-peak analysis starts
         (decision D107), because the analysis progress notification needs it on Android 13 and later; the
         media-session notification itself is exempt from that gate and shows without it. -->
  <uses-permission android:name='android.permission.FOREGROUND_SERVICE' />
  <uses-permission android:name='android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK' />
  <!-- The initial parallel peak index runs as a dataSync foreground service (PeakSweepService). -->
  <uses-permission android:name='android.permission.FOREGROUND_SERVICE_DATA_SYNC' />
  <uses-permission android:name='android.permission.POST_NOTIFICATIONS' />

  <application
    android:name='.MusicPlayerApplication'
    android:allowBackup='true'
    android:icon='@mipmap/ic_launcher'
    android:roundIcon='@mipmap/ic_launcher'
    android:label='Music Player'
    android:supportsRtl='true'
    android:theme='@android:style/Theme.Material.NoActionBar'>
    <activity
      android:name='.MainActivity'
      android:exported='true'>
      <intent-filter>
        <action android:name='android.intent.action.MAIN' />
        <category android:name='android.intent.category.LAUNCHER' />
      </intent-filter>
    </activity>

    <!-- Hosts the player so audio survives the activity being backgrounded or destroyed. The
             intent-filter action lets external controllers (system media controls, Android Auto,
             Wear) discover the session; the in-app UI binds with a private action for a direct
             handle to the same service-owned controller. -->
    <service
      android:name='.PlaybackService'
      android:exported='true'
      android:foregroundServiceType='mediaPlayback'>
      <intent-filter>
        <action android:name='androidx.media3.session.MediaSessionService' />
      </intent-filter>
    </service>

    <!-- The auto-started initial true-peak index: a dataSync foreground service that runs the
             bulk parallel sweep once and self-stops. Not exported; started only in-process. -->
    <service
      android:name='.PeakSweepService'
      android:exported='false'
      android:foregroundServiceType='dataSync'
    />

    <!-- Receives the Pause and Resume buttons of the analysis notification (decision D107). Not exported:
             only this app's own explicit, immutable pending intents reach it. -->
    <receiver
      android:name='.AnalysisActionReceiver'
      android:exported='false'
    />
  </application>
</manifest>
