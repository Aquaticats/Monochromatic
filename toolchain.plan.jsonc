// toolchain.plan.jsonc: the toolchain plan. People edit this file; mpm-shadow writes toolchain.lock.json from it.
// Converted from the retired TypeScript plan (package/file-enforcer/core/src/toolchain/plan.tools.data.ts) by the cutover converter in doc/planning/file-enforcer-rust-cutover.md.
{
  "schemaVersion": 1,
  "tools": {
    "bin": {
      "request": "github:marcosnils/bin@latest",
      "route": "archive",
      "bins": [
        "bin"
      ],
      "options": {
        "bootstrap": {
          "distribution": "standalone-binary"
        }
      }
    },
    "mpm": {
      "request": "pipx:meta-package-manager@latest",
      "route": "mpm-uvx",
      "bins": [
        "mpm",
        "meta-package-manager"
      ],
      "options": {
        "bootstrap": {
          "requiresTool": "uv",
          "distribution": "wheel"
        }
      }
    },
    "bun": {
      "request": "github:oven-sh/bun@latest",
      "route": "bin-sourced",
      "bins": [
        "bun",
        "bunx"
      ],
      "options": {
        "binAliases": {
          "bunx": "bun"
        }
      }
    },
    "pnpm": {
      "request": "github:pnpm/pnpm@latest",
      "route": "bin-sourced",
      "bins": [
        "pn",
        "pnpm",
        "pnpx",
        "pnx"
      ],
      "options": {
        "binAliases": {
          "pn": "pnpm",
          "pnpx": "pnpm",
          "pnx": "pnpm"
        }
      }
    },
    // aqua:sharkdp/fd broke in 2026-03-07; cargo-binstall is the fallback route.
    "cargo:fd-find": {
      "request": "cargo:fd-find@latest",
      "route": "cargo-binstall",
      "bins": [
        "fd"
      ]
    },
    "ripgrep": {
      "request": "github:BurntSushi/ripgrep@latest",
      "route": "bin-sourced",
      "bins": [
        "rg"
      ]
    },
    "cargo:fastmod": {
      "request": "cargo:fastmod@latest",
      "route": "cargo-binstall",
      "bins": [
        "fastmod"
      ]
    },
    "cargo:cargo-fuzz": {
      "request": "cargo:cargo-fuzz@latest",
      "route": "cargo-binstall",
      "bins": [
        "cargo-fuzz"
      ]
    },
    // `bin/ocr` in the Mise tree is a stray link into a global npm package,
    // not a Node binary; the exposure links only Node's own binaries.
    "node": {
      "request": "node@latest",
      "route": "archive",
      "bins": [
        "node",
        "npm",
        "npx"
      ]
    },
    "harper-cli": {
      "request": "github:Automattic/harper@latest",
      "route": "bin-sourced",
      "bins": [
        "harper-cli"
      ],
      "options": {
        "asset": "harper-cli-*"
      }
    },
    "dprint": {
      "request": "github:dprint/dprint@latest",
      "route": "bin-sourced",
      "bins": [
        "dprint"
      ]
    },
    "uv": {
      "request": "github:astral-sh/uv@latest",
      "route": "archive",
      "bins": [
        "uv",
        "uvx"
      ]
    },
    "hyperfine": {
      "request": "github:sharkdp/hyperfine@latest",
      "route": "bin-sourced",
      "bins": [
        "hyperfine"
      ]
    },
    "caddy": {
      "request": "github:caddyserver/caddy@latest",
      "route": "bin-sourced",
      "bins": [
        "caddy"
      ]
    },
    "watchexec": {
      "request": "github:watchexec/watchexec@latest",
      "route": "bin-sourced",
      "bins": [
        "watchexec"
      ]
    },
    "sops": {
      "request": "github:getsops/sops@latest",
      "route": "bin-sourced",
      "bins": [
        "sops"
      ]
    },
    "age": {
      "request": "github:FiloSottile/age@latest",
      "route": "archive",
      "bins": [
        "age",
        "age-inspect",
        "age-keygen",
        "age-plugin-batchpass",
        "age-plugin-pq",
        "age-plugin-tag",
        "age-plugin-tagpq"
      ]
    },
    // Floating nightly channel, resolved to the dated toolchain string; the pin
    // rides in the MPM rustup package id because that adapter keeps only the id.
    "rust": {
      "request": "rust@nightly",
      "route": "rustup-toolchain",
      "manager": "rustup",
      "packageId": "{version}",
      "bins": [
        "cargo",
        "cargo-clippy",
        "cargo-fmt",
        "clippy-driver",
        "rust-gdb",
        "rust-gdbgui",
        "rust-lldb",
        "rustc",
        "rustdoc",
        "rustfmt",
        "rustup"
      ],
      "options": {
        "rustComponents": [
          "clippy",
          "rust-src",
          "llvm-tools",
          "rustc-dev"
        ],
        "rustTargets": [
          "aarch64-linux-android",
          "x86_64-linux-android"
        ]
      },
      "env": {
        "RUSTUP_TOOLCHAIN": "{version}"
      }
    },
    "cargo-binstall": {
      "request": "github:cargo-bins/cargo-binstall@latest",
      "route": "bin-sourced",
      "bins": [
        "cargo-binstall"
      ]
    },
    // uutils' timeout replaced timeout-cli (owner 2026-11-01: "uutils timeout"): timeout-cli parsed its own
    // flags when they came right after the wrapped command (`timeout 5 grep -v x` ran grep without -v);
    // doc/troubleshooting/timeout-cli-consumes-flags-right-after-command.md.
    "cargo:uu_timeout": {
      "request": "cargo:uu_timeout@latest",
      "route": "cargo-binstall",
      "bins": [
        "timeout"
      ]
    },
    "cargo:cargo-dylint": {
      "request": "cargo:cargo-dylint@latest",
      "route": "cargo-binstall",
      "bins": [
        "cargo-dylint"
      ]
    },
    "cargo:dylint-link": {
      "request": "cargo:dylint-link@latest",
      "route": "cargo-binstall",
      "bins": [
        "dylint-link"
      ]
    },
    "cargo:cargo-nextest": {
      "request": "cargo:cargo-nextest@latest",
      "route": "cargo-binstall",
      "bins": [
        "cargo-nextest"
      ]
    },
    "cargo:cargo-about": {
      "request": "cargo:cargo-about@latest",
      "route": "cargo-binstall",
      "bins": [
        "cargo-about"
      ]
    },
    // The seven repository-published tools install from the GitHub release archive of this repository, the way
    // `mpm-shadow` does, since 2026-11-07 (owner: "Right after the release"; doc/planning/crates-io-footprint.md): later
    // releases carry `-alpha.N` and skip crates.io, so a `cargo:` request could not see them. `tagPrefix` picks one
    // program's releases out of the repository's many tags; the lock records the SHA-256 of each Linux archive. The ids
    // keep their `cargo:` spelling because `.github/workflows/catalog-specifiers.yml` and
    // `.github/actions/repo-tools-setup/action.yml` read the lock by them.
    "cargo:monochromatic-lint": {
      "request": "github:Aquaticats/Monochromatic@latest",
      "route": "archive",
      "bins": [
        "monochromatic-lint"
      ],
      "options": {
        "tagPrefix": "monochromatic-lint-v"
      }
    },
    // The postinstall links `monochromatic-git-policy-cli` (named `cli-git-native` before 0.6.0) as `git` under
    // `.cache/monochromatic-git-policy-cli-bin` with a temporary name plus rename (doc/planning/cli-git-native-cutover.md,
    // doc/planning/git-policy-cli-program-rename.md). The link folder was named `.cache/cli-git-bin` before step 3 of the rename.
    "cargo:monochromatic-git-policy-cli": {
      "request": "github:Aquaticats/Monochromatic@latest",
      "route": "archive",
      "bins": [
        "monochromatic-git-policy-cli"
      ],
      "os": [
        "linux"
      ],
      "options": {
        "tagPrefix": "monochromatic-git-policy-cli-v",
        "postinstall": {
          "when": "always",
          "link": {
            "sourceBin": "monochromatic-git-policy-cli",
            "linkName": "git",
            "linkDir": ".cache/monochromatic-git-policy-cli-bin"
          }
        }
      }
    },
    // The postinstall links `cargo-shadow` as `cargo` under `.cache/cargo-shadow-bin`, which precedes
    // `.cache/toolchain-bin` (the real cargo) on PATH (.config/mise/conf.d/20-env.toml). Started as `cargo`, the shadow
    // answers `cargo update` as `pnpm update` and runs an install step before every cargo command that resolves
    // dependencies (doc/decision/rust-dependency-catalog.md, "Update and tightening"). 0.1.0 was locked and reverted
    // the same minute (2026-11-04): reached through the toolchain launcher `.cache/toolchain-launchers/cargo-shadow`,
    // it took the launcher for the real cargo and ran itself once ("We should never invoke ourselves recursively.").
    // 0.1.1 skips a PATH candidate whose `.launch` record leads back to the shadow; before this row was added again,
    // 0.1.1 behind a copy of the real launcher was traced with `strace --follow-forks --trace=execve` in a throwaway
    // worktree: `cargo --version` and `cargo metadata` exited 0, the link and the shadow each ran once per command, and
    // the real cargo ran through `.cache/toolchain-bin/cargo` (the rustup proxy); the worktree stayed clean. Linux only:
    // the release publishes x86_64 and aarch64 Linux archives.
    // The `cargo` link is off again since 2026-11-04T16:10-05:00: with 0.1.1 as `cargo`, the wrapper gate's
    // `cargo vendor --manifest-path <staged copy outside the work tree>` (package/git-policy/cli/bin/native-scanner-snapshot.ts)
    // counted all 281 locked versions of an unchanged lockfile as new and refused 4 on trust level, so no wrapper gate
    // could run. 0.1.2 passes a crate in a git-ignored directory to cargo untouched; the link came back on
    // 2026-11-04 after the launcher trace (`~/temp/agent/cgs-installed-launcher-trace.ts`, the repository's own
    // launcher as `cargo` in a throwaway worktree) passed again: `cargo --version` and `cargo metadata` exited 0, the
    // link and the shadow each ran once per command, and the real cargo ran only through `.cache/toolchain-bin/cargo`.
    "cargo:monochromatic-cargo-shadow": {
      "request": "github:Aquaticats/Monochromatic@latest",
      "route": "archive",
      "bins": [
        "cargo-shadow"
      ],
      "os": [
        "linux"
      ],
      "options": {
        "tagPrefix": "monochromatic-cargo-shadow-v",
        "postinstall": {
          "when": "always",
          "link": {
            "sourceBin": "cargo-shadow",
            "linkName": "cargo",
            "linkDir": ".cache/cargo-shadow-bin"
          }
        }
      }
    },
    // The postinstall links `pnpm-shadow` as `pnpm` under `.cache/pnpm-shadow-bin`, which precedes
    // `.cache/toolchain-bin` (the real pnpm) on PATH (.config/mise/conf.d/20-env.toml). Owner 2026-11-01, relayed by
    // the catalog-specifier session: "Yes, ask the toolchain session to link it". 0.1.0 took its own
    // launcher-backed link (`.cache/toolchain-launchers/pnpm-shadow`) for the real pnpm and re-ran itself
    // (`pnpm --version` exit 126, `pnpm root` hung), so it was kept off PATH; 0.1.1 fixes that, checked behind the
    // real launcher in a throwaway PATH first. Linux only: the release publishes x86_64 and aarch64 Linux archives.
    "cargo:monochromatic-pnpm-shadow": {
      "request": "github:Aquaticats/Monochromatic@latest",
      "route": "archive",
      "bins": [
        "pnpm-shadow"
      ],
      "os": [
        "linux"
      ],
      "options": {
        "tagPrefix": "monochromatic-pnpm-shadow-v",
        "postinstall": {
          "when": "always",
          "link": {
            "sourceBin": "pnpm-shadow",
            "linkName": "pnpm",
            "linkDir": ".cache/pnpm-shadow-bin"
          }
        }
      }
    },
    // The postinstall runs `search-shadow link .cache/search-shadow-bin` after the exposure directory
    // is rebuilt: the crate links itself under the name of every search, find and count tool whose real
    // binary it finds on PATH (rg, grep, find, fd, du and others; the crate owns the list). That directory
    // precedes `.cache/toolchain-bin` on PATH, so those tools in the mise environment run behind the
    // shadow (doc/planning/agent-search-io-throttle.md). Linux only: the crate uses `ioprio_set` and `/proc`.
    "cargo:monochromatic-search-shadow": {
      "request": "github:Aquaticats/Monochromatic@latest",
      "route": "archive",
      "bins": [
        "search-shadow"
      ],
      "os": [
        "linux"
      ],
      "options": {
        "tagPrefix": "monochromatic-search-shadow-v",
        "postinstall": {
          "when": "always",
          "run": {
            "sourceBin": "search-shadow",
            "args": [
              "link",
              ".cache/search-shadow-bin"
            ]
          }
        }
      }
    },
    // The postinstall links `mpm-shadow` as `mpm` under `.cache/mpm-shadow-bin`, the way `cli-git-native` is linked as
    // `git`. That directory precedes `.cache/toolchain-bin` on PATH, so `mpm` in the mise environment runs the real mpm
    // as a child and then deletes the superseded cached copies of the repository's own crates from cargo's registry
    // (doc/decision/mpm-toolchain-adoption.md, section on pruning the repository's own crates). Linux only: the release
    // archives are Linux builds.
    // The bootstrap entry: a fresh clone, a container or a CI runner has no mpm-shadow, so the lock must record the
    // SHA-256 of one prebuilt archive that `sha256sum --check` can check before it runs
    // (doc/decision/file-enforcer-rust-rewrite.md, "Bootstrap"); a cargo-binstall row records no artifact. It floats
    // like every repository-published tool: `@latest` with `tagPrefix` takes the newest non-prerelease release of this
    // crate out of the repository's many tags, and `mise run toolchain:update` moves the lock.
    "mpm-shadow": {
      "request": "github:Aquaticats/Monochromatic@latest",
      "route": "archive",
      "bins": [
        "mpm-shadow"
      ],
      "os": [
        "linux"
      ],
      "options": {
        "tagPrefix": "monochromatic-mpm-shadow-v",
        "postinstall": {
          "when": "always",
          "link": {
            "sourceBin": "mpm-shadow",
            "linkName": "mpm",
            "linkDir": ".cache/mpm-shadow-bin"
          }
        }
      }
    },
    // The repository's file generator and checker (package/file-enforcer/cli). `mise run sync:files`, the
    // `prepare:pnpm` task and the CI drift gates run this binary; Linux only, like the release archives.
    "cargo:monochromatic-file-enforcer-cli": {
      "request": "github:Aquaticats/Monochromatic@latest",
      "route": "archive",
      "bins": [
        "file-enforcer"
      ],
      "os": [
        "linux"
      ],
      "options": {
        "tagPrefix": "monochromatic-file-enforcer-cli-v"
      }
    },
    "cargo:monochromatic-nested-wayland-session": {
      "request": "github:Aquaticats/Monochromatic@latest",
      "route": "archive",
      "bins": [
        "monochromatic-nested-wayland-session"
      ],
      "options": {
        "tagPrefix": "monochromatic-nested-wayland-session-v"
      }
    },
    "cmake": {
      "request": "github:Kitware/CMake@latest",
      "route": "archive",
      "bins": [
        "ccmake",
        "cmake",
        "cmake-gui",
        "cpack",
        "ctest"
      ]
    },
    "cargo:apple-codesign": {
      "request": "cargo:apple-codesign@latest",
      "route": "cargo-binstall",
      "bins": [
        "rcodesign"
      ]
    },
    "zig": {
      "request": "zig@latest",
      "route": "archive",
      "bins": [
        "zig"
      ]
    },
    "cargo:slint-lsp": {
      "request": "cargo:slint-lsp@latest",
      "route": "cargo-binstall",
      "bins": [
        "slint-lsp"
      ]
    },
    "cargo:slint-viewer": {
      "request": "cargo:slint-viewer@latest",
      "route": "cargo-binstall",
      "bins": [
        "slint-viewer"
      ]
    },
    // conda-forge artifact fetched directly: no MPM conda restore here, because
    // the per-tool OS filter is unexpressible and conda itself is not provisioned.
    "conda:bubblewrap": {
      "request": "conda:bubblewrap@latest",
      "route": "archive",
      "bins": [
        "bwrap"
      ],
      "os": [
        "linux"
      ]
    },
    "taplo": {
      "request": "github:tamasfe/taplo@latest",
      "route": "archive",
      "bins": [
        "taplo",
        "taplo-linux-x86_64"
      ],
      "options": {
        "binAliases": {
          "taplo-linux-x86_64": "taplo"
        }
      }
    },
    "tombi": {
      "request": "github:tombi-toml/tombi@latest",
      "route": "bin-sourced",
      "bins": [
        "tombi"
      ],
      "options": {
        "asset": "tombi-cli-*"
      }
    },
    "marksman": {
      "request": "github:artempyanykh/marksman@latest",
      "route": "bin-sourced",
      "bins": [
        "marksman"
      ]
    },
    "rumdl": {
      "request": "github:rvben/rumdl@latest",
      "route": "bin-sourced",
      "bins": [
        "rumdl"
      ]
    },
    "github:Feel-ix-343/markdown-oxide": {
      "request": "github:Feel-ix-343/markdown-oxide@latest",
      "route": "bin-sourced",
      "bins": [
        "markdown-oxide"
      ]
    },
    "zizmor": {
      "request": "github:zizmorcore/zizmor@latest",
      "route": "bin-sourced",
      "bins": [
        "zizmor"
      ]
    },
    "npm:yaml-language-server": {
      "request": "npm:yaml-language-server@latest",
      "route": "mpm-pnpm",
      "bins": [
        "yaml-language-server"
      ]
    },
    "npm:@actions/languageserver": {
      "request": "npm:@actions/languageserver@latest",
      "route": "mpm-pnpm",
      "bins": [
        "actions-languageserver"
      ]
    },
    "npm:@ansible/ansible-language-server": {
      "request": "npm:@ansible/ansible-language-server@latest",
      "route": "mpm-pnpm",
      "bins": [
        "ansible-language-server"
      ]
    },
    "npm:vscode-langservers-extracted": {
      "request": "npm:vscode-langservers-extracted@latest",
      "route": "mpm-pnpm",
      "bins": [
        "vscode-css-language-server",
        "vscode-eslint-language-server",
        "vscode-html-language-server",
        "vscode-json-language-server",
        "vscode-markdown-language-server"
      ]
    },
    "superhtml": {
      "request": "github:kristoff-it/superhtml@latest",
      "route": "bin-sourced",
      "bins": [
        "superhtml"
      ]
    },
    "npm:bash-language-server": {
      "request": "npm:bash-language-server@latest",
      "route": "mpm-pnpm",
      "bins": [
        "bash-language-server"
      ]
    },
    "npm:dockerfile-language-server-nodejs": {
      "request": "npm:dockerfile-language-server-nodejs@latest",
      "route": "mpm-pnpm",
      "bins": [
        "docker-langserver"
      ]
    },
    "npm:@microsoft/compose-language-service": {
      "request": "npm:@microsoft/compose-language-service@latest",
      "route": "mpm-pnpm",
      "bins": [
        "docker-compose-langserver"
      ]
    },
    "github:docker/docker-language-server": {
      "request": "github:docker/docker-language-server@latest",
      "route": "bin-sourced",
      "bins": [
        "docker-language-server"
      ]
    },
    // Pinned to b9829: no latest form works. GitHub marks every b-numbered release a prerelease, which the
    // `github:` resolver skips, so `@latest` resolves the unrelated v0.9.0 release, which has no Linux asset and
    // fails the whole `update` (probed 2026-11-07). Move the pin by hand until the resolver can take prereleases.
    "llama.cpp": {
      "request": "github:ggml-org/llama.cpp@b9829",
      "route": "archive",
      "bins": [
        "ggml-rpc-server",
        "llama",
        "llama-batched-bench",
        "llama-bench",
        "llama-cli",
        "llama-completion",
        "llama-debug-template-parser",
        "llama-fit-params",
        "llama-gemma3-cli",
        "llama-gguf-split",
        "llama-imatrix",
        "llama-llava-cli",
        "llama-minicpmv-cli",
        "llama-mtmd-cli",
        "llama-mtmd-debug",
        "llama-perplexity",
        "llama-quantize",
        "llama-qwen2vl-cli",
        "llama-results",
        "llama-server",
        "llama-template-analysis",
        "llama-tokenize",
        "llama-tts"
      ]
    },
    "opentofu": {
      "request": "github:opentofu/opentofu@latest",
      "route": "bin-sourced",
      "bins": [
        "tofu"
      ]
    },
    "hcloud": {
      "request": "github:hetznercloud/cli@latest",
      "route": "bin-sourced",
      "bins": [
        "hcloud"
      ]
    },
    "npm:typescript-language-server": {
      "request": "npm:typescript-language-server@latest",
      "route": "mpm-pnpm",
      "bins": [
        "typescript-language-server"
      ]
    },
    "cargo:coreutils": {
      "request": "cargo:coreutils@latest",
      "route": "cargo-binstall",
      "bins": [
        "coreutils"
      ],
      "options": {
        "cargoFeatures": [
          "unix"
        ]
      }
    },
    "npm:socket": {
      "request": "npm:socket@latest",
      "route": "mpm-pnpm",
      "bins": [
        "socket",
        "socket-npm",
        "socket-npx",
        "socket-pnpm",
        "socket-yarn"
      ]
    },
    "npm:wrangler": {
      "request": "npm:wrangler@latest",
      "route": "mpm-pnpm",
      "bins": [
        "cf-wrangler",
        "wrangler",
        "wrangler2"
      ]
    },
    "npm:pagefind": {
      "request": "npm:pagefind@latest",
      "route": "mpm-pnpm",
      "bins": [
        "pagefind"
      ]
    },
    "betterleaks": {
      "request": "github:betterleaks/betterleaks@latest",
      "route": "bin-sourced",
      "bins": [
        "betterleaks"
      ]
    },
    // Temurin 21: AGP 9 / Gradle 9 need a JDK in the 17 to 21 range. The newest release of this major line is
    // the latest form the resolver supports (`java:temurin@latest` is refused); a newer major waits for AGP.
    "java": {
      "request": "java:temurin@21",
      "route": "archive",
      "bins": [
        "jar",
        "jarsigner",
        "java",
        "javac",
        "javadoc",
        "javap",
        "jcmd",
        "jconsole",
        "jdb",
        "jdeprscan",
        "jdeps",
        "jfr",
        "jhsdb",
        "jimage",
        "jinfo",
        "jlink",
        "jmap",
        "jmod",
        "jpackage",
        "jps",
        "jrunscript",
        "jshell",
        "jstack",
        "jstat",
        "jstatd",
        "jwebserver",
        "keytool",
        "rmiregistry",
        "serialver"
      ],
      "env": {
        "JAVA_HOME": "java/{version}"
      }
    },
    // cmdline-tools from the locked archive; the SDK components below are the
    // values `prepare:android` installed (compileSdk 37, NDK 29).
    "android-sdk": {
      "request": "android-sdk@latest",
      "route": "android-sdk",
      "bins": [
        "android",
        "apkanalyzer",
        "avdmanager",
        "d8",
        "lint",
        "profgen",
        "r8",
        "resourceshrinker",
        "retrace",
        "screenshot2",
        "adb",
        "etc1tool",
        "fastboot",
        "hprof-conv",
        "make_f2fs",
        "make_f2fs_casefold",
        "mke2fs"
      ],
      "options": {
        "androidPackages": [
          "platforms/android-37.0",
          "build-tools/37.0.0",
          "ndk/29.0.13846066",
          "platform-tools"
        ]
      },
      "env": {
        "ANDROID_HOME": "android-sdk/{version}",
        "ANDROID_SDK_ROOT": "android-sdk/{version}"
      }
    },
    "cargo:cargo-ndk": {
      "request": "cargo:cargo-ndk@latest",
      "route": "cargo-binstall",
      "bins": [
        "cargo-ndk",
        "cargo-ndk-env",
        "cargo-ndk-runner",
        "cargo-ndk-test"
      ]
    },
    // Installed through `uv tool install slopo==<locked>`: the uvx adapter (and
    // this provider) honor `==` pins, unlike the pipx adapter.
    "pipx:slopo": {
      "request": "pipx:slopo@latest",
      "route": "mpm-uvx",
      "bins": [
        "slopo"
      ]
    }
  }
}
